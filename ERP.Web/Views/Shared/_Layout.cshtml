@using System.Globalization
@using Microsoft.Extensions.Localization
@inject ERP.Application.Interfaces.ICurrentUserContext CurrentUserContext
@inject ERP.Infrastructure.Data.ErpDbContext DbContext
@inject IStringLocalizer<ERP.Web.Resources.SharedResource> Localizer

@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var currentCulture = CultureInfo.CurrentUICulture.Name;

    List<ERP.Domain.Entities.Company> allowedCompanies = new List<ERP.Domain.Entities.Company>();
    List<ERP.Domain.Entities.Branch> allowedBranches = new List<ERP.Domain.Entities.Branch>();
    List<ERP.Domain.Entities.FiscalYear> activeFiscalYears = new List<ERP.Domain.Entities.FiscalYear>();
    if (CurrentUserContext.IsAuthenticated)
    {
        activeFiscalYears = DbContext.FiscalYears.Where(f => f.IsActive).OrderByDescending(f => f.Year).ToList();

        // Load allowed companies (inferred from allowed branches)
        if (CurrentUserContext.HasAllBranches)
        {
            allowedCompanies = DbContext.Companies.Where(c => c.IsActive).OrderBy(c => c.Code).ToList();
        }
        else if (!string.IsNullOrEmpty(CurrentUserContext.UserId))
        {
            allowedCompanies = DbContext.UserBranches
                .Where(ub => ub.UserId == CurrentUserContext.UserId && ub.Branch != null && ub.Branch.IsActive && ub.Branch.Company != null && ub.Branch.Company.IsActive)
                .Select(ub => ub.Branch!.Company!)
                .Distinct()
                .OrderBy(c => c.Code)
                .ToList();
        }

        // Load allowed branches for the current company only
        if (CurrentUserContext.HasAllBranches)
        {
            allowedBranches = DbContext.Branches
                .Where(b => b.IsActive && b.CompanyId == CurrentUserContext.CompanyId)
                .OrderBy(b => b.Code).ToList();
        }
        else if (!string.IsNullOrEmpty(CurrentUserContext.UserId))
        {
            allowedBranches = DbContext.UserBranches
                .Where(ub => ub.UserId == CurrentUserContext.UserId &&
                             ub.Branch.IsActive &&
                             ub.Branch.CompanyId == CurrentUserContext.CompanyId)
                .Select(ub => ub.Branch)
                .OrderBy(b => b.Code)
                .ToList();
        }
    }
}

<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Localizer["AppName"]</title>

    <!-- Anti-flicker / No-Layout-Shift Sidebar Pre-render Check -->
    <script>
        (function () {
            try {
                if (window.innerWidth >= 992 && localStorage.getItem('erp_sidebar_hidden') === 'true') {
                    document.documentElement.classList.add('sidebar-is-hidden', 'no-sidebar-transition');
                }
            } catch (e) { }
        })();
    </script>

    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    @if (isRtl)
    {
        <!-- Arabic Google Fonts & Bootstrap 5 RTL -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    }
    else
    {
        <!-- Bootstrap 5 LTR -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    }

    <!-- Select2 & Bootstrap 5 Theme -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

    <!-- Enterprise Desktop ERP Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="erp-wrapper">
        @if (CurrentUserContext.IsAuthenticated)
        {
            <!-- Overlay for Mobile/Tablet Sidebar Drawer -->
            <div class="erp-sidebar-overlay" id="sidebarOverlay"></div>

            <!-- Desktop First Collapsible Multi-Level Sidebar -->
            <aside class="erp-sidebar" id="erpSidebar">
            <div class="erp-sidebar-brand d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center overflow-hidden">
                    <i class="fa-solid fa-layer-group brand-logo flex-shrink-0"></i>
                    <span class="brand-text text-truncate">@Localizer["AppName"]</span>
                </div>
                <button type="button" class="btn btn-sm btn-link sidebar-collapse-btn text-white-50 p-1 ms-auto" id="sidebarInnerToggleBtn" title="@(isRtl ? "إخفاء القائمة الجانبية (Ctrl + B)" : "Hide Sidebar (Ctrl + B)")">
                    <i class="fa-solid @(isRtl ? "fa-angles-right" : "fa-angles-left")"></i>
                </button>
            </div>

            <ul class="erp-sidebar-nav">
                <!-- Dashboard -->
                <li class="erp-nav-item">
                    <a href="@Url.Action("Index", "Home")" class="erp-nav-link active">
                        <i class="fa-solid fa-gauge-high nav-icon"></i>
                        <span class="nav-text">@Localizer["Dashboard"]</span>
                    </a>
                </li>

                <!-- Organization (Company, Branches, Fiscal Years) -->
                @if (CurrentUserContext.HasPermission("Organization.Company.View") ||
                     CurrentUserContext.HasPermission("Organization.Branch.View") ||
                     CurrentUserContext.HasPermission("Organization.FiscalYear.View"))
                {
                    <li class="erp-nav-item">
                        <a href="#menuOrg" class="erp-nav-link" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="menuOrg">
                            <i class="fa-solid fa-sitemap nav-icon"></i>
                            <span class="nav-text">@Localizer["Organization"]</span>
                            <i class="fa-solid @(isRtl ? "fa-chevron-left" : "fa-chevron-right") arrow-icon ms-auto me-0"></i>
                        </a>
                        <ul class="collapse erp-submenu" id="menuOrg">
                            @if (CurrentUserContext.HasPermission("Organization.Company.View"))
                            {
                                <li><a href="@Url.Action("Index", "Company")" class="erp-nav-link"><i class="fa-solid fa-building-columns nav-icon"></i><span class="nav-text">@Localizer["Company"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("Organization.Branch.View"))
                            {
                                <li><a href="@Url.Action("Index", "Branch")" class="erp-nav-link"><i class="fa-solid fa-code-branch nav-icon"></i><span class="nav-text">@Localizer["Branches"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("Organization.FiscalYear.View"))
                            {
                                <li><a href="@Url.Action("Index", "FiscalYear")" class="erp-nav-link"><i class="fa-solid fa-calendar-check nav-icon"></i><span class="nav-text">@Localizer["FiscalYears"]</span></a></li>
                            }
                        </ul>
                    </li>
                }

                <!-- Administration (Users, Roles, Permissions, User Company, User Branch, Audit History) -->
                @if (CurrentUserContext.HasPermission("Administration.Users.View") ||
                     CurrentUserContext.HasPermission("Administration.Roles.View") ||
                     CurrentUserContext.HasPermission("Administration.Permissions.View") ||
                     CurrentUserContext.HasPermission("Administration.UserBranch.View") ||
                     CurrentUserContext.HasPermission("Administration.PaymentMethodPermissions.View") ||
                     CurrentUserContext.HasPermission("Administration.AuditHistory.View"))
                {
                    <li class="erp-nav-item">
                        <a href="#menuAdmin" class="erp-nav-link" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="menuAdmin">
                            <i class="fa-solid fa-user-shield nav-icon"></i>
                            <span class="nav-text">@Localizer["Administration"]</span>
                            <i class="fa-solid @(isRtl ? "fa-chevron-left" : "fa-chevron-right") arrow-icon ms-auto me-0"></i>
                        </a>
                        <ul class="collapse erp-submenu" id="menuAdmin">
                            @if (CurrentUserContext.HasPermission("Administration.Users.View"))
                            {
                                <li><a href="@Url.Action("Index", "User")" class="erp-nav-link"><i class="fa-solid fa-users nav-icon"></i><span class="nav-text">@Localizer["Users"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("Administration.Roles.View"))
                            {
                                <li><a href="@Url.Action("Index", "Role")" class="erp-nav-link"><i class="fa-solid fa-id-card-clip nav-icon"></i><span class="nav-text">@Localizer["Roles"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("Administration.Permissions.View"))
                            {
                                <li><a href="@Url.Action("Index", "Permission")" class="erp-nav-link"><i class="fa-solid fa-key nav-icon"></i><span class="nav-text">@Localizer["Permissions"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("Administration.UserBranch.View"))
                            {
                                <li><a href="@Url.Action("Index", "UserBranch")" class="erp-nav-link"><i class="fa-solid fa-user-gear nav-icon"></i><span class="nav-text">@Localizer["UserBranchAssignment"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("Administration.PaymentMethodPermissions.View"))
                            {
                                <li><a href="@Url.Action("Index", "PaymentMethodPermissions")" class="erp-nav-link"><i class="fa-solid fa-money-check-dollar nav-icon"></i><span class="nav-text">صلاحيات وسائل الدفع</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("Administration.TransactionTypes.View,Administration.Roles.View"))
                            {
                                <li><a href="@Url.Action("Index", "TransactionTypes")" class="erp-nav-link"><i class="fa-solid fa-sliders nav-icon"></i><span class="nav-text">تهيئة أنواع الحركات</span></a></li>
                                <li><a href="@Url.Action("Permissions", "TransactionTypes")" class="erp-nav-link"><i class="fa-solid fa-user-lock nav-icon"></i><span class="nav-text">صلاحيات أنواع الحركات</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("Administration.AuditHistory.View"))
                            {
                                <li>
                                    <a href="@Url.Action("Index", "Audit")" class="erp-nav-link">
                                        <i class="fa-solid fa-shield-halved nav-icon"></i>
                                        <span class="nav-text">Audit History</span>
                                    </a>
                                </li>
                            }
                            <li>
                                <a href="@Url.Action("Index", "SystemFeedback")" class="erp-nav-link">
                                    <i class="fa-solid fa-clipboard-question nav-icon text-warning"></i>
                                    <span class="nav-text">اختبارات وملاحظات النظام</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                }

                <!-- Master Data -->
                @if (CurrentUserContext.HasPermission("MasterData.Governorates.View") ||
                     CurrentUserContext.HasPermission("MasterData.Cities.View") ||
                     CurrentUserContext.HasPermission("MasterData.Salesmen.View") ||
                     CurrentUserContext.HasPermission("MasterData.Currencies.View") ||
                     CurrentUserContext.HasPermission("MasterData.CustomerCategories.View") ||
                     CurrentUserContext.HasPermission("MasterData.Customers.View") ||
                     CurrentUserContext.HasPermission("MasterData.VendorCategories.View") ||
                     CurrentUserContext.HasPermission("MasterData.Vendors.View") ||
                     CurrentUserContext.HasPermission("MasterData.Units.View") ||
                     CurrentUserContext.HasPermission("MasterData.ItemGroups.View") ||
                     CurrentUserContext.HasPermission("MasterData.Items.View") ||
                     CurrentUserContext.HasPermission("MasterData.ItemUnits.View") ||
                     CurrentUserContext.HasPermission("MasterData.Warehouses.View"))
                {
                    <li class="erp-nav-item">
                        <a href="#menuMasterData" class="erp-nav-link" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="menuMasterData">
                            <i class="fa-solid fa-database nav-icon"></i>
                            <span class="nav-text">@Localizer["MasterData"]</span>
                            <i class="fa-solid @(isRtl ? "fa-chevron-left" : "fa-chevron-right") arrow-icon ms-auto me-0"></i>
                        </a>
                        <ul class="collapse erp-submenu" id="menuMasterData">
                            @if (CurrentUserContext.HasPermission("MasterData.Governorates.View"))
                            {
                                <li><a href="@Url.Action("Index", "Governorate")" class="erp-nav-link"><i class="fa-solid fa-map-location-dot nav-icon"></i><span class="nav-text">@Localizer["Governorates"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.Cities.View"))
                            {
                                <li><a href="@Url.Action("Index", "City")" class="erp-nav-link"><i class="fa-solid fa-city nav-icon"></i><span class="nav-text">@Localizer["Cities"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.Salesmen.View"))
                            {
                                <li><a href="@Url.Action("Index", "Salesman")" class="erp-nav-link"><i class="fa-solid fa-user-tie nav-icon"></i><span class="nav-text">@Localizer["Salesmen"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.Currencies.View"))
                            {
                                <li><a href="@Url.Action("Index", "Currency")" class="erp-nav-link"><i class="fa-solid fa-coins nav-icon"></i><span class="nav-text">@Localizer["Currencies"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.CustomerCategories.View"))
                            {
                                <li><a href="@Url.Action("Index", "CustomerCategory")" class="erp-nav-link"><i class="fa-solid fa-tags nav-icon"></i><span class="nav-text">@Localizer["CustomerCategories"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.Customers.View"))
                            {
                                <li><a href="@Url.Action("Index", "Customer")" class="erp-nav-link"><i class="fa-solid fa-address-book nav-icon"></i><span class="nav-text">@Localizer["Customers"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.VendorCategories.View"))
                            {
                                <li><a href="@Url.Action("Index", "VendorCategory")" class="erp-nav-link"><i class="fa-solid fa-boxes-packing nav-icon"></i><span class="nav-text">@Localizer["VendorCategories"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.Vendors.View"))
                            {
                                <li><a href="@Url.Action("Index", "Vendor")" class="erp-nav-link"><i class="fa-solid fa-truck-field nav-icon"></i><span class="nav-text">@Localizer["Vendors"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.Units.View"))
                            {
                                <li><a href="@Url.Action("Index", "Unit")" class="erp-nav-link"><i class="fa-solid fa-ruler-combined nav-icon"></i><span class="nav-text">@Localizer["Units"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.ItemGroups.View"))
                            {
                                <li><a href="@Url.Action("Index", "ItemGroup")" class="erp-nav-link"><i class="fa-solid fa-folder-tree nav-icon"></i><span class="nav-text">@Localizer["ItemGroups"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.Items.View"))
                            {
                                <li><a href="@Url.Action("Index", "Item")" class="erp-nav-link"><i class="fa-solid fa-boxes-stacked nav-icon"></i><span class="nav-text">@Localizer["Items"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.ItemUnits.View"))
                            {
                                <li><a href="@Url.Action("Index", "ItemUnit")" class="erp-nav-link"><i class="fa-solid fa-scale-balanced nav-icon"></i><span class="nav-text">@Localizer["ItemUnits"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.Warehouses.View"))
                            {
                                <li><a href="@Url.Action("Index", "Warehouse")" class="erp-nav-link"><i class="fa-solid fa-warehouse nav-icon"></i><span class="nav-text">@Localizer["Warehouses"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("Inventory.SerialNumbers.View,Inventory.Items.View"))
                            {
                                <li><a href="@Url.Action("Inquiry", "SerialNumbers")" class="erp-nav-link"><i class="fa-solid fa-barcode nav-icon"></i><span class="nav-text">استعلام وتتبع السيريال</span></a></li>
                            }
                        </ul>
                    </li>
                }



                <!-- Sales -->
                @if (CurrentUserContext.HasPermission("Sales.SalesInvoice.View,Sales.SalesInvoice.Add,Sales.Documents.View"))
                {
                    <li class="erp-nav-item">
                        <a href="#menuSales" class="erp-nav-link" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="menuSales">
                            <i class="fa-solid fa-cart-shopping nav-icon"></i>
                            <span class="nav-text">@Localizer["Sales"]</span>
                            <i class="fa-solid @(isRtl ? "fa-chevron-left" : "fa-chevron-right") arrow-icon ms-auto me-0"></i>
                        </a>
                        <ul class="collapse erp-submenu" id="menuSales">
                            @if (CurrentUserContext.HasPermission("Sales.SalesInvoice.View,Sales.Documents.View"))
                            {
                                <li><a href="@Url.Action("Index", "Documents", new { module = 1 })" class="erp-nav-link"><i class="fa-solid fa-file-invoice nav-icon"></i><span class="nav-text">فواتير ومستندات المبيعات</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("Sales.SalesInvoice.Add"))
                            {
                                <li><a href="@Url.Action("Create", "Documents", new { module = 1 })" class="erp-nav-link"><i class="fa-solid fa-circle-plus nav-icon"></i><span class="nav-text">إنشاء فاتورة / حركة بيع</span></a></li>
                            }
                        </ul>
                    </li>
                }

                <!-- Purchases -->
                @if (CurrentUserContext.HasPermission("Purchases.PurchaseInvoice.View,Purchases.PurchaseInvoice.Add,Purchases.Documents.View"))
                {
                    <li class="erp-nav-item">
                        <a href="#menuPurchases" class="erp-nav-link" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="menuPurchases">
                            <i class="fa-solid fa-bag-shopping nav-icon"></i>
                            <span class="nav-text">@Localizer["Purchases"]</span>
                            <i class="fa-solid @(isRtl ? "fa-chevron-left" : "fa-chevron-right") arrow-icon ms-auto me-0"></i>
                        </a>
                        <ul class="collapse erp-submenu" id="menuPurchases">
                            @if (CurrentUserContext.HasPermission("Purchases.PurchaseInvoice.View,Purchases.Documents.View"))
                            {
                                <li><a href="@Url.Action("Index", "Documents", new { module = 2 })" class="erp-nav-link"><i class="fa-solid fa-cart-flatbed nav-icon"></i><span class="nav-text">فواتير ومستندات المشتريات</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("Purchases.PurchaseInvoice.Add"))
                            {
                                <li><a href="@Url.Action("Create", "Documents", new { module = 2 })" class="erp-nav-link"><i class="fa-solid fa-circle-plus nav-icon"></i><span class="nav-text">إنشاء فاتورة / حركة شراء</span></a></li>
                            }
                        </ul>
                    </li>
                }

                <!-- Inventory -->
                @if (CurrentUserContext.HasPermission("Inventory.StockTransfer.View,Inventory.Items.View,Inventory.StockBalances.View,Inventory.Documents.View"))
                {
                    <li class="erp-nav-item">
                        <a href="#menuInventory" class="erp-nav-link" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="menuInventory">
                            <i class="fa-solid fa-boxes-stacked nav-icon"></i>
                            <span class="nav-text">@Localizer["Inventory"]</span>
                            <i class="fa-solid @(isRtl ? "fa-chevron-left" : "fa-chevron-right") arrow-icon ms-auto me-0"></i>
                        </a>
                        <ul class="collapse erp-submenu" id="menuInventory">
                            <li><a href="@Url.Action("Index", "Documents", new { module = 3 })" class="erp-nav-link"><i class="fa-solid fa-dolly nav-icon"></i><span class="nav-text">حركات وأذون المخازن</span></a></li>
                            @if (CurrentUserContext.HasPermission("Inventory.StockTransfer.Add,Inventory.Items.Add"))
                            {
                                <li><a href="@Url.Action("Create", "Documents", new { module = 3 })" class="erp-nav-link"><i class="fa-solid fa-circle-plus nav-icon"></i><span class="nav-text">إنشاء إذن / حركة مخزنية</span></a></li>
                            }
                        </ul>
                    </li>
                }

                <!-- Fixed Assets & Depreciation (الأصول الثابتة والإهلاكات) -->
                @if (CurrentUserContext.HasPermission("FixedAssets.Asset.View,FixedAssets.Category.View,FixedAssets.Depreciation.View"))
                {
                    <li class="erp-nav-item">
                        <a href="#menuFixedAssets" class="erp-nav-link" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="menuFixedAssets">
                            <i class="fa-solid fa-building nav-icon"></i>
                            <span class="nav-text">الأصول الثابتة والإهلاكات</span>
                            <i class="fa-solid @(isRtl ? "fa-chevron-left" : "fa-chevron-right") arrow-icon ms-auto me-0"></i>
                        </a>
                        <ul class="collapse erp-submenu" id="menuFixedAssets">
                            <li><a href="@Url.Action("Index", "FixedAssets")" class="erp-nav-link"><i class="fa-solid fa-cube nav-icon"></i><span class="nav-text">سجل الأصول الثابتة</span></a></li>
                            <li><a href="@Url.Action("Create", "FixedAssets")" class="erp-nav-link"><i class="fa-solid fa-plus nav-icon"></i><span class="nav-text">إضافة أصل جديد</span></a></li>
                            <li><a href="@Url.Action("Index", "AssetDepreciation")" class="erp-nav-link"><i class="fa-solid fa-calculator nav-icon"></i><span class="nav-text">تشغيل الإهلاكات الدورية</span></a></li>
                            <li><a href="@Url.Action("Index", "AssetCategories")" class="erp-nav-link"><i class="fa-solid fa-boxes-stacked nav-icon"></i><span class="nav-text">مجموعات وتصنيفات الأصول</span></a></li>
                            <li><a href="@Url.Action("Index", "FixedAssetReports")" class="erp-nav-link"><i class="fa-solid fa-chart-pie nav-icon"></i><span class="nav-text">تقارير الأصول الثابتة</span></a></li>
                        </ul>
                    </li>
                }

                <!-- Accounting -->
                @if (CurrentUserContext.HasPermission("Accounting.JournalVoucher.View") ||
                     CurrentUserContext.HasPermission("Accounting.CurrencyRevaluation.View") ||
                     CurrentUserContext.HasPermission("Accounting.ChartOfAccounts.View") ||
                     CurrentUserContext.HasPermission("Accounting.CostCenters.View"))
                {
                    <li class="erp-nav-item">
                        <a href="#menuAccounting" class="erp-nav-link" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="menuAccounting">
                            <i class="fa-solid fa-book-journal-whills nav-icon"></i>
                            <span class="nav-text">@Localizer["Accounting"]</span>
                            <i class="fa-solid @(isRtl ? "fa-chevron-left" : "fa-chevron-right") arrow-icon ms-auto me-0"></i>
                        </a>
                        <ul class="collapse erp-submenu" id="menuAccounting">
                            @if (CurrentUserContext.HasPermission("Accounting.JournalVoucher.View"))
                            {
                                <li><a href="@Url.Action("Index", "JournalEntries")" class="erp-nav-link"><i class="fa-solid fa-file-invoice-dollar nav-icon"></i><span class="nav-text">قيود اليومية</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("Accounting.CurrencyRevaluation.View"))
                            {
                                <li><a href="@Url.Action("Index", "CurrencyRevaluations")" class="erp-nav-link"><i class="fa-solid fa-scale-balanced nav-icon"></i><span class="nav-text">إعادة تقييم العملات الأجنبية</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("Accounting.ChartOfAccounts.View"))
