@using System.Globalization
@using Microsoft.Extensions.Localization
@inject ERP.Application.Interfaces.ICurrentUserContext CurrentUserContext
@inject ERP.Infrastructure.Data.ErpDbContext DbContext
@inject IStringLocalizer<ERP.Web.Resources.SharedResource> Localizer

@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var currentCulture = CultureInfo.CurrentUICulture.Name;

    List<ERP.Domain.Entities.Company> allowedCompanies = new List<ERP.Domain.Entities.Company>();
    List<ERP.Domain.Entities.Branch> allowedBranches = new List<ERP.Domain.Entities.Branch>();
    List<ERP.Domain.Entities.FiscalYear> activeFiscalYears = new List<ERP.Domain.Entities.FiscalYear>();
    if (CurrentUserContext.IsAuthenticated)
    {
        activeFiscalYears = DbContext.FiscalYears.Where(f => f.IsActive).OrderByDescending(f => f.Year).ToList();

        // Load allowed companies (inferred from allowed branches)
        if (CurrentUserContext.HasAllBranches)
        {
            allowedCompanies = DbContext.Companies.Where(c => c.IsActive).OrderBy(c => c.Code).ToList();
        }
        else if (!string.IsNullOrEmpty(CurrentUserContext.UserId))
        {
            allowedCompanies = DbContext.UserBranches
                .Where(ub => ub.UserId == CurrentUserContext.UserId && ub.Branch != null && ub.Branch.IsActive && ub.Branch.Company != null && ub.Branch.Company.IsActive)
                .Select(ub => ub.Branch!.Company!)
                .Distinct()
                .OrderBy(c => c.Code)
                .ToList();
        }

        // Load allowed branches for the current company only
        if (CurrentUserContext.HasAllBranches)
        {
            allowedBranches = DbContext.Branches
                .Where(b => b.IsActive && b.CompanyId == CurrentUserContext.CompanyId)
                .OrderBy(b => b.Code).ToList();
        }
        else if (!string.IsNullOrEmpty(CurrentUserContext.UserId))
        {
            allowedBranches = DbContext.UserBranches
                .Where(ub => ub.UserId == CurrentUserContext.UserId &&
                             ub.Branch.IsActive &&
                             ub.Branch.CompanyId == CurrentUserContext.CompanyId)
                .Select(ub => ub.Branch)
                .OrderBy(b => b.Code)
                .ToList();
        }
    }
}

<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Localizer["AppName"]</title>

    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    @if (isRtl)
    {
        <!-- Arabic Google Fonts & Bootstrap 5 RTL -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    }
    else
    {
        <!-- Bootstrap 5 LTR -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    }

    <!-- Enterprise Desktop ERP Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="erp-wrapper">
        <!-- Overlay for Mobile/Tablet Sidebar Drawer -->
        <div class="erp-sidebar-overlay" id="sidebarOverlay"></div>

        <!-- Desktop First Collapsible Multi-Level Sidebar -->
        <aside class="erp-sidebar" id="erpSidebar">
            <div class="erp-sidebar-brand">
                <i class="fa-solid fa-layer-group brand-logo"></i>
                <span class="brand-text">@Localizer["AppName"]</span>
            </div>

            <ul class="erp-sidebar-nav">
                <!-- Dashboard -->
                <li class="erp-nav-item">
                    <a href="@Url.Action("Index", "Home")" class="erp-nav-link active">
                        <i class="fa-solid fa-gauge-high nav-icon"></i>
                        <span class="nav-text">@Localizer["Dashboard"]</span>
                    </a>
                </li>

                <!-- Organization (Company, Branches, Fiscal Years) -->
                <li class="erp-nav-item">
                    <a href="#menuOrg" class="erp-nav-link" data-bs-toggle="collapse" role="button" aria-expanded="true" aria-controls="menuOrg">
                        <i class="fa-solid fa-sitemap nav-icon"></i>
                        <span class="nav-text">@Localizer["Organization"]</span>
                        <i class="fa-solid @(isRtl ? "fa-chevron-left" : "fa-chevron-right") arrow-icon ms-auto me-0"></i>
                    </a>
                    <ul class="collapse show erp-submenu" id="menuOrg">
                        <li><a href="@Url.Action("Index", "Company")" class="erp-nav-link"><i class="fa-solid fa-building-columns nav-icon"></i><span class="nav-text">@Localizer["Company"]</span></a></li>
                        <li><a href="@Url.Action("Index", "Branch")" class="erp-nav-link"><i class="fa-solid fa-code-branch nav-icon"></i><span class="nav-text">@Localizer["Branches"]</span></a></li>
                        <li><a href="@Url.Action("Index", "FiscalYear")" class="erp-nav-link"><i class="fa-solid fa-calendar-check nav-icon"></i><span class="nav-text">@Localizer["FiscalYears"]</span></a></li>
                    </ul>
                </li>

                <!-- Administration (Users, Roles, Permissions, User Company, User Branch, Audit History) -->
                <li class="erp-nav-item">
                    <a href="#menuAdmin" class="erp-nav-link" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="menuAdmin">
                        <i class="fa-solid fa-user-shield nav-icon"></i>
                        <span class="nav-text">@Localizer["Administration"]</span>
                        <i class="fa-solid @(isRtl ? "fa-chevron-left" : "fa-chevron-right") arrow-icon ms-auto me-0"></i>
                    </a>
                    <ul class="collapse erp-submenu" id="menuAdmin">
                        <li><a href="@Url.Action("Index", "User")" class="erp-nav-link"><i class="fa-solid fa-users nav-icon"></i><span class="nav-text">@Localizer["Users"]</span></a></li>
                        <li><a href="@Url.Action("Index", "Role")" class="erp-nav-link"><i class="fa-solid fa-id-card-clip nav-icon"></i><span class="nav-text">@Localizer["Roles"]</span></a></li>
                        <li><a href="@Url.Action("Index", "Permission")" class="erp-nav-link"><i class="fa-solid fa-key nav-icon"></i><span class="nav-text">@Localizer["Permissions"]</span></a></li>
                        <li><a href="@Url.Action("Index", "UserBranch")" class="erp-nav-link"><i class="fa-solid fa-user-gear nav-icon"></i><span class="nav-text">@Localizer["UserBranchAssignment"]</span></a></li>
                        @if (CurrentUserContext.HasPermission("Administration.AuditHistory.View"))
                        {
                            <li>
                                <a href="@Url.Action("Index", "Audit")" class="erp-nav-link">
                                    <i class="fa-solid fa-shield-halved nav-icon"></i>
                                    <span class="nav-text">Audit History</span>
                                </a>
                            </li>
                        }
                    </ul>
                </li>

                <!-- Master Data -->
                @if (CurrentUserContext.HasPermission("MasterData.Governorates.View") ||
                     CurrentUserContext.HasPermission("MasterData.Cities.View") ||
                     CurrentUserContext.HasPermission("MasterData.Salesmen.View") ||
                     CurrentUserContext.HasPermission("MasterData.Currencies.View") ||
                     CurrentUserContext.HasPermission("MasterData.CustomerCategories.View") ||
                     CurrentUserContext.HasPermission("MasterData.Customers.View") ||
                     CurrentUserContext.HasPermission("MasterData.VendorCategories.View") ||
                     CurrentUserContext.HasPermission("MasterData.Vendors.View") ||
                     CurrentUserContext.HasPermission("MasterData.Units.View") ||
                     CurrentUserContext.HasPermission("MasterData.ItemGroups.View") ||
                     CurrentUserContext.HasPermission("MasterData.Items.View") ||
                     CurrentUserContext.HasPermission("MasterData.ItemUnits.View") ||
                     CurrentUserContext.HasPermission("MasterData.Warehouses.View"))
                {
                    <li class="erp-nav-item">
                        <a href="#menuMasterData" class="erp-nav-link" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="menuMasterData">
                            <i class="fa-solid fa-database nav-icon"></i>
                            <span class="nav-text">@Localizer["MasterData"]</span>
                            <i class="fa-solid @(isRtl ? "fa-chevron-left" : "fa-chevron-right") arrow-icon ms-auto me-0"></i>
                        </a>
                        <ul class="collapse erp-submenu" id="menuMasterData">
                            @if (CurrentUserContext.HasPermission("MasterData.Governorates.View"))
                            {
                                <li><a href="@Url.Action("Index", "Governorate")" class="erp-nav-link"><i class="fa-solid fa-map-location-dot nav-icon"></i><span class="nav-text">@Localizer["Governorates"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.Cities.View"))
                            {
                                <li><a href="@Url.Action("Index", "City")" class="erp-nav-link"><i class="fa-solid fa-city nav-icon"></i><span class="nav-text">@Localizer["Cities"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.Salesmen.View"))
                            {
                                <li><a href="@Url.Action("Index", "Salesman")" class="erp-nav-link"><i class="fa-solid fa-user-tie nav-icon"></i><span class="nav-text">@Localizer["Salesmen"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.Currencies.View"))
                            {
                                <li><a href="@Url.Action("Index", "Currency")" class="erp-nav-link"><i class="fa-solid fa-coins nav-icon"></i><span class="nav-text">@Localizer["Currencies"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.CustomerCategories.View"))
                            {
                                <li><a href="@Url.Action("Index", "CustomerCategory")" class="erp-nav-link"><i class="fa-solid fa-tags nav-icon"></i><span class="nav-text">@Localizer["CustomerCategories"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.Customers.View"))
                            {
                                <li><a href="@Url.Action("Index", "Customer")" class="erp-nav-link"><i class="fa-solid fa-address-book nav-icon"></i><span class="nav-text">@Localizer["Customers"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.VendorCategories.View"))
                            {
                                <li><a href="@Url.Action("Index", "VendorCategory")" class="erp-nav-link"><i class="fa-solid fa-boxes-packing nav-icon"></i><span class="nav-text">@Localizer["VendorCategories"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.Vendors.View"))
                            {
                                <li><a href="@Url.Action("Index", "Vendor")" class="erp-nav-link"><i class="fa-solid fa-truck-field nav-icon"></i><span class="nav-text">@Localizer["Vendors"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.Units.View"))
                            {
                                <li><a href="@Url.Action("Index", "Unit")" class="erp-nav-link"><i class="fa-solid fa-ruler-combined nav-icon"></i><span class="nav-text">@Localizer["Units"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.ItemGroups.View"))
                            {
                                <li><a href="@Url.Action("Index", "ItemGroup")" class="erp-nav-link"><i class="fa-solid fa-folder-tree nav-icon"></i><span class="nav-text">@Localizer["ItemGroups"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.Items.View"))
                            {
                                <li><a href="@Url.Action("Index", "Item")" class="erp-nav-link"><i class="fa-solid fa-boxes-stacked nav-icon"></i><span class="nav-text">@Localizer["Items"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.ItemUnits.View"))
                            {
                                <li><a href="@Url.Action("Index", "ItemUnit")" class="erp-nav-link"><i class="fa-solid fa-scale-balanced nav-icon"></i><span class="nav-text">@Localizer["ItemUnits"]</span></a></li>
                            }
                            @if (CurrentUserContext.HasPermission("MasterData.Warehouses.View"))
                            {
                                <li><a href="@Url.Action("Index", "Warehouse")" class="erp-nav-link"><i class="fa-solid fa-warehouse nav-icon"></i><span class="nav-text">@Localizer["Warehouses"]</span></a></li>
                            }
                        </ul>
                    </li>
                }



                <!-- Sales -->
                <li class="erp-nav-item">
                    <a href="#" class="erp-nav-link text-muted opacity-75">
                        <i class="fa-solid fa-cart-shopping nav-icon"></i>
                        <span class="nav-text">@Localizer["Sales"]</span>
                    </a>
                </li>

                <!-- Purchases -->
                <li class="erp-nav-item">
                    <a href="#" class="erp-nav-link text-muted opacity-75">
                        <i class="fa-solid fa-bag-shopping nav-icon"></i>
                        <span class="nav-text">@Localizer["Purchases"]</span>
                    </a>
                </li>

                <!-- Inventory -->
                <li class="erp-nav-item">
                    <a href="#" class="erp-nav-link text-muted opacity-75">
                        <i class="fa-solid fa-boxes-stacked nav-icon"></i>
                        <span class="nav-text">@Localizer["Inventory"]</span>
                    </a>
                </li>

                <!-- Accounting -->
                <li class="erp-nav-item">
                    <a href="#" class="erp-nav-link text-muted opacity-75">
                        <i class="fa-solid fa-book-journal-whills nav-icon"></i>
                        <span class="nav-text">@Localizer["Accounting"]</span>
                    </a>
                </li>

                <!-- Reports -->
                <li class="erp-nav-item">
                    <a href="#" class="erp-nav-link text-muted opacity-75">
                        <i class="fa-solid fa-chart-column nav-icon"></i>
                        <span class="nav-text">@Localizer["Reports"]</span>
                    </a>
                </li>

                <!-- Settings -->
                <li class="erp-nav-item">
                    <a href="#" class="erp-nav-link text-muted opacity-75">
                        <i class="fa-solid fa-sliders nav-icon"></i>
                        <span class="nav-text">@Localizer["Settings"]</span>
                    </a>
                </li>
            </ul>
        </aside>

        <!-- Main Content Area -->
        <main class="erp-main">
            <!-- Top Navbar Header -->
            <header class="erp-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="erp-toggle-btn" id="sidebarToggleBtn" title="Toggle Sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <span class="fw-bold text-secondary d-none d-lg-inline" style="font-size: 13.5px;">@Localizer["AppName"]</span>
                </div>

                <!-- Header: Company | Branch | Fiscal Year | User | Language | Notifications -->
                <div class="d-flex align-items-center gap-2 gap-md-3">
                    <!-- Language Selector Form -->
                    <form asp-controller="Account" asp-action="SetLanguage" method="post" class="d-inline m-0">
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle px-2 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 12px;">
                                <i class="fa-solid fa-globe me-1 text-primary"></i>
                                @(isRtl ? "العربية" : "English")
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="font-size: 12.5px;">
                                <li>
                                    <button type="submit" name="culture" value="ar-EG" class="dropdown-item d-flex align-items-center justify-content-between @(isRtl ? "active" : "")">
                                        <span>🇸🇦 العربية (Arabic)</span>
                                        @if (isRtl) { <i class="fa-solid fa-check ms-2"></i> }
                                    </button>
                                </li>
                                <li>
                                    <button type="submit" name="culture" value="en-US" class="dropdown-item d-flex align-items-center justify-content-between @(!isRtl ? "active" : "")">
                                        <span>🇺🇸 English</span>
                                        @if (!isRtl) { <i class="fa-solid fa-check ms-2"></i> }
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </form>

                    @if (CurrentUserContext.IsAuthenticated)
                    {
                        <div class="erp-context-badges d-none d-md-flex align-items-center gap-2">

                            <!-- Company Switcher Dropdown -->
                            @if (allowedCompanies.Count > 1)
                            {
                                <div class="dropdown">
                                    <button class="context-badge" style="background-color: #f8fafc; border: 1px solid #cbd5e1; color: #334155; cursor:pointer;" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@Localizer["SwitchCompany"]">
                                        <i class="fa-solid fa-building text-primary me-1 ms-0"></i> <strong>@Localizer["Company"]:</strong> @CurrentUserContext.CompanyName
                                        <i class="fa-solid fa-chevron-down ms-1" style="font-size:9px;"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="font-size: 12px;">
                                        <li class="dropdown-header fw-bold text-primary">@Localizer["SwitchCompany"]</li>
                                        @foreach (var comp in allowedCompanies)
                                        {
                                            <li>
                                                <form asp-controller="Account" asp-action="SwitchCompany" method="post" class="m-0">
                                                    <input type="hidden" name="companyId" value="@comp.Id" />
                                                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                                    <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between @(CurrentUserContext.CompanyId == comp.Id ? "active" : "")">
                                                        <span>@comp.Code - @comp.LocalizedName</span>
                                                        @if (CurrentUserContext.CompanyId == comp.Id) { <i class="fa-solid fa-check ms-2"></i> }
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <span class="context-badge" style="background-color: #f8fafc; border: 1px solid #cbd5e1; color: #334155;" title="@Localizer["Company"]">
                                    <i class="fa-solid fa-building text-primary me-1 ms-0"></i> <strong>@Localizer["Company"]:</strong> @CurrentUserContext.CompanyName
                                </span>
                            }

                            <!-- Branch Switcher Dropdown -->
                            @if (allowedBranches.Count > 1)
                            {
                                <div class="dropdown">
                                    <button class="context-badge context-badge-branch dropdown-toggle border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@Localizer["SwitchBranch"]">
                                        <i class="fa-solid fa-code-branch me-1 ms-0"></i> <strong>@Localizer["Branch"]:</strong> @CurrentUserContext.BranchName
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="font-size: 12px;">
                                        <li class="dropdown-header fw-bold text-primary">@Localizer["SwitchBranch"]</li>
                                        @foreach (var b in allowedBranches)
                                        {
                                            <li>
                                                <form asp-controller="Account" asp-action="SwitchBranch" method="post" class="m-0">
                                                    <input type="hidden" name="branchId" value="@b.Id" />
                                                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                                    <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between @(CurrentUserContext.BranchId == b.Id ? "active" : "")">
                                                        <span>@b.Code - @b.LocalizedName</span>
                                                        @if (CurrentUserContext.BranchId == b.Id) { <i class="fa-solid fa-check ms-2"></i> }
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <span class="context-badge context-badge-branch" title="@Localizer["Branch"]">
                                    <i class="fa-solid fa-code-branch me-1 ms-0"></i> <strong>@Localizer["Branch"]:</strong> @CurrentUserContext.BranchName
                                </span>
                            }

                            <!-- Fiscal Year Switcher Dropdown -->
                            @if (activeFiscalYears.Count > 1)
                            {
                                <div class="dropdown">
                                    <button class="context-badge context-badge-fy dropdown-toggle border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@Localizer["SwitchFiscalYear"]">
                                        <i class="fa-regular fa-calendar me-1 ms-0"></i> <strong>@Localizer["FiscalYear"]:</strong> @CurrentUserContext.FiscalYearName
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="font-size: 12px;">
                                        <li class="dropdown-header fw-bold text-primary">@Localizer["SwitchFiscalYear"]</li>
                                        @foreach (var fy in activeFiscalYears)
                                        {
                                            <li>
                                                <form asp-controller="Account" asp-action="SwitchFiscalYear" method="post" class="m-0">
                                                    <input type="hidden" name="fiscalYearId" value="@fy.Id" />
                                                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                                    <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between @(CurrentUserContext.FiscalYearId == fy.Id ? "active" : "")">
                                                        <span>@fy.LocalizedName</span>
                                                        @if (CurrentUserContext.FiscalYearId == fy.Id) { <i class="fa-solid fa-check ms-2"></i> }
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <span class="context-badge context-badge-fy" title="@Localizer["FiscalYear"]">
                                    <i class="fa-regular fa-calendar me-1 ms-0"></i> <strong>@Localizer["FiscalYear"]:</strong> @CurrentUserContext.FiscalYearName
                                </span>
                            }
                        </div>

                        <!-- Notifications Dropdown -->
                        <div class="dropdown">
                            <button class="btn btn-sm btn-link text-secondary p-1 position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@Localizer["Notifications"]">
                                <i class="fa-regular fa-bell fs-5"></i>
                                <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                                    <span class="visually-hidden">Alert</span>
                                </span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-3" style="width: 280px; font-size: 12px;">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom fw-bold">
                                    <span>@Localizer["Notifications"]</span>
                                    <span class="badge bg-primary">Phase 2</span>
                                </div>
                                <div class="text-muted small">
                                    <i class="fa-solid fa-circle-check text-success me-1 ms-0"></i> Company &amp; Organization Setup Live
                                </div>
                            </div>
                        </div>

                        <!-- User Profile Dropdown -->
                        <div class="dropdown">
                            <button class="user-dropdown-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar">
                                    @(CurrentUserContext.Username?.Substring(0, 1).ToUpper() ?? "U")
                                </div>
                                <div class="d-none d-sm-flex flex-column text-start lh-1">
                                    <span class="fw-bold text-dark" style="font-size: 12.5px;">@Localizer["User"]: @CurrentUserContext.Username</span>
                                    <span class="text-muted" style="font-size: 11px;">@CurrentUserContext.BranchName</span>
                                </div>
                                <i class="fa-solid fa-chevron-down text-muted ms-1" style="font-size: 10px;"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="font-size: 13px;">
                                <li class="dropdown-header text-muted fw-bold">@Localizer["AuthContext"]</li>
                                <li><a class="dropdown-item" href="#"><i class="fa-regular fa-user me-2 ms-0"></i> @Localizer["User"]: @CurrentUserContext.Username</a></li>
                                <li><a class="dropdown-item" href="#"><i class="fa-solid fa-building me-2 ms-0"></i> @Localizer["Company"]: @CurrentUserContext.CompanyName</a></li>
                                <li><a class="dropdown-item" href="#"><i class="fa-solid fa-code-branch me-2 ms-0"></i> @Localizer["Branch"]: @CurrentUserContext.BranchName</a></li>
                                <li><a class="dropdown-item" href="#"><i class="fa-regular fa-calendar me-2 ms-0"></i> @Localizer["FiscalYear"]: @CurrentUserContext.FiscalYearName</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="fa-solid fa-arrow-right-from-bracket me-2 ms-0"></i> @Localizer["Logout"]
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Account")" class="btn btn-erp-primary btn-sm px-3">
                            <i class="fa-solid fa-right-to-bracket me-1 ms-0"></i> @Localizer["SignIn"]
                        </a>
                    }
                </div>
            </header>

            <!-- Breadcrumbs Toolbar -->
            <div class="erp-breadcrumb-bar">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb erp-breadcrumb">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="fa-solid fa-house me-1 ms-0"></i> @Localizer["Home"]</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                    </ol>
                </nav>

                <div class="d-none d-md-flex align-items-center gap-3 text-muted" style="font-size: 11.5px;">
                    <span><i class="fa-solid fa-circle text-success me-1 ms-0" style="font-size: 8px;"></i> @Localizer["ServerOnline"]</span>
                    <span><i class="fa-solid fa-database me-1 ms-0"></i> @Localizer["SqlConnected"]</span>
                </div>
            </div>

            <!-- Main Working Content Area -->
            <div class="erp-content">
                @RenderBody()
            </div>

            <!-- Sticky ERP Footer -->
            <footer class="erp-footer">
                <div>
                    <span><strong>@Localizer["AppName"]</strong> &copy; 2026 – @Localizer["SisterCompany"] Structure</span>
                </div>
                <div class="d-none d-sm-block">
                    <span class="me-3 ms-0"><i class="fa-solid fa-building me-1 ms-0"></i> @CurrentUserContext.CompanyName</span>
                    <span class="me-3 ms-0"><i class="fa-solid fa-code-branch me-1 ms-0"></i> @CurrentUserContext.BranchName</span>
                    <span><i class="fa-solid fa-tag me-1 ms-0"></i> Version 1.0.0</span>
                </div>
            </footer>
        </main>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            var isCollapsed = localStorage.getItem('erp_sidebar_collapsed') === 'true';
            if (isCollapsed && $(window).width() >= 992) {
                $('#erpSidebar').addClass('collapsed');
            }

            $('#sidebarToggleBtn').on('click', function () {
                if ($(window).width() < 992) {
                    $('#erpSidebar').toggleClass('mobile-open');
                    $('#sidebarOverlay').toggleClass('active');
                } else {
                    $('#erpSidebar').toggleClass('collapsed');
                    localStorage.setItem('erp_sidebar_collapsed', $('#erpSidebar').hasClass('collapsed'));
                }
            });

            $('#sidebarOverlay').on('click', function () {
                $('#erpSidebar').removeClass('mobile-open');
                $('#sidebarOverlay').removeClass('active');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
