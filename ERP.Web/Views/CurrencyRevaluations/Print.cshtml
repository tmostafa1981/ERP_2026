@model ERP.Application.DTOs.Revaluation.RevaluationDetailsDto
@using ERP.Domain.Enums
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تقرير إعادة تقييم أرصدة العملات الأجنبية - @Model.RevaluationNumber</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 13px;
            color: #212529;
            background-color: #fff;
        }
        .report-header {
            border-bottom: 2px solid #212529;
            padding-bottom: 12px;
            margin-bottom: 15px;
        }
        .report-title {
            font-size: 19px;
            font-weight: bold;
        }
        .meta-box {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            padding: 10px 14px;
            margin-bottom: 15px;
        }
        table {
            font-size: 12px;
        }
        th {
            background-color: #f1f3f5 !important;
            font-weight: 600;
        }
        @@media print {
            .no-print { display: none !important; }
            body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
</head>
<body class="p-4">
    <div class="no-print d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <div>
            <button onclick="window.print()" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-print me-1"></i> طباعة التقرير
            </button>
            <button onclick="window.close()" class="btn btn-outline-secondary btn-sm ms-2">
                إغلاق النافذة
            </button>
        </div>
        <span class="text-muted small">جاهز للطباعة A4</span>
    </div>

    <!-- Header -->
    <div class="report-header d-flex justify-content-between align-items-center">
        <div>
            <div class="fs-5 fw-bold">@Model.CompanyName</div>
            <div class="text-muted small">الفرع: @Model.BranchName</div>
        </div>
        <div class="text-center">
            <div class="report-title">تقرير إعادة تقييم أرصدة العملات الأجنبية</div>
            <div class="text-muted small">Foreign Currency Revaluation Report</div>
        </div>
        <div class="text-start">
            <div>رقم العملية: <strong>@Model.RevaluationNumber</strong></div>
            <div>تاريخ التقييم: <strong>@Model.RevaluationDate.ToString("yyyy/MM/dd")</strong></div>
        </div>
    </div>

    <!-- Meta Details Box -->
    <div class="meta-box">
        <div class="row g-2">
            <div class="col-3">السنة المالية: <strong>@Model.FiscalYearName</strong></div>
            <div class="col-3">نطاق التقييم: <strong>@Model.ScopeName</strong></div>
            <div class="col-3">العملة: <strong>@Model.CurrencyName</strong></div>
            <div class="col-3">الحالة: <strong>@Model.StatusName</strong></div>

            <div class="col-6">حساب أرباح التقييم: <strong>@Model.UnrealizedGainAccountCode - @Model.UnrealizedGainAccountName</strong></div>
            <div class="col-6">حساب خسائر التقييم: <strong>@Model.UnrealizedLossAccountCode - @Model.UnrealizedLossAccountName</strong></div>

            @if (!string.IsNullOrEmpty(Model.JournalEntryNumber))
            {
                <div class="col-6">رقم قيد اليومية العام: <strong>@Model.JournalEntryNumber</strong></div>
            }
            @if (!string.IsNullOrEmpty(Model.ReversalJournalEntryNumber))
            {
                <div class="col-6">رقم القيد العكسي: <strong>@Model.ReversalJournalEntryNumber (تاريخ: @Model.ReversalDate?.ToString("yyyy/MM/dd"))</strong></div>
            }
        </div>
    </div>

    <!-- Summary Box -->
    <div class="row g-2 mb-3">
        <div class="col-4">
            <div class="p-2 border rounded text-center bg-light">
                <div class="text-muted small">إجمالي أرباح التقييم</div>
                <div class="fw-bold text-success fs-5">+@Model.TotalGain.ToString("N2") ج.م</div>
            </div>
        </div>
        <div class="col-4">
            <div class="p-2 border rounded text-center bg-light">
                <div class="text-muted small">إجمالي خسائر التقييم</div>
                <div class="fw-bold text-danger fs-5">-@Model.TotalLoss.ToString("N2") ج.م</div>
            </div>
        </div>
        <div class="col-4">
            <div class="p-2 border rounded text-center bg-light">
                <div class="text-muted small">صافي فرق التقييم</div>
                <div class="fw-bold @(Model.NetDifference >= 0 ? "text-success" : "text-danger") fs-5">
                    @(Model.NetDifference >= 0 ? "+" : "")@Model.NetDifference.ToString("N2") ج.م
                </div>
            </div>
        </div>
    </div>

    <!-- Lines Table -->
    <table class="table table-bordered table-striped align-middle mb-4">
        <thead>
            <tr>
                <th class="text-center" style="width: 30px;">#</th>
                <th>نوع الحساب</th>
                <th>كود الحساب/الطرف</th>
                <th>الاسم</th>
                <th>الفرع</th>
                <th class="text-center">العملة</th>
                <th class="text-end">الرصيد الأجنبي</th>
                <th class="text-end">القيمة الدفترية</th>
                <th class="text-end">سعر التقييم</th>
                <th class="text-end">القيمة بعد التقييم</th>
                <th class="text-end">فرق التقييم</th>
                <th class="text-center">النوع</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in Model.Lines)
            {
                <tr>
                    <td class="text-center text-muted">@l.LineNumber</td>
                    <td>@l.SourceTypeName</td>
                    <td class="font-monospace">@l.SourceCode</td>
                    <td>@l.SourceName</td>
                    <td>@l.BranchName</td>
                    <td class="text-center">@l.CurrencyCode</td>
                    <td class="text-end font-monospace">@l.ForeignBalance.ToString("N4")</td>
                    <td class="text-end font-monospace">@l.CarryingLocalAmount.ToString("N4")</td>
                    <td class="text-end font-monospace">@l.ExchangeRate.ToString("N6")</td>
                    <td class="text-end font-monospace">@l.RevaluedLocalAmount.ToString("N4")</td>
                    <td class="text-end font-monospace fw-bold @(l.DifferenceType == RevaluationDifferenceType.Gain ? "text-success" : (l.DifferenceType == RevaluationDifferenceType.Loss ? "text-danger" : ""))">
                        @(l.DifferenceType == RevaluationDifferenceType.Gain ? "+" : (l.DifferenceType == RevaluationDifferenceType.Loss ? "-" : ""))@l.DifferenceAmount.ToString("N4")
                    </td>
                    <td class="text-center">
                        @(l.DifferenceType == RevaluationDifferenceType.Gain ? "ربح" : (l.DifferenceType == RevaluationDifferenceType.Loss ? "خسارة" : "—"))
                    </td>
                </tr>
            }
        </tbody>
        <tfoot class="table-light fw-bold">
            <tr>
                <td colspan="6" class="text-end">الإجمالي:</td>
                <td colspan="4"></td>
                <td class="text-end font-monospace @(Model.NetDifference >= 0 ? "text-success" : "text-danger")">
                    @(Model.NetDifference >= 0 ? "+" : "")@Model.NetDifference.ToString("N2")
                </td>
                <td class="text-center">
                    @(Model.NetDifference >= 0 ? "صافي ربح" : "صافي خسارة")
                </td>
            </tr>
        </tfoot>
    </table>

    <!-- Signatures -->
    <div class="row text-center mt-5 pt-3">
        <div class="col-4">
            <div class="fw-bold mb-4">المحاسب المسؤول</div>
            <div class="border-top pt-2 mx-4 text-muted small">التوقيع</div>
        </div>
        <div class="col-4">
            <div class="fw-bold mb-4">المراجع الداخلي</div>
            <div class="border-top pt-2 mx-4 text-muted small">التوقيع</div>
        </div>
        <div class="col-4">
            <div class="fw-bold mb-4">المدير المالي</div>
            <div class="border-top pt-2 mx-4 text-muted small">الاعتماد</div>
        </div>
    </div>
</body>
</html>
