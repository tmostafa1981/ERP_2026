@model ERP.Application.DTOs.Reports.SerialNumbersReportDto
@{
    ViewData["Title"] = "تقرير الأرقام المسلسلة وحركتها";
    Layout = "_Layout";
    bool isRequested = ViewBag.IsRequested == true;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom d-print-none">
        <div>
            <h4 class="fw-bold mb-1 text-primary">
                <i class="fa-solid fa-barcode me-2"></i>تقرير الأرقام المسلسلة وحالتها وموقعها وسجل حركتها
            </h4>
            <span class="text-muted small">تتبع دورة حياة السيريال الكاملة من الاستلام إلى الصرف أو البيع والتحويل</span>
        </div>
        <div class="d-flex gap-2">
            @if (isRequested)
            {
                if (CurrentUserContext.HasPermission("Reports.InventoryReports.Print,Reports.GeneralReports.Print"))
                {
                    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm fw-bold">
                        <i class="fa-solid fa-print me-1"></i> طباعة
                    </button>
                }
            }
            <a asp-action="Index" class="btn btn-outline-primary btn-sm fw-bold">
                <i class="fa-solid fa-arrow-right me-1"></i> فهرس تقارير المخازن
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4 d-print-none">
        <div class="card-body p-3 bg-light rounded">
            <form method="get" asp-action="SerialNumbers">
                <input type="hidden" name="submitted" value="true" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">الفرع</label>
                        <select name="BranchId" id="branchSelect" class="form-select form-select-sm" asp-items="ViewBag.Branches">
                            <option value="">-- كل الفروع --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">المستودع</label>
                        <select name="WarehouseId" id="warehouseSelect" class="form-select form-select-sm" asp-items="ViewBag.Warehouses">
                            <option value="">-- كل المستودعات --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">الصنف</label>
                        <div class="erp-lookup-picker" 
                             data-type="item" 
                             data-input-name="ItemId" 
                             data-value="@Model.Filter.ItemId" 
                             data-text="@ViewBag.SelectedItemDisplay"
                             data-placeholder="-- كافة الأصناف (كود / اسم / باركود) --"
                             data-warehouse-selector="#warehouseSelect"
                             data-extra-filters='{"inventoryOnly": true}'>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">الرقم المسلسل (بحث جزئي)</label>
                        <input type="text" name="SerialNumber" class="form-control form-control-sm font-monospace" value="@Model.Filter.SerialNumber" placeholder="اكتب السيريال..." />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                            <i class="fa-solid fa-filter me-1"></i> بحث السيريالات
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!isRequested)
    {
        <div class="card border-0 shadow-sm p-5 text-center my-4 bg-white rounded-3">
            <div class="text-primary mb-3">
                <i class="fa-solid fa-barcode fa-3x"></i>
            </div>
            <h5 class="fw-bold text-dark">يرجى تحديد معايير البحث والضغط على "بحث السيريالات"</h5>
            <p class="text-muted small mb-0">ابحث بالرقم المسلسل أو الفرع أو الصنف لتتبع دورة حياة الأرقام المسلسلة وسجل حركاتها.</p>
        </div>
    }
    else
    {
        <!-- Data List -->
        @if (!Model.Items.Any())
        {
            <div class="alert alert-info text-center py-4">
                لا توجد أرقام مسلسلة مطابقة لمعايير البحث.
            </div>
        }
        else
        {
            <div class="accordion" id="serialsAccordion">
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    var s = Model.Items[i];
                    <div class="accordion-item mb-2 border rounded shadow-sm">
                        <h2 class="accordion-header" id="heading_@s.SerialId">
                            <button class="accordion-button @(i == 0 ? "" : "collapsed") py-2" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@s.SerialId" aria-expanded="@(i == 0 ? "true" : "false")">
                                <div class="d-flex justify-content-between align-items-center w-100 pe-3 flex-wrap gap-2">
                                    <div>
                                        <i class="fa-solid fa-barcode text-primary me-2"></i>
                                        <strong class="font-monospace fs-6 text-primary me-3">@s.SerialNumber</strong>
                                        <span class="fw-bold text-dark me-2">@s.ItemName (@s.ItemCode)</span>
                                    </div>
                                    <div class="d-flex gap-2 align-items-center small">
                                        <span class="badge bg-light text-dark border">@s.BranchName - @s.WarehouseName</span>
                                        <span class="badge @(s.CurrentStatus == "متاح بالمخزن" ? "bg-success" : "bg-secondary")">@s.CurrentStatus</span>
                                        @if (!string.IsNullOrEmpty(s.CurrentPartyName))
                                        {
                                            <span class="badge bg-info-subtle text-info border">الطرف: @s.CurrentPartyName</span>
                                        }
                                    </div>
                                </div>
                            </button>
                        </h2>
                        <div id="collapse_@s.SerialId" class="accordion-collapse collapse @(i == 0 ? "show" : "")" data-bs-parent="#serialsAccordion">
                            <div class="accordion-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered mb-0 align-middle text-center" style="font-size: 0.8rem;">
                                        <thead class="table-light">
                                            <tr>
                                                <th>التاريخ</th>
                                                <th>نوع الحركة</th>
                                                <th>نوع المستند</th>
                                                <th>رقم المستند</th>
                                                <th>الطرف</th>
                                                <th>الحالة الناتجة</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!s.Movements.Any())
                                            {
                                                <tr>
                                                    <td colspan="6" class="text-muted py-2">لا توجد حركات مسجلة في الأرشيف لهذا السيريال.</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var m in s.Movements)
                                                {
                                                    <tr>
                                                        <td class="font-monospace">@m.Date.ToString("yyyy/MM/dd HH:mm")</td>
                                                        <td><span class="badge bg-light text-primary border">@m.MovementType</span></td>
                                                        <td>@m.DocumentType</td>
                                                        <td class="font-monospace fw-bold">@m.DocumentNumber</td>
                                                        <td>@m.PartyName</td>
                                                        <td><span class="badge bg-secondary-subtle text-dark border">@m.StatusAfter</span></td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<script>
    document.getElementById('branchSelect')?.addEventListener('change', function() {
        var branchId = this.value;
        var whSelect = document.getElementById('warehouseSelect');
        if (whSelect) {
            fetch('@Url.Action("GetWarehousesByBranch", "InventoryReports")?branchId=' + branchId)
                .then(r => r.json())
                .then(data => {
                    whSelect.innerHTML = '<option value="">-- كل المستودعات --</option>';
                    data.forEach(item => {
                        var opt = document.createElement('option');
                        opt.value = item.id;
                        opt.textContent = item.text;
                        whSelect.appendChild(opt);
                    });
                });
        }
    });
</script>
