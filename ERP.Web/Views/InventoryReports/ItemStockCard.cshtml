@model ERP.Application.DTOs.Reports.ItemStockCardReportDto
@{
    ViewData["Title"] = "كارت الصنف التفصيلي";
    Layout = "_Layout";
    bool isRequested = ViewBag.IsRequested == true && Model.ItemId > 0;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom d-print-none">
        <div>
            <h4 class="fw-bold mb-1 text-primary">
                <i class="fa-solid fa-address-card me-2"></i>كارت الصنف التفصيلي (Item Stock Card)
            </h4>
            <span class="text-muted small">عرض التاريخ، رقم المستند، نوع الحركة، الفرع، المستودع، الكمية الواردة والمنصرفة، والرصيد التراكمي بعد كل حركة</span>
        </div>
        <div class="d-flex gap-2">
            @if (isRequested)
            {
                if (CurrentUserContext.HasPermission("Reports.InventoryReports.Print,Reports.GeneralReports.Print"))
                {
                    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm fw-bold">
                        <i class="fa-solid fa-print me-1"></i> طباعة كارت الصنف
                    </button>
                }
                if (CurrentUserContext.HasPermission("Reports.InventoryReports.Export,Reports.GeneralReports.Export"))
                {
                    <button onclick="exportTableToExcel('itemStockCardTable', 'ItemStockCard_@Model.ItemCode')" class="btn btn-outline-success btn-sm fw-bold">
                        <i class="fa-solid fa-file-excel me-1"></i> تصدير Excel
                    </button>
                }
            }
            <a asp-action="Index" class="btn btn-outline-primary btn-sm fw-bold">
                <i class="fa-solid fa-arrow-right me-1"></i> فهرس تقارير المخازن
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4 d-print-none">
        <div class="card-body p-3 bg-light rounded">
            <form method="get" asp-action="ItemStockCard">
                <input type="hidden" name="submitted" value="true" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">الصنف <span class="text-danger">*</span></label>
                        <div class="erp-lookup-picker" 
                             data-type="item" 
                             data-input-name="ItemId" 
                             data-value="@Model.Filter.ItemId" 
                             data-text="@ViewBag.SelectedItemDisplay"
                             data-placeholder="-- اختر الصنف (كود / اسم / باركود) --"
                             data-warehouse-selector="#warehouseSelect"
                             data-extra-filters='{"inventoryOnly": true}'>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">الفرع</label>
                        <select name="BranchId" id="branchSelect" class="form-select form-select-sm" asp-items="ViewBag.Branches">
                            <option value="">-- كل الفروع --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">المستودع</label>
                        <select name="WarehouseId" id="warehouseSelect" class="form-select form-select-sm" asp-items="ViewBag.Warehouses">
                            <option value="">-- كل المستودعات --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">من تاريخ</label>
                        <input type="date" name="DateFrom" class="form-control form-control-sm" value="@(Model.Filter.DateFrom?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">إلى تاريخ</label>
                        <input type="date" name="DateTo" class="form-control form-control-sm" value="@(Model.Filter.DateTo?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                            <i class="fa-solid fa-filter"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!isRequested)
    {
        <div class="card border-0 shadow-sm p-5 text-center my-4 bg-white rounded-3">
            <div class="text-primary mb-3">
                <i class="fa-solid fa-address-card fa-3x"></i>
            </div>
            <h5 class="fw-bold text-dark">يرجى اختيار الصنف ومعايير البحث والضغط على زر العرض</h5>
            <p class="text-muted small mb-0">اختر الصنف والفرع والمستودع والفترة الزمنية لعرض كارت الصنف التفصيلي وتتبع الرصيد التراكمي بعد كل حركة وارد ومنصرف.</p>
        </div>
    }
    else
    {
        <!-- Item Header Badge Strip -->
        <div class="card shadow-sm border-0 mb-3 bg-light">
            <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <span class="badge bg-primary font-monospace fs-6 me-2">@Model.ItemCode</span>
                    <strong class="fs-5 text-dark">@Model.ItemName</strong>
                    <span class="badge bg-secondary ms-2">الوحدة: @Model.UnitName</span>
                </div>
                <div class="d-flex gap-3 text-center">
                    <div class="px-2">
                        <span class="small text-muted d-block">رصيد أول المدة</span>
                        <strong class="font-monospace fs-6">@Model.OpeningBalance.ToString("G29")</strong>
                    </div>
                    <div class="border-start ps-3">
                        <span class="small text-muted d-block">إجمالي الوارد (+)</span>
                        <strong class="font-monospace fs-6 text-success">+@Model.TotalIn.ToString("G29")</strong>
                    </div>
                    <div class="border-start ps-3">
                        <span class="small text-muted d-block">إجمالي المنصرف (-)</span>
                        <strong class="font-monospace fs-6 text-danger">-@Model.TotalOut.ToString("G29")</strong>
                    </div>
                    <div class="border-start ps-3">
                        <span class="small text-muted d-block">الرصيد الحالي الناتج</span>
                        <strong class="font-monospace fs-5 text-primary">@Model.CurrentBalance.ToString("G29")</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ledger Table -->
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="itemStockCardTable" class="table table-bordered table-hover align-middle mb-0 text-center" style="font-size: 0.85rem;">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>التاريخ</th>
                                <th>رقم المستند</th>
                                <th>نوع الحركة</th>
                                <th>الفرع</th>
                                <th>المستودع</th>
                                <th class="text-start">الطرف (عميل/مورد)</th>
                                <th class="text-success">وارد (+)</th>
                                <th class="text-danger">منصرف (-)</th>
                                <th class="table-primary text-primary-emphasis fw-bold">الرصيد الناتج</th>
                                <th class="text-start">ملاحظات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Opening Balance Row -->
                            <tr class="table-light fw-bold">
                                <td>-</td>
                                <td>-</td>
                                <td colspan="5" class="text-start text-muted">
                                    <i class="fa-solid fa-flag me-1 text-primary"></i> رصيد ما قبل الفترة (Opening Balance)
                                </td>
                                <td>-</td>
                                <td>-</td>
                                <td class="font-monospace text-primary fs-6">@Model.OpeningBalance.ToString("G29")</td>
                                <td>-</td>
                            </tr>

                            @if (!Model.Movements.Any())
                            {
                                <tr>
                                    <td colspan="11" class="py-4 text-muted">لا توجد حركات مخزنية مسجلة لهذا الصنف خلال الفترة المحددة.</td>
                                </tr>
                            }
                            else
                            {
                                @for (int i = 0; i < Model.Movements.Count; i++)
                                {
                                    var m = Model.Movements[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td class="font-monospace">@m.Date.ToString("yyyy/MM/dd")</td>
                                        <td class="font-monospace fw-bold text-primary">@m.DocumentNumber</td>
                                        <td><span class="badge bg-light text-dark border">@m.TransactionTypeName</span></td>
                                        <td>@m.BranchName</td>
                                        <td>@m.WarehouseName</td>
                                        <td class="text-start">@m.PartyName</td>
                                        <td class="font-monospace text-success fw-bold">
                                            @(m.InQuantity > 0 ? "+" + m.InQuantity.ToString("G29") : "-")
                                        </td>
                                        <td class="font-monospace text-danger fw-bold">
                                            @(m.OutQuantity > 0 ? "-" + m.OutQuantity.ToString("G29") : "-")
                                        </td>
                                        <td class="font-monospace fw-bold table-primary text-primary fs-6">
                                            @m.BalanceAfter.ToString("G29")
                                        </td>
                                        <td class="text-start small text-muted">@m.Notes</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="7" class="text-center">إجمالي الحركات</td>
                                <td class="font-monospace text-success fs-6">+@Model.TotalIn.ToString("G29")</td>
                                <td class="font-monospace text-danger fs-6">-@Model.TotalOut.ToString("G29")</td>
                                <td class="font-monospace table-primary text-primary fs-5">@Model.CurrentBalance.ToString("G29")</td>
                                <td>-</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<script>
    function exportTableToExcel(tableId, filename) {
        var table = document.getElementById(tableId);
        if (!table) return;
        var html = table.outerHTML;
        var blob = new Blob(['\ufeff' + html], { type: 'application/vnd.ms-excel;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename + '_' + new Date().toISOString().slice(0, 10) + '.xls';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }

    document.getElementById('branchSelect')?.addEventListener('change', function() {
        var branchId = this.value;
        var whSelect = document.getElementById('warehouseSelect');
        if (whSelect) {
            fetch('@Url.Action("GetWarehousesByBranch", "InventoryReports")?branchId=' + branchId)
                .then(r => r.json())
                .then(data => {
                    whSelect.innerHTML = '<option value="">-- كل المستودعات --</option>';
                    data.forEach(item => {
                        var opt = document.createElement('option');
                        opt.value = item.id;
                        opt.textContent = item.text;
                        whSelect.appendChild(opt);
                    });
                });
        }
    });
</script>
