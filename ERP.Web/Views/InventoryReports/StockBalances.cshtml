@model ERP.Application.DTOs.Reports.StockBalanceReportDto
@{
    ViewData["Title"] = "أرصدة الأصناف بالمخازن";
    Layout = "_Layout";
    bool isRequested = ViewBag.IsRequested == true;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom d-print-none">
        <div>
            <h4 class="fw-bold mb-1 text-primary">
                <i class="fa-solid fa-layer-group me-2"></i>أرصدة الأصناف حسب الفرع والمخزن والصنف
            </h4>
            <span class="text-muted small">الرصيد الفعلي الحالي، الكميات المحجوزة، المتاح للبيع، والقيمة التقديرية</span>
        </div>
        <div class="d-flex gap-2">
            @if (isRequested)
            {
                if (CurrentUserContext.HasPermission("Reports.InventoryReports.Print,Reports.GeneralReports.Print"))
                {
                    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm fw-bold">
                        <i class="fa-solid fa-print me-1"></i> طباعة
                    </button>
                }
                if (CurrentUserContext.HasPermission("Reports.InventoryReports.Export,Reports.GeneralReports.Export"))
                {
                    <button onclick="exportTableToExcel('stockBalancesTable', 'StockBalances')" class="btn btn-outline-success btn-sm fw-bold">
                        <i class="fa-solid fa-file-excel me-1"></i> تصدير Excel
                    </button>
                }
            }
            <a asp-action="Index" class="btn btn-outline-primary btn-sm fw-bold">
                <i class="fa-solid fa-arrow-right me-1"></i> فهرس تقارير المخازن
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4 d-print-none">
        <div class="card-body p-3 bg-light rounded">
            <form method="get" asp-action="StockBalances">
                <input type="hidden" name="submitted" value="true" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">الفرع</label>
                        <select name="BranchId" id="branchSelect" class="form-select form-select-sm" asp-items="ViewBag.Branches">
                            <option value="">-- كل الفروع --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">المستودع</label>
                        <select name="WarehouseId" id="warehouseSelect" class="form-select form-select-sm" asp-items="ViewBag.Warehouses">
                            <option value="">-- كل المستودعات --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">المجموعة</label>
                        <select name="ItemGroupId" class="form-select form-select-sm" asp-items="ViewBag.ItemGroups">
                            <option value="">-- كل المجموعات --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">الصنف</label>
                        <div class="erp-lookup-picker" 
                             data-type="item" 
                             data-input-name="ItemId" 
                             data-value="@Model.Filter.ItemId" 
                             data-text="@ViewBag.SelectedItemDisplay"
                             data-placeholder="-- كافة الأصناف (كود / اسم / باركود) --"
                             data-warehouse-selector="#warehouseSelect"
                             data-extra-filters='{"inventoryOnly": true}'>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                            <i class="fa-solid fa-filter me-1"></i> عرض الأرصدة
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!isRequested)
    {
        <div class="card border-0 shadow-sm p-5 text-center my-4 bg-white rounded-3">
            <div class="text-primary mb-3">
                <i class="fa-solid fa-layer-group fa-3x"></i>
            </div>
            <h5 class="fw-bold text-dark">يرجى تحديد معايير البحث والضغط على "عرض الأرصدة"</h5>
            <p class="text-muted small mb-0">اختر الفرع والمستودع والصنف لعرض الأرصدة الفعلية والمحجوزة والمتاحة للبيع.</p>
        </div>
    }
    else
    {
        <!-- Summary KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-primary bg-opacity-10 text-primary p-3">
                    <span class="small fw-bold">إجمالي الرصيد الفعلي الحالي</span>
                    <h4 class="fw-bold mb-0 mt-1 font-monospace">@Model.TotalOnHandQuantity.ToString("G29")</h4>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-success bg-opacity-10 text-success p-3">
                    <span class="small fw-bold">إجمالي المتاح للبيع الفعلي</span>
                    <h4 class="fw-bold mb-0 mt-1 font-monospace">@Model.TotalAvailableQuantity.ToString("G29")</h4>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-info bg-opacity-10 text-info p-3">
                    <span class="small fw-bold">القيمة التقديرية للمخزون (EGP)</span>
                    <h4 class="fw-bold mb-0 mt-1 font-monospace">@Model.TotalEstimatedValue.ToString("N2")</h4>
                </div>
            </div>
        </div>

        <!-- Data Table -->
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="stockBalancesTable" class="table table-bordered table-hover table-striped align-middle mb-0 text-center" style="font-size: 0.85rem;">
                        <thead class="table-dark">
                            <tr>
                                <th>الفرع</th>
                                <th>المستودع</th>
                                <th>كود الصنف</th>
                                <th class="text-start">اسم الصنف</th>
                                <th>المجموعة</th>
                                <th>الوحدة</th>
                                <th>الرصيد الفعلي</th>
                                <th>المحجوز</th>
                                <th class="table-success text-success-emphasis fw-bold">المتاح للبيع</th>
                                <th>سعر الشراء</th>
                                <th class="table-info text-info-emphasis fw-bold">القيمة التقديرية</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Items.Any())
                            {
                                <tr>
                                    <td colspan="11" class="py-4 text-muted">لا توجد أصناف أو أرصدة مطابقة للبحث.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in Model.Items)
                                {
                                    <tr>
                                        <td>@row.BranchName</td>
                                        <td>@row.WarehouseName</td>
                                        <td class="font-monospace text-primary fw-bold">@row.ItemCode</td>
                                        <td class="text-start fw-bold">@row.ItemName</td>
                                        <td><span class="badge bg-light text-dark border">@row.GroupName</span></td>
                                        <td>@row.UnitName</td>
                                        <td class="font-monospace fw-bold">@row.OnHandQuantity.ToString("G29")</td>
                                        <td class="font-monospace text-warning fw-bold">@row.ReservedQuantity.ToString("G29")</td>
                                        <td class="font-monospace fw-bold text-success table-success">@row.AvailableQuantity.ToString("G29")</td>
                                        <td class="font-monospace text-end">@row.PurchasePrice.ToString("N2")</td>
                                        <td class="font-monospace text-end fw-bold text-info table-info">@row.EstimatedValue.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="6" class="text-center">الإجمالي</td>
                                <td class="font-monospace">@Model.TotalOnHandQuantity.ToString("G29")</td>
                                <td class="font-monospace text-warning">@Model.Items.Sum(x => x.ReservedQuantity).ToString("G29")</td>
                                <td class="font-monospace text-success table-success">@Model.TotalAvailableQuantity.ToString("G29")</td>
                                <td>-</td>
                                <td class="font-monospace text-end text-info table-info fs-6">@Model.TotalEstimatedValue.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<script>
    function exportTableToExcel(tableId, filename) {
        var table = document.getElementById(tableId);
        if (!table) return;
        var html = table.outerHTML;
        var blob = new Blob(['\ufeff' + html], { type: 'application/vnd.ms-excel;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename + '_' + new Date().toISOString().slice(0, 10) + '.xls';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }

    document.getElementById('branchSelect')?.addEventListener('change', function() {
        var branchId = this.value;
        var whSelect = document.getElementById('warehouseSelect');
        if (whSelect) {
            fetch('@Url.Action("GetWarehousesByBranch", "InventoryReports")?branchId=' + branchId)
                .then(r => r.json())
                .then(data => {
                    whSelect.innerHTML = '<option value="">-- كل المستودعات --</option>';
                    data.forEach(item => {
                        var opt = document.createElement('option');
                        opt.value = item.id;
                        opt.textContent = item.text;
                        whSelect.appendChild(opt);
                    });
                });
        }
    });
</script>
