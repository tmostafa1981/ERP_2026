@model ERP.Application.DTOs.Reports.ReturnsAndAdjustmentsReportDto
@{
    ViewData["Title"] = "تقرير المرتجعات والتسويات المخزنية";
    Layout = "_Layout";
    bool isRequested = ViewBag.IsRequested == true;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom d-print-none">
        <div>
            <h4 class="fw-bold mb-1 text-primary">
                <i class="fa-solid fa-sliders me-2"></i>تقرير المرتجعات والتسويات المخزنية
            </h4>
            <span class="text-muted small">حصر تسويات الجرد، الفروقات، المرتجعات، وتأثيراتها الكمية والمالية</span>
        </div>
        <div class="d-flex gap-2">
            @if (isRequested)
            {
                if (CurrentUserContext.HasPermission("Reports.InventoryReports.Print,Reports.GeneralReports.Print"))
                {
                    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm fw-bold">
                        <i class="fa-solid fa-print me-1"></i> طباعة
                    </button>
                }
                if (CurrentUserContext.HasPermission("Reports.InventoryReports.Export,Reports.GeneralReports.Export"))
                {
                    <button onclick="exportTableToExcel('returnsAndAdjustmentsTable', 'ReturnsAndAdjustments')" class="btn btn-outline-success btn-sm fw-bold">
                        <i class="fa-solid fa-file-excel me-1"></i> تصدير Excel
                    </button>
                }
            }
            <a asp-action="Index" class="btn btn-outline-primary btn-sm fw-bold">
                <i class="fa-solid fa-arrow-right me-1"></i> فهرس تقارير المخازن
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4 d-print-none">
        <div class="card-body p-3 bg-light rounded">
            <form method="get" asp-action="ReturnsAndAdjustments">
                <input type="hidden" name="submitted" value="true" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">الفرع</label>
                        <select name="BranchId" id="branchSelect" class="form-select form-select-sm" asp-items="ViewBag.Branches">
                            <option value="">-- كل الفروع --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">المستودع</label>
                        <select name="WarehouseId" id="warehouseSelect" class="form-select form-select-sm" asp-items="ViewBag.Warehouses">
                            <option value="">-- كل المستودعات --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">من تاريخ</label>
                        <input type="date" name="DateFrom" class="form-control form-control-sm" value="@(Model.Filter.DateFrom?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">إلى تاريخ</label>
                        <input type="date" name="DateTo" class="form-control form-control-sm" value="@(Model.Filter.DateTo?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                            <i class="fa-solid fa-filter me-1"></i> عرض التقرير
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!isRequested)
    {
        <div class="card border-0 shadow-sm p-5 text-center my-4 bg-white rounded-3">
            <div class="text-primary mb-3">
                <i class="fa-solid fa-sliders fa-3x"></i>
            </div>
            <h5 class="fw-bold text-dark">يرجى تحديد معايير البحث والضغط على "عرض التقرير"</h5>
            <p class="text-muted small mb-0">اختر الفرع والمستودع والفترة الزمنية لعرض تسويات الجرد المخزني والمرتجعات.</p>
        </div>
    }
    else
    {
        <!-- Summary KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm bg-primary bg-opacity-10 text-primary p-3 text-center">
                    <span class="small fw-bold">إجمالي كمية التسويات والمرتجعات</span>
                    <h4 class="fw-bold mb-0 mt-1 font-monospace">@Model.TotalQuantity.ToString("G29")</h4>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm bg-info bg-opacity-10 text-info p-3 text-center">
                    <span class="small fw-bold">إجمالي القيمة التقديرية (EGP)</span>
                    <h4 class="fw-bold mb-0 mt-1 font-monospace">@Model.TotalValue.ToString("N2")</h4>
                </div>
            </div>
        </div>

        <!-- Data Table -->
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="returnsAndAdjustmentsTable" class="table table-bordered table-hover table-striped align-middle mb-0 text-center" style="font-size: 0.85rem;">
                        <thead class="table-dark">
                            <tr>
                                <th>رقم المستند</th>
                                <th>التاريخ</th>
                                <th>نوع الحركة</th>
                                <th>المستودع</th>
                                <th>كود الصنف</th>
                                <th class="text-start">اسم الصنف</th>
                                <th>الكمية</th>
                                <th>السعر</th>
                                <th>الإجمالي</th>
                                <th class="text-start">ملاحظات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Items.Any())
                            {
                                <tr>
                                    <td colspan="10" class="py-4 text-muted">لا توجد تسويات أو مرتجعات مسجلة في الفترة.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in Model.Items)
                                {
                                    <tr>
                                        <td class="font-monospace text-primary fw-bold">@row.DocumentNumber</td>
                                        <td class="font-monospace">@row.DocumentDate.ToString("yyyy/MM/dd")</td>
                                        <td><span class="badge bg-warning-subtle text-dark border">@row.MovementType</span></td>
                                        <td>@row.WarehouseName</td>
                                        <td class="font-monospace text-muted">@row.ItemCode</td>
                                        <td class="text-start fw-bold">@row.ItemName</td>
                                        <td class="font-monospace fw-bold text-primary">@row.Quantity.ToString("G29")</td>
                                        <td class="font-monospace text-end">@row.UnitPrice.ToString("N2")</td>
                                        <td class="font-monospace text-end fw-bold">@row.TotalValue.ToString("N2")</td>
                                        <td class="text-start small text-muted">@row.Notes</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="6" class="text-center">الإجمالي</td>
                                <td class="font-monospace text-primary">@Model.TotalQuantity.ToString("G29")</td>
                                <td>-</td>
                                <td class="font-monospace text-end fs-6">@Model.TotalValue.ToString("N2")</td>
                                <td>-</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<script>
    function exportTableToExcel(tableId, filename) {
        var table = document.getElementById(tableId);
        if (!table) return;
        var html = table.outerHTML;
        var blob = new Blob(['\ufeff' + html], { type: 'application/vnd.ms-excel;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename + '_' + new Date().toISOString().slice(0, 10) + '.xls';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }

    document.getElementById('branchSelect')?.addEventListener('change', function() {
        var branchId = this.value;
        var whSelect = document.getElementById('warehouseSelect');
        if (whSelect) {
            fetch('@Url.Action("GetWarehousesByBranch", "InventoryReports")?branchId=' + branchId)
                .then(r => r.json())
                .then(data => {
                    whSelect.innerHTML = '<option value="">-- كل المستودعات --</option>';
                    data.forEach(item => {
                        var opt = document.createElement('option');
                        opt.value = item.id;
                        opt.textContent = item.text;
                        whSelect.appendChild(opt);
                    });
                });
        }
    });
</script>
