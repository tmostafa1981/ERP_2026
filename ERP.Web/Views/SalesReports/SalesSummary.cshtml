@model ERP.Application.DTOs.Reports.SalesSummaryReportDto
@{
    ViewData["Title"] = "ملخص المبيعات حسب الفترة والفرع";
    Layout = "_Layout";
    bool isRequested = ViewBag.IsRequested == true;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom d-print-none">
        <div>
            <h4 class="fw-bold mb-1 text-primary">
                <i class="fa-solid fa-calendar-days me-2"></i>ملخص المبيعات حسب الفترة والفرع
            </h4>
            <span class="text-muted small">تقرير تجميعي للمبيعات، الخصومات، الضرائب، المرتجعات، وصافي الإيرادات</span>
        </div>
        <div class="d-flex gap-2">
            @if (isRequested)
            {
                if (CurrentUserContext.HasPermission("Reports.SalesReports.Print,Reports.GeneralReports.Print"))
                {
                    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm fw-bold">
                        <i class="fa-solid fa-print me-1"></i> طباعة
                    </button>
                }
                if (CurrentUserContext.HasPermission("Reports.SalesReports.Export,Reports.GeneralReports.Export"))
                {
                    <button onclick="exportTableToExcel('salesSummaryTable', 'SalesSummary')" class="btn btn-outline-success btn-sm fw-bold">
                        <i class="fa-solid fa-file-excel me-1"></i> تصدير Excel
                    </button>
                }
            }
            <a asp-action="Index" class="btn btn-outline-primary btn-sm fw-bold">
                <i class="fa-solid fa-arrow-right me-1"></i> فهرس تقارير المبيعات
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4 d-print-none">
        <div class="card-body p-3 bg-light rounded">
            <form method="get" asp-action="SalesSummary">
                <input type="hidden" name="submitted" value="true" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">الفرع</label>
                        <select name="BranchId" id="branchSelect" class="form-select form-select-sm" asp-items="ViewBag.Branches">
                            <option value="">-- كل الفروع المتاحة --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">المستودع</label>
                        <select name="WarehouseId" id="warehouseSelect" class="form-select form-select-sm" asp-items="ViewBag.Warehouses">
                            <option value="">-- كل المستودعات --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">من تاريخ</label>
                        <input type="date" name="DateFrom" class="form-control form-control-sm" value="@(Model.Filter.DateFrom?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">إلى تاريخ</label>
                        <input type="date" name="DateTo" class="form-control form-control-sm" value="@(Model.Filter.DateTo?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                            <i class="fa-solid fa-filter me-1"></i> عرض التقرير
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!isRequested)
    {
        <div class="card border-0 shadow-sm p-5 text-center my-4 bg-white rounded-3">
            <div class="text-primary mb-3">
                <i class="fa-solid fa-calendar-days fa-3x"></i>
            </div>
            <h5 class="fw-bold text-dark">يرجى تحديد معايير البحث والضغط على "عرض التقرير"</h5>
            <p class="text-muted small mb-0">اختر الفرع والمستودع والفترة الزمنية لعرض ملخص المبيعات والإيرادات.</p>
        </div>
    }
    else
    {
        <!-- Summary KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-primary bg-opacity-10 text-primary p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small fw-bold">إجمالي المبيعات الصافية</span>
                            <h4 class="fw-bold mb-0 mt-1 font-monospace">@Model.GrandTotalSales.ToString("N2")</h4>
                        </div>
                        <i class="fa-solid fa-sack-dollar fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-danger bg-opacity-10 text-danger p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small fw-bold">إجمالي المرتجعات</span>
                            <h4 class="fw-bold mb-0 mt-1 font-monospace">@Model.GrandTotalReturns.ToString("N2")</h4>
                        </div>
                        <i class="fa-solid fa-rotate-left fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-success bg-opacity-10 text-success p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small fw-bold">صافي إيرادات المبيعات</span>
                            <h4 class="fw-bold mb-0 mt-1 font-monospace">@Model.GrandNetRevenue.ToString("N2")</h4>
                        </div>
                        <i class="fa-solid fa-chart-line fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Data Table -->
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="salesSummaryTable" class="table table-bordered table-hover table-striped align-middle mb-0 text-center" style="font-size: 0.85rem;">
                        <thead class="table-dark">
                            <tr>
                                <th>الفرع</th>
                                <th>الفترة</th>
                                <th>عدد الفواتير</th>
                                <th>الإجمالي قبل الضريبة</th>
                                <th>الخصومات</th>
                                <th>الضرائب</th>
                                <th>إجمالي المبيعات</th>
                                <th>عدد المرتجعات</th>
                                <th>قيمة المرتجعات</th>
                                <th class="table-success text-success-emphasis fw-bold">صافي الإيراد</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Items.Any())
                            {
                                <tr>
                                    <td colspan="10" class="py-4 text-muted">لا توجد بيانات مبيعات مطابقة لمعايير البحث المحددة.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in Model.Items)
                                {
                                    <tr>
                                        <td class="fw-bold">@row.BranchName</td>
                                        <td class="font-monospace">@row.Period</td>
                                        <td><span class="badge bg-light text-dark border">@row.InvoiceCount</span></td>
                                        <td class="font-monospace text-end">@row.TotalBeforeTax.ToString("N2")</td>
                                        <td class="font-monospace text-end text-danger">@row.TotalDiscounts.ToString("N2")</td>
                                        <td class="font-monospace text-end">@row.TotalTax.ToString("N2")</td>
                                        <td class="font-monospace text-end fw-bold text-primary">@row.TotalNetSales.ToString("N2")</td>
                                        <td><span class="badge bg-danger-subtle text-danger border">@row.ReturnCount</span></td>
                                        <td class="font-monospace text-end text-danger fw-bold">@row.TotalReturns.ToString("N2")</td>
                                        <td class="font-monospace text-end fw-bold text-success bg-success-subtle">@row.NetRevenue.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="3" class="text-center">الإجمالي العام</td>
                                <td class="font-monospace text-end">@Model.Items.Sum(x => x.TotalBeforeTax).ToString("N2")</td>
                                <td class="font-monospace text-end text-danger">@Model.Items.Sum(x => x.TotalDiscounts).ToString("N2")</td>
                                <td class="font-monospace text-end">@Model.Items.Sum(x => x.TotalTax).ToString("N2")</td>
                                <td class="font-monospace text-end text-primary">@Model.GrandTotalSales.ToString("N2")</td>
                                <td class="text-center">@Model.Items.Sum(x => x.ReturnCount)</td>
                                <td class="font-monospace text-end text-danger">@Model.GrandTotalReturns.ToString("N2")</td>
                                <td class="font-monospace text-end text-success bg-success-subtle fs-6">@Model.GrandNetRevenue.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<script>
    function exportTableToExcel(tableId, filename) {
        var table = document.getElementById(tableId);
        if (!table) return;
        var html = table.outerHTML;
        var blob = new Blob(['\ufeff' + html], { type: 'application/vnd.ms-excel;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename + '_' + new Date().toISOString().slice(0, 10) + '.xls';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }

    document.getElementById('branchSelect')?.addEventListener('change', function() {
        var branchId = this.value;
        var whSelect = document.getElementById('warehouseSelect');
        if (whSelect) {
            fetch('@Url.Action("GetWarehousesByBranch", "SalesReports")?branchId=' + branchId)
                .then(r => r.json())
                .then(data => {
                    whSelect.innerHTML = '<option value="">-- كل المستودعات --</option>';
                    data.forEach(item => {
                        var opt = document.createElement('option');
                        opt.value = item.id;
                        opt.textContent = item.text;
                        whSelect.appendChild(opt);
                    });
                });
        }
    });
</script>
