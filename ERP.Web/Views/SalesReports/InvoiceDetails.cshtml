@model ERP.Application.DTOs.Reports.SalesInvoiceDetailReportDto
@{
    ViewData["Title"] = "تقرير تفصيلي لفواتير البيع";
    Layout = "_Layout";
    bool isRequested = ViewBag.IsRequested == true;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom d-print-none">
        <div>
            <h4 class="fw-bold mb-1 text-primary">
                <i class="fa-solid fa-file-invoice-dollar me-2"></i>تقرير تفصيلي لفواتير البيع
            </h4>
            <span class="text-muted small">عرض فواتير البيع وبنودها التفصيلية والعميل والضرائب والخصومات وطريقة السداد</span>
        </div>
        <div class="d-flex gap-2">
            @if (isRequested)
            {
                if (CurrentUserContext.HasPermission("Reports.SalesReports.Print,Reports.GeneralReports.Print"))
                {
                    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm fw-bold">
                        <i class="fa-solid fa-print me-1"></i> طباعة
                    </button>
                }
            }
            <a asp-action="Index" class="btn btn-outline-primary btn-sm fw-bold">
                <i class="fa-solid fa-arrow-right me-1"></i> فهرس تقارير المبيعات
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4 d-print-none">
        <div class="card-body p-3 bg-light rounded">
            <form method="get" asp-action="InvoiceDetails">
                <input type="hidden" name="submitted" value="true" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">الفرع</label>
                        <select name="BranchId" id="branchSelect" class="form-select form-select-sm" asp-items="ViewBag.Branches">
                            <option value="">-- كل الفروع --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">المستودع</label>
                        <select name="WarehouseId" id="warehouseSelect" class="form-select form-select-sm" asp-items="ViewBag.Warehouses">
                            <option value="">-- كل المستودعات --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">العميل</label>
                        <div class="erp-lookup-picker" 
                             data-type="customer" 
                             data-input-name="CustomerId" 
                             data-value="@Model.Filter.CustomerId" 
                             data-text="@ViewBag.SelectedCustomerDisplay"
                             data-placeholder="-- كافة العملاء (بحث بالكود / الاسم) --"
                             data-branch-selector="#branchSelect">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">من تاريخ</label>
                        <input type="date" name="DateFrom" class="form-control form-control-sm" value="@(Model.Filter.DateFrom?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">إلى تاريخ</label>
                        <input type="date" name="DateTo" class="form-control form-control-sm" value="@(Model.Filter.DateTo?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                            <i class="fa-solid fa-filter me-1"></i> عرض
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!isRequested)
    {
        <div class="card border-0 shadow-sm p-5 text-center my-4 bg-white rounded-3">
            <div class="text-primary mb-3">
                <i class="fa-solid fa-file-invoice-dollar fa-3x"></i>
            </div>
            <h5 class="fw-bold text-dark">يرجى تحديد معايير البحث والضغط على "عرض"</h5>
            <p class="text-muted small mb-0">اختر محددات البحث المطلوبة للاطلاع على تفاصيل فواتير البيع وبنودها.</p>
        </div>
    }
    else
    {
        <!-- Invoices List -->
        @if (!Model.Items.Any())
        {
            <div class="alert alert-info text-center py-4">
                لا توجد فواتير بيع مطابقة لمعايير البحث.
            </div>
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted small">إجمالي عدد الفواتير: <strong>@Model.Items.Count</strong></span>
                <span class="badge bg-primary fs-6 p-2">الإجمالي الصافي للفواتير: @Model.GrandTotal.ToString("N2") EGP</span>
            </div>

            @foreach (var inv in Model.Items)
            {
                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-header bg-white py-2 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <span class="badge bg-primary font-monospace fs-6 me-2">@inv.DocumentNumber</span>
                            <strong class="text-dark me-2">@inv.CustomerName</strong>
                            <span class="text-muted small">(@inv.TransactionTypeName | @inv.BranchName - @inv.WarehouseName)</span>
                        </div>
                        <div class="d-flex align-items-center gap-2 small">
                            <span class="badge bg-light text-dark border">@inv.DocumentDate.ToString("yyyy/MM/dd")</span>
                            <span class="badge bg-info-subtle text-info border">@inv.PaymentMethodName</span>
                            <span class="badge bg-success font-monospace fw-bold">الصافي: @inv.TotalNet.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0 align-middle text-center" style="font-size: 0.8rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>كود الصنف</th>
                                        <th class="text-start">اسم الصنف</th>
                                        <th>الوحدة</th>
                                        <th>الكمية</th>
                                        <th>سعر الوحدة</th>
                                        <th>الخصم</th>
                                        <th>الضريبة</th>
                                        <th class="text-end">الإجمالي</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < inv.Lines.Count; i++)
                                    {
                                        var line = inv.Lines[i];
                                        <tr>
                                            <td>@(i + 1)</td>
                                            <td class="font-monospace text-primary">@line.ItemCode</td>
                                            <td class="text-start fw-bold">@line.ItemName</td>
                                            <td>@line.UnitName</td>
                                            <td class="font-monospace fw-bold">@line.Quantity.ToString("G29")</td>
                                            <td class="font-monospace text-end">@line.UnitPrice.ToString("N2")</td>
                                            <td class="font-monospace text-end text-danger">@line.DiscountAmount.ToString("N2")</td>
                                            <td class="font-monospace text-end">@line.TaxAmount.ToString("N2")</td>
                                            <td class="font-monospace text-end fw-bold">@line.LineTotal.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>

<script>
    document.getElementById('branchSelect')?.addEventListener('change', function() {
        var branchId = this.value;
        var whSelect = document.getElementById('warehouseSelect');
        if (whSelect) {
            fetch('@Url.Action("GetWarehousesByBranch", "SalesReports")?branchId=' + branchId)
                .then(r => r.json())
                .then(data => {
                    whSelect.innerHTML = '<option value="">-- كل المستودعات --</option>';
                    data.forEach(item => {
                        var opt = document.createElement('option');
                        opt.value = item.id;
                        opt.textContent = item.text;
                        whSelect.appendChild(opt);
                    });
                });
        }
        var custSelect = document.getElementById('customerSelect');
        if (custSelect) {
            fetch('@Url.Action("GetCustomersByBranch", "SalesReports")?branchId=' + branchId)
                .then(r => r.json())
                .then(data => {
                    custSelect.innerHTML = '<option value="">-- كل العملاء --</option>';
                    data.forEach(item => {
                        var opt = document.createElement('option');
                        opt.value = item.id;
                        opt.textContent = item.text;
                        custSelect.appendChild(opt);
                    });
                });
        }
    });
</script>
