@model ERP.Application.DTOs.Reports.SalesComparisonReportDto
@{
    ViewData["Title"] = "مقارنة المبيعات بين الفروع والفترات";
    Layout = "_Layout";
    bool isRequested = ViewBag.IsRequested == true;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom d-print-none">
        <div>
            <h4 class="fw-bold mb-1 text-primary">
                <i class="fa-solid fa-code-compare me-2"></i>مقارنة المبيعات بين الفروع والفترات
            </h4>
            <span class="text-muted small">@Model.ComparisonBasis</span>
        </div>
        <div class="d-flex gap-2">
            @if (isRequested)
            {
                if (CurrentUserContext.HasPermission("Reports.SalesReports.Print,Reports.GeneralReports.Print"))
                {
                    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm fw-bold">
                        <i class="fa-solid fa-print me-1"></i> طباعة
                    </button>
                }
                if (CurrentUserContext.HasPermission("Reports.SalesReports.Export,Reports.GeneralReports.Export"))
                {
                    <button onclick="exportTableToExcel('branchComparisonTable', 'SalesBranchComparison')" class="btn btn-outline-success btn-sm fw-bold">
                        <i class="fa-solid fa-file-excel me-1"></i> تصدير Excel
                    </button>
                }
            }
            <a asp-action="Index" class="btn btn-outline-primary btn-sm fw-bold">
                <i class="fa-solid fa-arrow-right me-1"></i> فهرس تقارير المبيعات
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4 d-print-none">
        <div class="card-body p-3 bg-light rounded">
            <form method="get" asp-action="BranchComparison">
                <input type="hidden" name="submitted" value="true" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold mb-1">من تاريخ (الفترة الحالية)</label>
                        <input type="date" name="DateFrom" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold mb-1">إلى تاريخ (الفترة الحالية)</label>
                        <input type="date" name="DateTo" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                            <i class="fa-solid fa-filter me-1"></i> مقارنة الفترات
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!isRequested)
    {
        <div class="card border-0 shadow-sm p-5 text-center my-4 bg-white rounded-3">
            <div class="text-primary mb-3">
                <i class="fa-solid fa-code-compare fa-3x"></i>
            </div>
            <h5 class="fw-bold text-dark">يرجى تحديد الفترة والضغط على "مقارنة الفترات"</h5>
            <p class="text-muted small mb-0">حدد نطاق التاريخ للمقارنة بين الفروع والفترات السابقة.</p>
        </div>
    }
    else
    {
        <!-- Data Table -->
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="branchComparisonTable" class="table table-bordered table-hover table-striped align-middle mb-0 text-center" style="font-size: 0.85rem;">
                        <thead class="table-dark">
                            <tr>
                                <th>الفرع</th>
                                <th>مبيعات الفترة السابقة</th>
                                <th>مبيعات الفترة الحالية</th>
                                <th>الفارق الصافي</th>
                                <th>معدل النمو / التراجع</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Items.Any())
                            {
                                <tr>
                                    <td colspan="5" class="py-4 text-muted">لا توجد بيانات مقارنة مسجلة.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in Model.Items)
                                {
                                    <tr>
                                        <td class="fw-bold">@row.EntityName</td>
                                        <td class="font-monospace text-end">@row.Period1Sales.ToString("N2")</td>
                                        <td class="font-monospace text-end fw-bold text-primary">@row.Period2Sales.ToString("N2")</td>
                                        <td class="font-monospace text-end fw-bold @(row.Difference >= 0 ? "text-success" : "text-danger")">
                                            @row.Difference.ToString("N2")
                                        </td>
                                        <td>
                                            <span class="badge @(row.GrowthRate >= 0 ? "bg-success" : "bg-danger") font-monospace">
                                                @(row.GrowthRate >= 0 ? "+" : "")@row.GrowthRate.ToString("F1")%
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<script>
    function exportTableToExcel(tableId, filename) {
        var table = document.getElementById(tableId);
        if (!table) return;
        var html = table.outerHTML;
        var blob = new Blob(['\ufeff' + html], { type: 'application/vnd.ms-excel;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename + '_' + new Date().toISOString().slice(0, 10) + '.xls';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }
</script>
