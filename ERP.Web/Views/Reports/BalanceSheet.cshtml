@model ERP.Application.DTOs.Reports.BalanceSheetDto
@using ERP.Application.DTOs.Reports
@{
    ViewData["Title"] = "قائمة المركز المالي - الميزانية العمومية";
    Layout = "_Layout";
    var filter = ViewBag.Filter as ReportFilterDto ?? new ReportFilterDto();
    bool isRequested = ViewBag.IsRequested == true;
    bool isForeignMode = filter.Mode == ReportDisplayMode.ForeignOnly;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom d-print-none">
        <div>
            <h4 class="fw-bold mb-1 text-primary">
                <i class="fa-solid fa-building-columns me-2 text-primary"></i>قائمة المركز المالي (Balance Sheet)
            </h4>
            <span class="text-muted small">الميزانية العمومية وتوزيع الأصول والالتزامات وحقوق الملكية في تاريخ محدد</span>
        </div>
        <div class="d-flex gap-2">
            @if (isRequested)
            {
                if (CurrentUserContext.HasPermission("Reports.BalanceSheet.Print,Reports.GeneralReports.Print"))
                {
                    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm fw-bold">
                        <i class="fa-solid fa-print me-1"></i> طباعة (Print)
                    </button>
                }
                if (CurrentUserContext.HasPermission("Reports.BalanceSheet.Export,Reports.GeneralReports.Export"))
                {
                    <button onclick="exportTableToExcel('balanceSheetTable', 'BalanceSheet')" class="btn btn-outline-success btn-sm fw-bold">
                        <i class="fa-solid fa-file-excel me-1"></i> تصدير Excel
                    </button>
                }
            }
            <a asp-action="Index" class="btn btn-outline-primary btn-sm fw-bold">
                <i class="fa-solid fa-list me-1"></i> فهرس التقارير
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4 d-print-none">
        <div class="card-body p-3 bg-light rounded">
            <form method="get" asp-action="BalanceSheet" id="filterForm">
                <input type="hidden" name="submitted" value="true" />
                <div class="row g-2 align-items-end">
                    <!-- Fiscal Year -->
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">السنة المالية</label>
                        <select name="FiscalYearId" class="form-select form-select-sm" asp-items="ViewBag.FiscalYears">
                            <option value="">-- اختر السنة --</option>
                        </select>
                    </div>

                    <!-- Branch -->
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">الفرع</label>
                        <select name="BranchId" class="form-select form-select-sm" asp-items="ViewBag.Branches">
                            <option value="">كافة الفروع المتاحة</option>
                        </select>
                    </div>

                    <!-- Mode -->
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1 text-primary">العملة المعروضة</label>
                        <select name="Mode" class="form-select form-select-sm fw-bold">
                            <option value="1" selected="@(filter.Mode == ReportDisplayMode.LocalOnly)">العملة المحلية (Local Currency)</option>
                            <option value="2" selected="@(filter.Mode == ReportDisplayMode.ForeignOnly)">العملة الأجنبية (Foreign Currency)</option>
                        </select>
                    </div>

                    <!-- As Of Date (DateTo) -->
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">حتى تاريخ (As of Date)</label>
                        <input type="date" name="DateTo" class="form-control form-control-sm" 
                               value="@(filter.DateTo?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <!-- Only With Transactions Checkbox -->
                    <div class="col-md-3 mt-2">
                        <div class="form-check pt-4">
                            <input class="form-check-input" type="checkbox" name="OnlyWithTransactions" value="true" id="chkOnlyTrans" 
                                   @(filter.OnlyWithTransactions ? "checked" : "") />
                            <label class="form-check-label small" for="chkOnlyTrans">
                                إخفاء البنود الصفرية (Hide Zero Rows)
                            </label>
                        </div>
                    </div>

                    <!-- Include Drafts Checkbox -->
                    <div class="col-md-3 mt-2">
                        <div class="form-check pt-4">
                            <input class="form-check-input" type="checkbox" name="IncludeDrafts" value="true" id="chkDrafts" 
                                   @(filter.IncludeDrafts ? "checked" : "") />
                            <label class="form-check-label small" for="chkDrafts">
                                تضمين قيود المسودة (Drafts)
                            </label>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="col-md-6 mt-2 text-end">
                        <button type="submit" class="btn btn-primary btn-sm px-4 fw-bold">
                            <i class="fa-solid fa-filter me-1"></i> استعراض الميزانية العمومية
                        </button>
                        <a asp-action="BalanceSheet" class="btn btn-light btn-sm border px-3">
                            إعادة تعيين
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!isRequested)
    {
        <!-- Prompt Box when report is not yet requested -->
        <div class="card border-0 shadow-sm p-5 text-center my-4 bg-white rounded-3">
            <div class="text-primary mb-3">
                <i class="fa-solid fa-building-columns fa-3x"></i>
            </div>
            <h5 class="fw-bold text-dark">يرجى تحديد معايير البحث ثم الضغط على "استعراض الميزانية العمومية"</h5>
            <p class="text-muted small mb-0">اختر الفرع والسنة المالية والتاريخ لعرض المركز المالي المتوازن والتحقق من معادلة الميزانية (الأصول = الخصوم + حقوق الملكية).</p>
        </div>
    }
    else
    {
        <!-- Print Report Header -->
        <div class="report-print-header mb-3 border p-3 rounded bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-1">
                        قائمة المركز المالي: <span class="text-primary">@(isForeignMode ? "بالعملة الأجنبية (Foreign Currency)" : "بالعملة المحلية (Local Currency)")</span>
                    </h5>
                    <div class="small text-muted">
                        <span>الفرع: <strong>@Model.BranchName</strong></span> | 
                        <span>السنة المالية: <strong>@Model.FiscalYearName</strong></span> |
                        @if (!string.IsNullOrEmpty(Model.CurrencyCode)) { <span>العملة المحددة: <strong>@Model.CurrencyCode</strong> | </span> }
                        <span>في تاريخ: <strong>@(Model.AsOfDate?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))</strong></span>
                    </div>
                </div>
                <div class="text-end">
                    @if (Model.IsBalanced)
                    {
                        <span class="badge bg-success p-2 fs-6">
                            <i class="fa-solid fa-check-circle me-1"></i> الميزانية متزنة تماماً (Assets = Liabilities + Equity)
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger p-2 fs-6">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i> يوجد فارق عدم توازن: @Model.BalanceDifference.ToString("N2")
                        </span>
                    }
                    <div class="small text-muted mt-1">تاريخ الاستخراج: @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</div>
                </div>
            </div>
        </div>

        <!-- Executive KPI Cards -->
        <div class="row g-3 mb-4 d-print-none">
            <!-- 1. Total Assets -->
            <div class="col-md-3">
                <div class="card border-0 shadow-sm p-3 border-start border-primary border-4 bg-white">
                    <div class="text-muted small fw-bold">إجمالي الأصول (Total Assets)</div>
                    <div class="fs-4 fw-bold text-primary dir-ltr text-end mt-1">@Model.TotalAssets.ToString("N2")</div>
                    <div class="small text-muted">متداولة: @Model.TotalCurrentAssets.ToString("N2")</div>
                </div>
            </div>

            <!-- 2. Total Liabilities -->
            <div class="col-md-3">
                <div class="card border-0 shadow-sm p-3 border-start border-danger border-4 bg-white">
                    <div class="text-muted small fw-bold">إجمالي الالتزامات (Liabilities)</div>
                    <div class="fs-4 fw-bold text-danger dir-ltr text-end mt-1">@Model.TotalLiabilities.ToString("N2")</div>
                    <div class="small text-muted">متداولة: @Model.TotalCurrentLiabilities.ToString("N2")</div>
                </div>
            </div>

            <!-- 3. Total Equity -->
            <div class="col-md-3">
                <div class="card border-0 shadow-sm p-3 border-start border-success border-4 bg-white">
                    <div class="text-muted small fw-bold">حقوق الملكية (Equity)</div>
                    <div class="fs-4 fw-bold text-success dir-ltr text-end mt-1">@Model.TotalEquity.ToString("N2")</div>
                    <div class="small text-muted">صافي نتيجة الفترة: @Model.CurrentPeriodNetIncome.ToString("N2")</div>
                </div>
            </div>

            <!-- 4. Balance Difference -->
            <div class="col-md-3">
                <div class="card border-0 shadow-sm p-3 border-start @(Model.IsBalanced ? "border-success" : "border-danger") border-4 bg-white">
                    <div class="text-muted small fw-bold">فارق التوازن (Balance Check)</div>
                    <div class="fs-4 fw-bold @(Model.IsBalanced ? "text-success" : "text-danger") dir-ltr text-end mt-1">
                        @Model.BalanceDifference.ToString("N4")
                    </div>
                    <div class="small text-muted">حالة المعادلة: @(Model.IsBalanced ? "مطابقة 100%" : "غير متطابقة")</div>
                </div>
            </div>
        </div>

        <!-- Balance Sheet Table -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0" id="balanceSheetTable">
                    <thead class="table-dark small text-center">
                        <tr>
                            <th style="width: 120px;">كود الحساب</th>
                            <th>بيان الحساب / البند المالي</th>
                            <th style="width: 150px;">المبلغ الجزئي</th>
                            <th style="width: 160px;">المبلغ الإجمالي</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        <!-- ================= PART 1: ASSETS ================= -->
                        <tr class="table-primary fw-bold">
                            <td colspan="4" class="py-2 fs-6">
                                <i class="fa-solid fa-wallet me-2"></i>أولاً: الأصول (Assets)
                            </td>
                        </tr>

                        <!-- CURRENT ASSETS -->
                        <tr class="table-light fw-bold">
                            <td colspan="4" class="ps-3 text-primary">
                                <i class="fa-regular fa-folder-open me-1"></i> 1. الأصول المتداولة (Current Assets)
                            </td>
                        </tr>
                        @if (Model.CurrentAssetItems.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-2">لا توجد أصول متداولة مسجلة</td></tr>
                        }
                        else
                        {
                            foreach (var item in Model.CurrentAssetItems)
                            {
                                <tr>
                                    <td class="text-center fw-bold">
                                        <a asp-action="AccountStatement" 
                                           asp-route-submitted="true"
                                           asp-route-AccountId="@item.AccountId"
                                           asp-route-DateTo="@(filter.DateTo?.ToString("yyyy-MM-dd"))"
                                           asp-route-FiscalYearId="@filter.FiscalYearId"
                                           asp-route-BranchId="@filter.BranchId"
                                           target="_blank" class="text-decoration-none">
                                            @item.AccountCode
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-secondary border me-1">@item.Section</span>
                                        @item.LocalizedAccountName
                                    </td>
                                    <td class="text-end dir-ltr">@item.AmountLocal.ToString("N2")</td>
                                    <td class="text-end text-muted">-</td>
                                </tr>
                            }
                        }
                        <tr class="table-info fw-bold">
                            <td colspan="3" class="text-end pe-4">مجموع الأصول المتداولة (Total Current Assets)</td>
                            <td class="text-end dir-ltr">@Model.TotalCurrentAssets.ToString("N2")</td>
                        </tr>

                        <!-- NON-CURRENT ASSETS -->
                        <tr class="table-light fw-bold">
                            <td colspan="4" class="ps-3 text-primary">
                                <i class="fa-regular fa-folder-open me-1"></i> 2. الأصول غير المتداولة والثابتة (Non-Current Assets)
                            </td>
                        </tr>
                        @if (Model.NonCurrentAssetItems.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-2">لا توجد أصول ثابتة مسجلة</td></tr>
                        }
                        else
                        {
                            foreach (var item in Model.NonCurrentAssetItems)
                            {
                                <tr>
                                    <td class="text-center fw-bold">
                                        <a asp-action="AccountStatement" 
                                           asp-route-submitted="true"
                                           asp-route-AccountId="@item.AccountId"
                                           asp-route-DateTo="@(filter.DateTo?.ToString("yyyy-MM-dd"))"
                                           asp-route-FiscalYearId="@filter.FiscalYearId"
                                           asp-route-BranchId="@filter.BranchId"
                                           target="_blank" class="text-decoration-none">
                                            @item.AccountCode
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-secondary border me-1">@item.Section</span>
                                        @item.LocalizedAccountName
                                    </td>
                                    <td class="text-end dir-ltr">@item.AmountLocal.ToString("N2")</td>
                                    <td class="text-end text-muted">-</td>
                                </tr>
                            }
                        }
                        <tr class="table-info fw-bold">
                            <td colspan="3" class="text-end pe-4">مجموع الأصول غير المتداولة (Total Non-Current Assets)</td>
                            <td class="text-end dir-ltr">@Model.TotalNonCurrentAssets.ToString("N2")</td>
                        </tr>

                        <!-- TOTAL ASSETS -->
                        <tr class="table-primary text-primary fw-bold fs-5 border-top border-bottom border-2">
                            <td colspan="3" class="text-end pe-4 py-3">
                                <i class="fa-solid fa-scale-balanced me-2"></i>إجمالي الأصول (Total Assets)
                            </td>
                            <td class="text-end dir-ltr py-3">@Model.TotalAssets.ToString("N2")</td>
                        </tr>

                        <!-- ================= PART 2: LIABILITIES ================= -->
                        <tr class="table-danger fw-bold">
                            <td colspan="4" class="py-2 fs-6">
                                <i class="fa-solid fa-hand-holding-dollar me-2"></i>ثانياً: الخصوم والالتزامات (Liabilities)
                            </td>
                        </tr>

                        <!-- CURRENT LIABILITIES -->
                        <tr class="table-light fw-bold">
                            <td colspan="4" class="ps-3 text-danger">
                                <i class="fa-regular fa-folder-open me-1"></i> 1. الالتزامات المتداولة (Current Liabilities)
                            </td>
                        </tr>
                        @if (Model.CurrentLiabilityItems.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-2">لا توجد التزامات متداولة مسجلة</td></tr>
                        }
                        else
                        {
                            foreach (var item in Model.CurrentLiabilityItems)
                            {
                                <tr>
                                    <td class="text-center fw-bold">
                                        <a asp-action="AccountStatement" 
                                           asp-route-submitted="true"
                                           asp-route-AccountId="@item.AccountId"
                                           asp-route-DateTo="@(filter.DateTo?.ToString("yyyy-MM-dd"))"
                                           asp-route-FiscalYearId="@filter.FiscalYearId"
                                           asp-route-BranchId="@filter.BranchId"
                                           target="_blank" class="text-decoration-none">
                                            @item.AccountCode
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-secondary border me-1">@item.Section</span>
                                        @item.LocalizedAccountName
                                    </td>
                                    <td class="text-end dir-ltr">@item.AmountLocal.ToString("N2")</td>
                                    <td class="text-end text-muted">-</td>
                                </tr>
                            }
                        }
                        <tr class="table-warning fw-bold">
                            <td colspan="3" class="text-end pe-4">مجموع الالتزامات المتداولة (Total Current Liabilities)</td>
                            <td class="text-end dir-ltr">@Model.TotalCurrentLiabilities.ToString("N2")</td>
                        </tr>

                        <!-- NON-CURRENT LIABILITIES -->
                        @if (Model.NonCurrentLiabilityItems.Count > 0)
                        {
                            <tr class="table-light fw-bold">
                                <td colspan="4" class="ps-3 text-danger">
                                    <i class="fa-regular fa-folder-open me-1"></i> 2. الالتزامات طويلة الأجل (Long-Term Liabilities)
                                </td>
                            </tr>
                            foreach (var item in Model.NonCurrentLiabilityItems)
                            {
                                <tr>
                                    <td class="text-center fw-bold">
                                        <a asp-action="AccountStatement" 
                                           asp-route-submitted="true"
                                           asp-route-AccountId="@item.AccountId"
                                           target="_blank" class="text-decoration-none">
                                            @item.AccountCode
                                        </a>
                                    </td>
                                    <td>@item.LocalizedAccountName</td>
                                    <td class="text-end dir-ltr">@item.AmountLocal.ToString("N2")</td>
                                    <td class="text-end text-muted">-</td>
                                </tr>
                            }
                            <tr class="table-warning fw-bold">
                                <td colspan="3" class="text-end pe-4">مجموع الالتزامات غير المتداولة (Total Long-Term Liabilities)</td>
                                <td class="text-end dir-ltr">@Model.TotalLongTermLiabilities.ToString("N2")</td>
                            </tr>
                        }

                        <tr class="table-danger text-danger fw-bold">
                            <td colspan="3" class="text-end pe-4">مجموع الخصوم والالتزامات (Total Liabilities)</td>
                            <td class="text-end dir-ltr">@Model.TotalLiabilities.ToString("N2")</td>
                        </tr>

                        <!-- ================= PART 3: EQUITY ================= -->
                        <tr class="table-success fw-bold">
                            <td colspan="4" class="py-2 fs-6">
                                <i class="fa-solid fa-coins me-2"></i>ثالثاً: حقوق الملكية (Owner's Equity)
                            </td>
                        </tr>
                        @foreach (var item in Model.EquityItems)
                        {
                            <tr>
                                <td class="text-center fw-bold">
                                    <a asp-action="AccountStatement" 
                                       asp-route-submitted="true"
                                       asp-route-AccountId="@item.AccountId"
                                       target="_blank" class="text-decoration-none">
                                        @item.AccountCode
                                    </a>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border me-1">@item.Section</span>
                                    @item.LocalizedAccountName
                                </td>
                                <td class="text-end dir-ltr">@item.AmountLocal.ToString("N2")</td>
                                <td class="text-end text-muted">-</td>
                            </tr>
                        }

                        <!-- CURRENT PERIOD NET INCOME LINE -->
                        <tr class="table-light fw-bold">
                            <td class="text-center text-muted">-</td>
                            <td>
                                <i class="fa-solid fa-arrow-turn-down me-1 text-primary"></i>
                                <span class="text-primary fw-bold">صافي نتيجة الفترة المحولة من قائمة الدخل (Current Period Net Income)</span>
                            </td>
                            <td class="text-end dir-ltr fw-bold @(Model.CurrentPeriodNetIncome >= 0 ? "text-success" : "text-danger")">
                                @Model.CurrentPeriodNetIncome.ToString("N2")
                            </td>
                            <td class="text-end text-muted">-</td>
                        </tr>

                        <tr class="table-success text-success fw-bold">
                            <td colspan="3" class="text-end pe-4">مجموع حقوق الملكية (Total Equity)</td>
                            <td class="text-end dir-ltr">@Model.TotalEquity.ToString("N2")</td>
                        </tr>

                        <!-- ================= TOTAL LIABILITIES & EQUITY ================= -->
                        <tr class="table-dark text-white fw-bold fs-5">
                            <td colspan="3" class="text-end pe-4 py-3">
                                <i class="fa-solid fa-shield-halved me-2 text-warning"></i>إجمالي الالتزامات وحقوق الملكية (Total Liabilities & Equity)
                            </td>
                            <td class="text-end dir-ltr py-3">@Model.TotalLiabilitiesAndEquity.ToString("N2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<script>
    function exportTableToExcel(tableId, filename) {
        var table = document.getElementById(tableId);
        if (!table) return;
        var html = table.outerHTML;
        var blob = new Blob(['\ufeff' + html], { type: 'application/vnd.ms-excel;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename + '_' + new Date().toISOString().slice(0, 10) + '.xls';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }
</script>

<style>
    .dir-ltr { direction: ltr; }
    @@media print {
        .d-print-none { display: none !important; }
        .erp-sidebar, .erp-topbar, .erp-footer { display: none !important; }
        .erp-main { margin: 0 !important; padding: 0 !important; }
        body { font-size: 11px !important; background: #fff !important; }
        .table { width: 100% !important; border: 1px solid #000 !important; }
        .table th, .table td { border: 1px solid #ddd !important; padding: 4px !important; }
    }
</style>
