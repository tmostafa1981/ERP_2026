@{
    ViewData["Title"] = "التقارير المحاسبية متعددة العملات";
    Layout = "_Layout";
}

<div class="container-fluid py-3">
    <!-- Header Page Title -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold mb-1 text-primary">
                <i class="fa-solid fa-chart-line me-2"></i>التقارير المحاسبية متعددة العملات
            </h3>
            <p class="text-muted small mb-0">كشوف الحسابات، موازين المراجعة، ودفاتر الأستاذ بالعملة المحلية والأجنبية</p>
        </div>
    </div>

    <!-- Reports Cards Grid -->
    <div class="row g-4">
        <!-- 1. Account Statement -->
        @if (CurrentUserContext.HasPermission("Reports.AccountStatement.View,Reports.GeneralReports.View"))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 report-hub-card">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary fs-3">
                                <i class="fa-solid fa-file-invoice"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">كشف حساب الحساب المالي</h5>
                                <span class="text-muted small">Account Statement</span>
                            </div>
                        </div>
                        <p class="text-secondary small flex-grow-1">
                            عرض تفصيلي لحركات الحساب المالي مع رصيد أول المدة ورصيد تراكمي بالعملة الأجنبية والعملة المحلية.
                        </p>
                        <div class="mt-3 pt-3 border-top">
                            <a asp-action="AccountStatement" class="btn btn-primary w-100 fw-bold">
                                <i class="fa-solid fa-arrow-left me-1"></i> فتح التقرير
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- 2. Customer Statement -->
        @if (CurrentUserContext.HasPermission("Reports.CustomerStatement.View,Reports.GeneralReports.View"))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 report-hub-card">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success fs-3">
                                <i class="fa-solid fa-users"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">كشف حساب عميل</h5>
                                <span class="text-muted small">Customer Statement</span>
                            </div>
                        </div>
                        <p class="text-secondary small flex-grow-1">
                            كشف حساب تفصيلي للعميل يوضح العملات، أسعار الصرف، المسحوبات والمدفوعات والأرصدة المستحقة محلياً وخارجياً.
                        </p>
                        <div class="mt-3 pt-3 border-top">
                            <a asp-action="CustomerStatement" class="btn btn-success w-100 fw-bold text-white">
                                <i class="fa-solid fa-arrow-left me-1"></i> فتح التقرير
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- 3. Vendor Statement -->
        @if (CurrentUserContext.HasPermission("Reports.VendorStatement.View,Reports.GeneralReports.View"))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 report-hub-card">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning fs-3">
                                <i class="fa-solid fa-truck-moving"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">كشف حساب مورد</h5>
                                <span class="text-muted small">Vendor Statement</span>
                            </div>
                        </div>
                        <p class="text-secondary small flex-grow-1">
                            مطابقة فواتير وسندات ومستحقات الموردين مع متابعة دقيقة لفروق ومعاملات أسعار الصرف.
                        </p>
                        <div class="mt-3 pt-3 border-top">
                            <a asp-action="VendorStatement" class="btn btn-warning w-100 fw-bold text-dark">
                                <i class="fa-solid fa-arrow-left me-1"></i> فتح التقرير
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- 3.1 SubLedger Summary (إجمالي وأرصدة حسابات العملاء والموردين) -->
        @if (CurrentUserContext.HasPermission("Reports.SubLedgerSummary.View,Reports.CustomerStatement.View,Reports.VendorStatement.View,Reports.GeneralReports.View"))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 report-hub-card border-top border-4 border-primary">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary fs-3">
                                <i class="fa-solid fa-address-book"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">إجمالي وأرصدة العملاء والموردين</h5>
                                <span class="text-muted small">Sub-Ledger Trial Balance</span>
                            </div>
                        </div>
                        <p class="text-secondary small flex-grow-1">
                            ميزان أرصدة مجمع لحسابات العملاء والموردين، يعرض رصيد أول المدة وحركات الفترة والرصيد الختامي وصافي المديونيات والمستحقات مع تصدير Excel مباشر.
                        </p>
                        <div class="mt-3 pt-3 border-top">
                            <a asp-action="SubLedgerSummary" class="btn btn-outline-primary w-100 fw-bold">
                                <i class="fa-solid fa-arrow-left me-1"></i> فتح التقرير
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- 4. Trial Balance -->
        @if (CurrentUserContext.HasPermission("Reports.TrialBalance.View,Reports.GeneralReports.View"))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 report-hub-card">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info fs-3">
                                <i class="fa-solid fa-scale-balanced"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">ميزان المراجعة</h5>
                                <span class="text-muted small">Trial Balance</span>
                            </div>
                        </div>
                        <p class="text-secondary small flex-grow-1">
                            ميزان مراجعة مزدوج بالعملة المحلية وبالعملات الأجنبية مع مراجعة توازن القيود (مدين/دائن) والتصفية بالعملات.
                        </p>
                        <div class="mt-3 pt-3 border-top">
                            <a asp-action="TrialBalance" class="btn btn-info w-100 fw-bold text-white">
                                <i class="fa-solid fa-arrow-left me-1"></i> فتح التقرير
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- 5. General Ledger -->
        @if (CurrentUserContext.HasPermission("Reports.GeneralLedger.View,Reports.GeneralReports.View"))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 report-hub-card">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle bg-secondary bg-opacity-10 p-3 text-secondary fs-3">
                                <i class="fa-solid fa-book-journal-whills"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">دفتر الأستاذ العام</h5>
                                <span class="text-muted small">General Ledger</span>
                            </div>
                        </div>
                        <p class="text-secondary small flex-grow-1">
                            دفتر الأستاذ العام الشامل مجمعاً ومفصلاً لكافة الحسابات مع حركات الفترة والأرصدة التراكمية.
                        </p>
                        <div class="mt-3 pt-3 border-top">
                            <a asp-action="GeneralLedger" class="btn btn-secondary w-100 fw-bold text-white">
                                <i class="fa-solid fa-arrow-left me-1"></i> فتح التقرير
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- 6. Income Statement -->
        @if (CurrentUserContext.HasPermission("Reports.IncomeStatement.View,Reports.GeneralReports.View"))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 report-hub-card border-top border-primary border-3">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary fs-3">
                                <i class="fa-solid fa-chart-line"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">قائمة الدخل (الأرباح والخسائر)</h5>
                                <span class="text-muted small">Income Statement / P&L</span>
                            </div>
                        </div>
                        <p class="text-secondary small flex-grow-1">
                            تقرير الأرباح والخسائر التشغيلية، مجمل وصافي الربح، ونسب التكاليف من المبيعات متعدد الفروع والعملات.
                        </p>
                        <div class="mt-3 pt-3 border-top">
                            <a asp-action="IncomeStatement" class="btn btn-primary w-100 fw-bold">
                                <i class="fa-solid fa-arrow-left me-1"></i> فتح التقرير
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- 7. Balance Sheet -->
        @if (CurrentUserContext.HasPermission("Reports.BalanceSheet.View,Reports.GeneralReports.View"))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 report-hub-card border-top border-success border-3">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success fs-3">
                                <i class="fa-solid fa-building-columns"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">قائمة المركز المالي (الميزانية)</h5>
                                <span class="text-muted small">Balance Sheet</span>
                            </div>
                        </div>
                        <p class="text-secondary small flex-grow-1">
                            الميزانية العمومية الشاملة وهيكل الأصول والخصوم وحقوق الملكية مع التحقق الآلي من معادلة التوازن المحاسبي.
                        </p>
                        <div class="mt-3 pt-3 border-top">
                            <a asp-action="BalanceSheet" class="btn btn-success w-100 fw-bold text-white">
                                <i class="fa-solid fa-arrow-left me-1"></i> فتح التقرير
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .report-hub-card {
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .report-hub-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
    }
</style>
