@model ERP.Application.DTOs.Reports.SubLedgerSummaryDto
@using ERP.Application.DTOs.Reports
@{
    ViewData["Title"] = "تقرير إجمالي وأرصدة حسابات العملاء والموردين";
    Layout = "_Layout";
    var filter = ViewBag.Filter as SubLedgerSummaryFilterDto ?? new SubLedgerSummaryFilterDto();
    bool isRequested = ViewBag.IsRequested == true;
    var queryString = Context.Request.QueryString.ToString();
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 pb-2 border-bottom d-print-none gap-2">
        <div>
            <h4 class="fw-bold mb-1 text-primary">
                <i class="fa-solid fa-address-book me-2 text-primary"></i>تقرير إجمالي وأرصدة حسابات العملاء والموردين
            </h4>
            <span class="text-muted small">ميزان مراجعة الحسابات المساعدة (Sub-Ledger Trial Balance) للأطراف وتتبع الأرصدة الافتتاحية وحركات الفترة والأرصدة الختامية</span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (isRequested)
            {
                <button onclick="window.print()" class="btn btn-outline-secondary btn-sm fw-bold">
                    <i class="fa-solid fa-print me-1"></i> طباعة (Print)
                </button>
                <a href="@Url.Action("ExportSubLedgerSummaryToExcel", "Reports")@queryString" class="btn btn-outline-success btn-sm fw-bold">
                    <i class="fa-solid fa-file-excel me-1"></i> تصدير Excel مباشر
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-primary btn-sm fw-bold">
                <i class="fa-solid fa-list me-1"></i> فهرس التقارير
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4 d-print-none">
        <div class="card-body p-3 bg-light rounded">
            <form method="get" asp-action="SubLedgerSummary" id="filterForm">
                <input type="hidden" name="submitted" value="true" />
                <div class="row g-2 align-items-end">
                    <!-- Party Type -->
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1 text-primary">نوع الحسابات (Party Type)</label>
                        <select name="PartyType" class="form-select form-select-sm fw-bold">
                            <option value="All" selected="@(filter.PartyType == "All" || string.IsNullOrEmpty(filter.PartyType))">كافة الأطراف (عملاء وموردين)</option>
                            <option value="Customer" selected="@(filter.PartyType == "Customer")">العملاء فقط (Customers)</option>
                            <option value="Vendor" selected="@(filter.PartyType == "Vendor")">الموردين فقط (Vendors)</option>
                        </select>
                    </div>

                    <!-- Fiscal Year -->
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">السنة المالية</label>
                        <select name="FiscalYearId" class="form-select form-select-sm" asp-items="ViewBag.FiscalYears">
                            <option value="">-- اختر السنة --</option>
                        </select>
                    </div>

                    <!-- Branch -->
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">الفرع</label>
                        <select name="BranchId" class="form-select form-select-sm" asp-items="ViewBag.Branches">
                            <option value="">كافة الفروع المتاحة</option>
                        </select>
                    </div>

                    <!-- Currency Filter -->
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">تصفية حسب العملة</label>
                        <select name="CurrencyId" class="form-select form-select-sm" asp-items="ViewBag.Currencies">
                            <option value="">كافة العملات</option>
                        </select>
                    </div>

                    <!-- Date From -->
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">من تاريخ</label>
                        <input type="date" name="DateFrom" class="form-control form-control-sm" 
                               value="@(filter.DateFrom?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <!-- Date To -->
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">إلى تاريخ</label>
                        <input type="date" name="DateTo" class="form-control form-control-sm" 
                               value="@(filter.DateTo?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <!-- Search Term -->
                    <div class="col-md-4 mt-2">
                        <label class="form-label small fw-bold mb-1">بحث بكود أو اسم الطرف</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                            <input type="text" name="SearchTerm" class="form-control" placeholder="اكتب كود أو اسم العميل / المورد..." value="@filter.SearchTerm" />
                        </div>
                    </div>

                    <!-- Checkboxes & Options -->
                    <div class="col-md-5 mt-2 d-flex flex-wrap gap-3 align-items-center">
                        <div class="form-check form-check-inline mb-0">
                            <input type="checkbox" name="OnlyWithBalances" value="true" class="form-check-input" id="chkBalances" 
                                   @(filter.OnlyWithBalances ? "checked" : "") />
                            <label class="form-check-label small fw-bold" for="chkBalances">ذوي الأرصدة غير الصفرية فقط</label>
                        </div>
                        <div class="form-check form-check-inline mb-0">
                            <input type="checkbox" name="OnlyWithTransactions" value="true" class="form-check-input" id="chkTrans" 
                                   @(filter.OnlyWithTransactions ? "checked" : "") />
                            <label class="form-check-label small fw-bold" for="chkTrans">الذين لديهم حركات فقط</label>
                        </div>
                        <div class="form-check form-check-inline mb-0">
                            <input type="checkbox" name="IncludeDrafts" value="true" class="form-check-input" id="chkDrafts" 
                                   @(filter.IncludeDrafts ? "checked" : "") />
                            <label class="form-check-label small" for="chkDrafts">تضمين القيود المسودة</label>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="col-md-3 mt-2 d-flex gap-2 justify-content-end">
                        <button type="submit" class="btn btn-primary btn-sm px-3 fw-bold flex-grow-1">
                            <i class="fa-solid fa-filter me-1"></i> عرض التقرير
                        </button>
                        <a asp-action="SubLedgerSummary" class="btn btn-outline-secondary btn-sm px-2">
                            <i class="fa-solid fa-rotate-left"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!isRequested)
    {
        <div class="alert alert-info border-0 shadow-sm text-center py-5">
            <i class="fa-solid fa-circle-info fa-3x text-info mb-3"></i>
            <h5 class="fw-bold">يرجى تحديد معايير البحث والضغط على "عرض التقرير"</h5>
            <p class="text-muted small mb-0">يمكنك استعراض إجمالي أرصدة وحركات العملاء، الموردين، أو كلاهما معاً وتصدير المخرجات لملف إكسيل منسق.</p>
        </div>
    }
    else
    {
        <!-- KPI Summary Cards -->
        <div class="row g-3 mb-4 d-print-none">
            <!-- Total Customers -->
            <div class="col-sm-6 col-xl">
                <div class="card shadow-sm border-0 border-start border-4 border-success h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small fw-bold d-block">إجمالي العملاء</span>
                                <span class="h4 fw-bold mb-0 text-success">@Model.TotalCustomersCount</span>
                            </div>
                            <div class="rounded-circle bg-success bg-opacity-10 p-2 text-success">
                                <i class="fa-solid fa-users fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Total Vendors -->
            <div class="col-sm-6 col-xl">
                <div class="card shadow-sm border-0 border-start border-4 border-warning h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small fw-bold d-block">إجمالي الموردين</span>
                                <span class="h4 fw-bold mb-0 text-warning">@Model.TotalVendorsCount</span>
                            </div>
                            <div class="rounded-circle bg-warning bg-opacity-10 p-2 text-warning">
                                <i class="fa-solid fa-truck-moving fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Customer Receivables -->
            <div class="col-sm-6 col-xl">
                <div class="card shadow-sm border-0 border-start border-4 border-primary h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small fw-bold d-block">مديونيات العملاء (لنا)</span>
                                <span class="h5 fw-bold mb-0 text-primary dir-ltr">@Model.TotalCustomerReceivablesLocal.ToString("N2") <small class="text-muted fs-6">EGP</small></span>
                            </div>
                            <div class="rounded-circle bg-primary bg-opacity-10 p-2 text-primary">
                                <i class="fa-solid fa-hand-holding-dollar fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Vendor Payables -->
            <div class="col-sm-6 col-xl">
                <div class="card shadow-sm border-0 border-start border-4 border-danger h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small fw-bold d-block">مستحقات الموردين (علينا)</span>
                                <span class="h5 fw-bold mb-0 text-danger dir-ltr">@Model.TotalVendorPayablesLocal.ToString("N2") <small class="text-muted fs-6">EGP</small></span>
                            </div>
                            <div class="rounded-circle bg-danger bg-opacity-10 p-2 text-danger">
                                <i class="fa-solid fa-file-invoice-dollar fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Net Overall Position -->
            <div class="col-sm-6 col-xl">
                <div class="card shadow-sm border-0 border-start border-4 @(Model.NetOverallBalanceLocal >= 0 ? "border-success" : "border-danger") h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small fw-bold d-block">صافي الموقف العام</span>
                                <span class="h5 fw-bold mb-0 @(Model.NetOverallBalanceLocal >= 0 ? "text-success" : "text-danger") dir-ltr">
                                    @Model.NetOverallBalanceLocal.ToString("N2") <small class="text-muted fs-6">EGP</small>
                                </span>
                            </div>
                            <div class="rounded-circle @(Model.NetOverallBalanceLocal >= 0 ? "bg-success" : "bg-danger") bg-opacity-10 p-2 @(Model.NetOverallBalanceLocal >= 0 ? "text-success" : "text-danger")">
                                <i class="fa-solid fa-scale-balanced fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Print Header Info -->
        <div class="d-none d-print-block text-center mb-3 pb-2 border-bottom">
            <h3 class="fw-bold mb-1">تقرير إجمالي وأرصدة حسابات العملاء والموردين</h3>
            <div class="small text-muted d-flex justify-content-center gap-4">
                <span><strong>الفرع:</strong> @(string.IsNullOrWhiteSpace(Model.BranchName) ? "كافة الفروع" : Model.BranchName)</span>
                <span><strong>الفترة من:</strong> @(Model.DateFrom?.ToString("yyyy/MM/dd") ?? "-") <strong>إلى:</strong> @(Model.DateTo?.ToString("yyyy/MM/dd") ?? "-")</span>
                <span><strong>تاريخ الطباعة:</strong> @DateTime.Now.ToString("yyyy/MM/dd HH:mm")</span>
            </div>
        </div>

        <!-- Data Table Card -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-table-list me-2 text-primary"></i>بيانات الحسابات والأرصدة
                    <span class="badge bg-primary ms-2">@Model.Items.Count سجل</span>
                </h6>
                <div class="d-flex gap-2 d-print-none">
                    <button onclick="exportTableToExcel('subLedgerSummaryTable', 'SubLedgerSummary')" class="btn btn-outline-secondary btn-sm">
                        <i class="fa-solid fa-download me-1"></i> تصدير الجدول الحالي
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0 text-nowrap" id="subLedgerSummaryTable" style="font-size: 0.88rem;">
                    <thead class="table-light text-center">
                        <tr>
                            <th rowspan="2" class="align-middle" style="width: 40px;">#</th>
                            <th rowspan="2" class="align-middle" style="width: 70px;">النوع</th>
                            <th rowspan="2" class="align-middle" style="width: 90px;">الكود</th>
                            <th rowspan="2" class="align-middle text-start" style="min-width: 180px;">اسم الطرف (العميل / المورد)</th>
                            <th rowspan="2" class="align-middle" style="width: 100px;">الفرع</th>
                            <th rowspan="2" class="align-middle" style="width: 60px;">العملة</th>
                            <th colspan="2" class="bg-primary bg-opacity-10 text-primary fw-bold">رصيد أول المدة (EGP)</th>
                            <th colspan="2" class="bg-info bg-opacity-10 text-info fw-bold">حركات الفترة (EGP)</th>
                            <th colspan="2" class="bg-secondary bg-opacity-10 text-secondary fw-bold">الرصيد الختامي (EGP)</th>
                            <th rowspan="2" class="align-middle bg-light" style="width: 120px;">صافي الرصيد</th>
                            <th rowspan="2" class="align-middle" style="width: 100px;">حالة الرصيد</th>
                            <th rowspan="2" class="align-middle d-print-none" style="width: 70px;">كشف الحساب</th>
                        </tr>
                        <tr>
                            <th class="small py-1 bg-primary bg-opacity-10">مدين (+)</th>
                            <th class="small py-1 bg-primary bg-opacity-10">دائن (-)</th>
                            <th class="small py-1 bg-info bg-opacity-10">مدين (+)</th>
                            <th class="small py-1 bg-info bg-opacity-10">دائن (-)</th>
                            <th class="small py-1 bg-secondary bg-opacity-10">مدين (+)</th>
                            <th class="small py-1 bg-secondary bg-opacity-10">دائن (-)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="15" class="text-center py-4 text-muted">
                                    <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                    لا توجد سجلات تطابق شروط التصفية المحددة
                                </td>
                            </tr>
                        }
                        else
                        {
                            int index = 1;
                            foreach (var item in Model.Items)
                            {
                                bool isCustomer = item.PartyType == "Customer";
                                <tr>
                                    <td class="text-center text-muted">@index</td>
                                    <td class="text-center">
                                        @if (isCustomer)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                                <i class="fa-solid fa-user me-1"></i>عميل
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-50 px-2 py-1">
                                                <i class="fa-solid fa-truck me-1"></i>مورد
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center font-monospace fw-bold text-dark">@item.Code</td>
                                    <td class="text-start">
                                        <div class="fw-bold text-dark">@item.NameAr</div>
                                        @if (!string.IsNullOrWhiteSpace(item.NameEn))
                                        {
                                            <small class="text-muted d-block font-monospace">@item.NameEn</small>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.ControlAccountName))
                                        {
                                            <small class="text-secondary d-block" style="font-size: 0.75rem;">
                                                <i class="fa-solid fa-link me-1"></i>@item.ControlAccountCode - @item.ControlAccountName
                                            </small>
                                        }
                                    </td>
                                    <td class="text-center text-muted small">@item.BranchName</td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">@item.CurrencyCode</span>
                                    </td>

                                    <!-- Opening -->
                                    <td class="text-end dir-ltr">@(item.OpeningDebitLocal > 0 ? item.OpeningDebitLocal.ToString("N2") : "-")</td>
                                    <td class="text-end dir-ltr">@(item.OpeningCreditLocal > 0 ? item.OpeningCreditLocal.ToString("N2") : "-")</td>

                                    <!-- Movements -->
                                    <td class="text-end dir-ltr text-success">@(item.PeriodDebitLocal > 0 ? item.PeriodDebitLocal.ToString("N2") : "-")</td>
                                    <td class="text-end dir-ltr text-danger">@(item.PeriodCreditLocal > 0 ? item.PeriodCreditLocal.ToString("N2") : "-")</td>

                                    <!-- Closing -->
                                    <td class="text-end dir-ltr fw-bold">@(item.ClosingDebitLocal > 0 ? item.ClosingDebitLocal.ToString("N2") : "-")</td>
                                    <td class="text-end dir-ltr fw-bold">@(item.ClosingCreditLocal > 0 ? item.ClosingCreditLocal.ToString("N2") : "-")</td>

                                    <!-- Net Balance -->
                                    <td class="text-end dir-ltr fw-bold bg-light @(item.ClosingBalanceLocal > 0 ? "text-primary" : (item.ClosingBalanceLocal < 0 ? "text-danger" : "text-muted"))">
                                        @item.ClosingBalanceLocal.ToString("N2")
                                    </td>

                                    <!-- Status -->
                                    <td class="text-center">
                                        @if (Math.Abs(item.ClosingBalanceLocal) < 0.0001m)
                                        {
                                            <span class="badge bg-secondary bg-opacity-25 text-dark">متزن (0.00)</span>
                                        }
                                        else if (item.ClosingBalanceLocal > 0)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">مدين (لنا)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">دائن (علينا)</span>
                                        }
                                    </td>

                                    <!-- Action: Jump to Statement -->
                                    <td class="text-center d-print-none">
                                        @if (isCustomer)
                                        {
                                            <a asp-action="CustomerStatement" 
                                               asp-route-CustomerId="@item.PartyId" 
                                               asp-route-DateFrom="@(filter.DateFrom?.ToString("yyyy-MM-dd"))" 
                                               asp-route-DateTo="@(filter.DateTo?.ToString("yyyy-MM-dd"))" 
                                               asp-route-BranchId="@item.BranchId"
                                               class="btn btn-sm btn-outline-success p-1 px-2" 
                                               title="عرض كشف حساب العميل التفصيلي"
                                               target="_blank">
                                                <i class="fa-solid fa-file-invoice"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="VendorStatement" 
                                               asp-route-VendorId="@item.PartyId" 
                                               asp-route-DateFrom="@(filter.DateFrom?.ToString("yyyy-MM-dd"))" 
                                               asp-route-DateTo="@(filter.DateTo?.ToString("yyyy-MM-dd"))" 
                                               asp-route-BranchId="@item.BranchId"
                                               class="btn btn-sm btn-outline-warning p-1 px-2" 
                                               title="عرض كشف حساب المورد التفصيلي"
                                               target="_blank">
                                                <i class="fa-solid fa-file-invoice"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr class="align-middle">
                            <td colspan="6" class="text-center">الإجمالي العام (Total Local Currency EGP)</td>
                            <td class="text-end dir-ltr">@Model.TotalOpeningDebitLocal.ToString("N2")</td>
                            <td class="text-end dir-ltr">@Model.TotalOpeningCreditLocal.ToString("N2")</td>
                            <td class="text-end dir-ltr text-success">@Model.TotalPeriodDebitLocal.ToString("N2")</td>
                            <td class="text-end dir-ltr text-danger">@Model.TotalPeriodCreditLocal.ToString("N2")</td>
                            <td class="text-end dir-ltr">@Model.TotalClosingDebitLocal.ToString("N2")</td>
                            <td class="text-end dir-ltr">@Model.TotalClosingCreditLocal.ToString("N2")</td>
                            <td class="text-end dir-ltr @(Model.TotalClosingBalanceLocal >= 0 ? "text-primary" : "text-danger")">
                                @Model.TotalClosingBalanceLocal.ToString("N2")
                            </td>
                            <td class="text-center">-</td>
                            <td class="d-print-none"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
</div>

<script>
    function exportTableToExcel(tableId, filename) {
        var table = document.getElementById(tableId);
        if (!table) return;
        var html = table.outerHTML;
        var blob = new Blob(['\ufeff' + html], { type: 'application/vnd.ms-excel;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename + '_' + new Date().toISOString().slice(0, 10) + '.xls';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }
</script>

<style>
    .dir-ltr { direction: ltr; }
    @@media print {
        .d-print-none { display: none !important; }
        .erp-sidebar, .erp-topbar, .erp-footer { display: none !important; }
        .erp-main { margin: 0 !important; padding: 0 !important; }
        body { font-size: 10px !important; background: #fff !important; }
        .table { width: 100% !important; border: 1px solid #000 !important; }
        .table th, .table td { border: 1px solid #ddd !important; padding: 3px 5px !important; }
    }
</style>
