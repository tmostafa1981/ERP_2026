@model IEnumerable<ERP.Domain.Entities.Item>
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ERP.Web.Resources.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Items"];
    var itemGroups = ViewBag.ItemGroups as IEnumerable<ERP.Domain.Entities.ItemGroup> ?? Enumerable.Empty<ERP.Domain.Entities.ItemGroup>();
    var units = ViewBag.Units as IEnumerable<ERP.Domain.Entities.Unit> ?? Enumerable.Empty<ERP.Domain.Entities.Unit>();
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-3 border-bottom gap-2">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--erp-text-dark); font-size: 18px;">
            <i class="fa-solid fa-boxes-stacked text-primary me-2 ms-0"></i> @Localizer["Items"]
        </h4>
        <span class="text-muted" style="font-size: 12.5px;">@Localizer["ManageItems"] (@ViewBag.TotalCount)</span>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="ItemUnit" asp-action="Index" class="btn btn-erp-outline">
            <i class="fa-solid fa-layer-group me-1 ms-0"></i> @Localizer["ItemUnits"]
        </a>
        <button type="button" class="btn btn-erp-primary" data-bs-toggle="modal" data-bs-target="#createItemModal">
            <i class="fa-solid fa-plus me-1 ms-0"></i> @Localizer["AddNewItem"]
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show p-2 mb-3" role="alert" style="font-size: 12.5px;">
        <i class="fa-solid fa-circle-check me-2 ms-0"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close p-2" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show p-2 mb-3" role="alert" style="font-size: 12.5px;">
        <i class="fa-solid fa-circle-exclamation me-2 ms-0"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close p-2" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search & Filter Toolbar -->
<div class="erp-card mb-3">
    <div class="erp-card-body p-2">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4 col-lg-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control erp-form-control" placeholder="@Localizer["Search"] (@Localizer["Code"], @Localizer["Barcode"], @Localizer["NameAr"])..." />
                </div>
            </div>
            <div class="col-md-3 col-lg-3">
                <select name="itemGroupId" class="form-select form-select-sm erp-form-control">
                    <option value="">-- @Localizer["ItemGroup"] (@Localizer["All"]) --</option>
                    @foreach (var g in itemGroups)
                    {
                        <option value="@g.Id" selected="@(ViewBag.ItemGroupId != null && (int)ViewBag.ItemGroupId == g.Id)">@g.LocalizedName (@g.Code)</option>
                    }
                </select>
            </div>
            <div class="col-md-3 col-lg-2">
                <select name="isService" class="form-select form-select-sm erp-form-control">
                    <option value="">-- @Localizer["Type"] (@Localizer["All"]) --</option>
                    <option value="false" selected="@(ViewBag.IsService != null && (bool)ViewBag.IsService == false)">@Localizer["Goods"]</option>
                    <option value="true" selected="@(ViewBag.IsService != null && (bool)ViewBag.IsService == true)">@Localizer["Service"]</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-erp-primary btn-sm px-3">@Localizer["Search"]</button>
                @if (!string.IsNullOrEmpty(ViewBag.SearchString as string) || ViewBag.ItemGroupId != null || ViewBag.IsService != null)
                {
                    <a asp-action="Index" class="btn btn-erp-outline btn-sm">@Localizer["Cancel"]</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Desktop Data Grid -->
<div class="erp-table-container">
    <table class="erp-table">
        <thead>
            <tr>
                <th style="width: 100px;">@Localizer["Code"]</th>
                <th>@Localizer["NameAr"]</th>
                <th>@Localizer["NameEn"]</th>
                <th>@Localizer["ItemGroup"]</th>
                <th style="width: 90px;" class="text-center">@Localizer["Type"]</th>
                <th>@Localizer["StorageLocation"]</th>
                <th style="width: 110px;" class="text-center">@Localizer["Units"]</th>
                <th style="width: 90px;" class="text-center">@Localizer["Status"]</th>
                <th style="width: 150px;" class="text-center">@Localizer["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary">
                            @item.Code
                            @if (!string.IsNullOrEmpty(item.Barcode))
                            {
                                <div class="text-muted" style="font-size: 11px;"><i class="fa-solid fa-barcode me-1"></i>@item.Barcode</div>
                            }
                        </td>
                        <td>@item.NameAr</td>
                        <td>@item.NameEn</td>
                        <td>
                            @if (item.ItemGroup != null)
                            {
                                <span class="badge bg-light text-dark border">
                                    <i class="fa-solid fa-folder me-1"></i>@item.ItemGroup.LocalizedName
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            @if (item.IsService)
                            {
                                <span class="badge bg-warning bg-opacity-10 text-dark border border-warning-subtle px-2 py-1">
                                    <i class="fa-solid fa-hand-holding-dollar me-1"></i>@Localizer["Service"]
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-2 py-1">
                                    <i class="fa-solid fa-box me-1"></i>@Localizer["Goods"]
                                </span>
                            }
                        </td>
                        <td>
                            @(string.IsNullOrWhiteSpace(item.StorageLocation) ? "-" : item.StorageLocation)
                        </td>
                        <td class="text-center">
                            <a asp-controller="ItemUnit" asp-action="Index" asp-route-itemId="@item.Id" class="badge bg-info bg-opacity-10 text-info border border-info-subtle px-2 py-1 text-decoration-none" title="@Localizer["ManageItemUnits"]">
                                <i class="fa-solid fa-scale-balanced me-1"></i>@(item.ItemUnits?.Count ?? 0) @Localizer["Units"]
                            </a>
                        </td>
                        <td class="text-center">
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-2 py-1">@Localizer["Active"]</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle px-2 py-1">@Localizer["Inactive"]</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-controller="ItemUnit" asp-action="Index" asp-route-itemId="@item.Id" class="btn btn-erp-outline p-1 px-2" title="@Localizer["ManageItemUnits"]">
                                    <i class="fa-solid fa-scale-balanced text-secondary"></i>
                                </a>
                                <button type="button" class="btn btn-erp-outline p-1 px-2" title="@Localizer["Edit"]" data-bs-toggle="modal" data-bs-target="#editModal_@item.Id">
                                    <i class="fa-solid fa-pen-to-square text-primary"></i>
                                </button>
                                <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-erp-outline p-1 px-2" title="@(item.IsActive ? Localizer["Inactive"] : Localizer["Active"])">
                                        <i class="fa-solid @(item.IsActive ? "fa-ban text-warning" : "fa-check text-success")"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline m-0" onsubmit="return confirm('@Localizer["ConfirmDelete"]');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-erp-outline p-1 px-2" title="@Localizer["Delete"]">
                                        <i class="fa-solid fa-trash text-danger"></i>
                                    </button>
                                </form>
                            </div>

                            <!-- Edit Modal -->
                            <div class="modal fade text-start" id="editModal_@item.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-lg modal-dialog-centered">
                                    <div class="modal-content border-0 shadow">
                                        <form asp-action="Edit" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id" value="@item.Id" />
                                            <div class="modal-header bg-light py-2">
                                                <h6 class="modal-title fw-bold"><i class="fa-solid fa-pen text-primary me-2"></i> @Localizer["Edit"] - @item.LocalizedName</h6>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body p-3">
                                                <div class="row g-2">
                                                    <div class="col-md-4 mb-2">
                                                        <label class="form-label small fw-bold">@Localizer["Code"] <span class="text-danger">*</span></label>
                                                        <input type="text" name="Code" value="@item.Code" class="form-control form-control-sm" required maxlength="50" />
                                                    </div>
                                                    <div class="col-md-4 mb-2">
                                                        <label class="form-label small fw-bold">@Localizer["Barcode"]</label>
                                                        <input type="text" name="Barcode" value="@item.Barcode" class="form-control form-control-sm" maxlength="50" />
                                                    </div>
                                                    <div class="col-md-4 mb-2">
                                                        <label class="form-label small fw-bold">@Localizer["TaxCode"]</label>
                                                        <input type="text" name="TaxCode" value="@item.TaxCode" class="form-control form-control-sm" maxlength="50" />
                                                    </div>
                                                    <div class="col-md-6 mb-2">
                                                        <label class="form-label small fw-bold">@Localizer["NameAr"] <span class="text-danger">*</span></label>
                                                        <input type="text" name="NameAr" value="@item.NameAr" class="form-control form-control-sm" required maxlength="200" dir="rtl" />
                                                    </div>
                                                    <div class="col-md-6 mb-2">
                                                        <label class="form-label small fw-bold">@Localizer["NameEn"] <span class="text-danger">*</span></label>
                                                        <input type="text" name="NameEn" value="@item.NameEn" class="form-control form-control-sm" required maxlength="200" dir="ltr" />
                                                    </div>
                                                    <div class="col-md-6 mb-2">
                                                        <label class="form-label small fw-bold">@Localizer["ItemGroup"] <span class="text-danger">*</span></label>
                                                        <select name="ItemGroupId" class="form-select form-select-sm" required>
                                                            @foreach (var g in itemGroups)
                                                            {
                                                                <option value="@g.Id" selected="@(item.ItemGroupId == g.Id)">@g.LocalizedName (@g.Code)</option>
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="col-md-6 mb-2">
                                                        <label class="form-label small fw-bold">@Localizer["StorageLocation"]</label>
                                                        <input type="text" name="StorageLocation" value="@item.StorageLocation" class="form-control form-control-sm" maxlength="100" placeholder="e.g. Aisle 3, Shelf B" />
                                                    </div>
                                                    <div class="col-md-6 mt-2">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" name="IsService" value="true" @(item.IsService ? "checked" : "") id="editService_@item.Id" />
                                                            <label class="form-check-label small" for="editService_@item.Id">@Localizer["IsService"]</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 mt-2">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" name="IsActive" value="true" @(item.IsActive ? "checked" : "") id="editItemActive_@item.Id" />
                                                            <label class="form-check-label small" for="editItemActive_@item.Id">@Localizer["Active"]</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer py-2 bg-light">
                                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                                                <button type="submit" class="btn btn-sm btn-erp-primary">@Localizer["Save"]</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center py-4 text-muted">@Localizer["NoDataFound"]</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewBag.SearchString" asp-route-itemGroupId="@ViewBag.ItemGroupId" asp-route-isService="@ViewBag.IsService">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<!-- Create Modal -->
<div class="modal fade" id="createItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light py-2">
                    <h6 class="modal-title fw-bold"><i class="fa-solid fa-plus text-primary me-2"></i> @Localizer["AddNewItem"]</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="row g-2">
                        <div class="col-md-4 mb-2">
                            <label class="form-label small fw-bold">@Localizer["Code"] <span class="text-danger">*</span></label>
                            <input type="text" name="Code" class="form-control form-control-sm" required maxlength="50" placeholder="ITM-0001" />
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="form-label small fw-bold">@Localizer["Barcode"]</label>
                            <input type="text" name="Barcode" class="form-control form-control-sm" maxlength="50" placeholder="622000000001" />
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="form-label small fw-bold">@Localizer["TaxCode"]</label>
                            <input type="text" name="TaxCode" class="form-control form-control-sm" maxlength="50" placeholder="EG-TAX-01" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label small fw-bold">@Localizer["NameAr"] <span class="text-danger">*</span></label>
                            <input type="text" name="NameAr" class="form-control form-control-sm" required maxlength="200" dir="rtl" placeholder="شاشة سامسونج 24 بوصة" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label small fw-bold">@Localizer["NameEn"] <span class="text-danger">*</span></label>
                            <input type="text" name="NameEn" class="form-control form-control-sm" required maxlength="200" dir="ltr" placeholder="Samsung Monitor 24 Inch" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label small fw-bold">@Localizer["ItemGroup"] <span class="text-danger">*</span></label>
                            <select name="ItemGroupId" class="form-select form-select-sm" required>
                                <option value="">-- @Localizer["Select"] --</option>
                                @foreach (var g in itemGroups)
                                {
                                    <option value="@g.Id">@g.LocalizedName (@g.Code)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label small fw-bold">@Localizer["StorageLocation"]</label>
                            <input type="text" name="StorageLocation" class="form-control form-control-sm" maxlength="100" placeholder="e.g. Shelf A-1" />
                        </div>

                        <!-- Initial Base Unit Config -->
                        <div class="col-12 mt-2">
                            <div class="card border bg-light">
                                <div class="card-body p-2">
                                    <div class="fw-bold small text-primary mb-2">
                                        <i class="fa-solid fa-ruler-combined me-1"></i> @Localizer["BaseUnit"] (@Localizer["Optional"])
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <label class="form-label small">@Localizer["Unit"]</label>
                                            <select name="baseUnitId" class="form-select form-select-sm">
                                                <option value="">-- @Localizer["None"] --</option>
                                                @foreach (var u in units)
                                                {
                                                    <option value="@u.Id">@u.LocalizedName (@u.Code)</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">@Localizer["SalesPrice"]</label>
                                            <input type="number" step="0.0001" min="0" name="salesPrice" value="0.00" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">@Localizer["PurchasePrice"]</label>
                                            <input type="number" step="0.0001" min="0" name="purchasePrice" value="0.00" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 mt-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsService" value="true" id="createItemService" />
                                <label class="form-check-label small" for="createItemService">@Localizer["IsService"]</label>
                            </div>
                        </div>
                        <div class="col-md-6 mt-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="createItemActive" />
                                <label class="form-check-label small" for="createItemActive">@Localizer["Active"]</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-light">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-sm btn-erp-primary">@Localizer["Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
