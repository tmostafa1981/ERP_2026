@model ERP.Application.DTOs.FixedAssets.CreateFixedAssetDto
@{
    ViewData["Title"] = "إضافة أصل ثابت جديد";
}

<div class="container-fluid py-3">
    <form asp-action="Create" method="post" id="assetForm">
        @Html.AntiForgeryToken()
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="mb-1 text-primary"><i class="fas fa-plus-circle me-2"></i>إضافة أصل ثابت جديد</h3>
                <p class="text-muted small mb-0">تسجيل بيانات الأصل، تكلفة الشراء، حسابات التوجيه وطريقة الإهلاك، أو إدخال رصيد افتتاحي</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-1"></i>حفظ الأصل</button>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

        <div class="row g-3">
            <!-- Left Column: Core & Location -->
            <div class="col-lg-8">
                <!-- 1. Basic Data -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-light py-2 fw-bold text-dark">
                        <i class="fas fa-info-circle me-1 text-primary"></i>1. البيانات الأساسية
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label asp-for="AssetCode" class="form-label small fw-bold">كود الأصل (تلقائي)</label>
                                <input asp-for="AssetCode" class="form-control form-control-sm" placeholder="يولد آلياً إذا ترك فارغاً" />
                                <span asp-validation-for="AssetCode" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="NameAr" class="form-label small fw-bold">اسم الأصل (عربي) <span class="text-danger">*</span></label>
                                <input asp-for="NameAr" class="form-control form-control-sm" required placeholder="مثال: سيارة نقل تويوتا هايلكس" />
                                <span asp-validation-for="NameAr" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="NameEn" class="form-label small fw-bold">اسم الأصل (إنجليزي)</label>
                                <input asp-for="NameEn" class="form-control form-control-sm" placeholder="Toyota Hilux Pickup" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AssetCategoryId" class="form-label small fw-bold">تصنيف / مجموعة الأصل <span class="text-danger">*</span></label>
                                <select asp-for="AssetCategoryId" class="form-select form-select-sm" asp-items="ViewBag.Categories" required>
                                    <option value="">-- اختر مجموعة الأصل --</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Status" class="form-label small fw-bold">حالة الأصل</label>
                                <select asp-for="Status" class="form-select form-select-sm">
                                    <option value="2">في الخدمة / قيد التشغيل (In Service)</option>
                                    <option value="3">تحت الإنشاء / تجهيز (CIP)</option>
                                    <option value="1">جديد</option>
                                    <option value="4">متوقف</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="SerialNumber" class="form-label small fw-bold">الرقم التسلسلي Serial Number</label>
                                <input asp-for="SerialNumber" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Barcode" class="form-label small fw-bold">الباركود Barcode</label>
                                <input asp-for="Barcode" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-8">
                                <label asp-for="Description" class="form-label small">الوصف والتفاصيل</label>
                                <input asp-for="Description" class="form-control form-control-sm" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Location & Custody -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-light py-2 fw-bold text-dark">
                        <i class="fas fa-map-marker-alt me-1 text-primary"></i>2. الموقع والعهدة والمسؤولية
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="BranchId" class="form-label small fw-bold">الفرع المسؤول <span class="text-danger">*</span></label>
                                <select asp-for="BranchId" class="form-select form-select-sm" asp-items="ViewBag.Branches" required></select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="WarehouseId" class="form-label small">الموقع / المخزن</label>
                                <select asp-for="WarehouseId" class="form-select form-select-sm" asp-items="ViewBag.Warehouses">
                                    <option value="">-- اختياري --</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="CostCenterId" class="form-label small">مركز التكلفة</label>
                                <select asp-for="CostCenterId" class="form-select form-select-sm" asp-items="ViewBag.CostCenters">
                                    <option value="">-- اختياري --</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Department" class="form-label small">القسم أو الإدارة</label>
                                <input asp-for="Department" class="form-control form-control-sm" placeholder="مثال: إدارة المبيعات والتوزيع" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CustodianEmployeeName" class="form-label small">الموظف المسؤول (العهدة)</label>
                                <input asp-for="CustodianEmployeeName" class="form-control form-control-sm" placeholder="مثال: أحمد محمود" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Valuation & Purchasing -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-light py-2 fw-bold text-dark">
                        <i class="fas fa-dollar-sign me-1 text-primary"></i>3. بيانات الشراء والتكلفة
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="PurchaseDate" class="form-label small fw-bold">تاريخ الشراء <span class="text-danger">*</span></label>
                                <input asp-for="PurchaseDate" type="date" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="PlacedInServiceDate" class="form-label small fw-bold">تاريخ بدء الاستخدام / التشغيل</label>
                                <input asp-for="PlacedInServiceDate" type="date" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="VendorId" class="form-label small">المورد</label>
                                <select asp-for="VendorId" class="form-select form-select-sm" asp-items="ViewBag.Vendors">
                                    <option value="">-- اختياري --</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="CurrencyId" class="form-label small fw-bold">العملة</label>
                                <select asp-for="CurrencyId" class="form-select form-select-sm" asp-items="ViewBag.Currencies"></select>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="PurchasePriceForeign" class="form-label small">السعر بالعملة الأجنبية</label>
                                <input asp-for="PurchasePriceForeign" type="number" step="0.0001" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-2">
                                <label asp-for="ExchangeRate" class="form-label small">سعر الصرف</label>
                                <input asp-for="ExchangeRate" type="number" step="0.000001" class="form-control form-control-sm" value="1.0" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="InitialCostLocal" class="form-label small fw-bold">تكلفة الشراء بالعملة المحلية <span class="text-danger">*</span></label>
                                <input asp-for="InitialCostLocal" type="number" step="0.01" class="form-control form-control-sm fw-bold" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AdditionalExpensesLocal" class="form-label small">مصاريف إضافية تدخل في التكلفة</label>
                                <input asp-for="AdditionalExpensesLocal" type="number" step="0.01" class="form-control form-control-sm" value="0.0" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ResidualValue" class="form-label small fw-bold">القيمة التخريدية (الخردة)</label>
                                <input asp-for="ResidualValue" type="number" step="0.01" class="form-control form-control-sm" value="0.0" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="PurchaseInvoiceReference" class="form-label small">رقم الفاتورة المرجعي</label>
                                <input asp-for="PurchaseInvoiceReference" class="form-control form-control-sm" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4. Opening Balances (For existing assets) -->
                <div class="card border-0 shadow-sm border-start border-4 border-warning mb-3">
                    <div class="card-header bg-warning bg-opacity-10 py-2 fw-bold text-dark">
                        <i class="fas fa-history me-1 text-warning"></i>4. تسجيل أصل قديم برصيد افتتاحي (سابق لبدء النظام)
                    </div>
                    <div class="card-body p-3">
                        <div class="form-check form-switch mb-3">
                            <input asp-for="IsOpeningAsset" class="form-check-input" type="checkbox" id="chkIsOpening" onchange="toggleOpeningFields()" />
                            <label class="form-check-label fw-bold" for="chkIsOpening">هذا أصل قديم موجود مسبقاً وله مجمع إهلاك سابق</label>
                        </div>
                        <div class="row g-3" id="openingFields" style="display:none;">
                            <div class="col-md-6">
                                <label asp-for="OpeningAccumulatedDepreciation" class="form-label small fw-bold text-danger">مجمع الإهلاك السابق / الافتتاحي</label>
                                <input asp-for="OpeningAccumulatedDepreciation" type="number" step="0.01" class="form-control form-control-sm" value="0.0" />
                                <div class="form-text small">إجمالي ما تم إهلاكه من الأصل في السنوات السابقة قبل تشغيل النظام.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-primary">القيمة الدفترية الافتتاحية المحسوبة</label>
                                <input type="text" id="calculatedCarrying" class="form-control form-control-sm fw-bold bg-light" readonly value="0.00" />
                                <div class="form-text small">التكلفة التاريخية − مجمع الإهلاك السابق.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Depreciation Engine & Accounts -->
            <div class="col-lg-4">
                <!-- Depreciation Parameters -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-light py-2 fw-bold text-dark">
                        <i class="fas fa-calculator me-1 text-primary"></i>طريقة ومعايير الإهلاك
                    </div>
                    <div class="card-body p-3">
                        <div class="mb-3">
                            <label asp-for="DepreciationMethod" class="form-label small fw-bold">طريقة الإهلاك</label>
                            <select asp-for="DepreciationMethod" class="form-select form-select-sm">
                                <option value="1">القسط الثابت (Straight Line)</option>
                                <option value="2">القسط المتناقص (Declining Balance)</option>
                                <option value="3">وحدات الإنتاج (Units of Production)</option>
                                <option value="4">بدون إهلاك (مثل الأراضي)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="UsefulLifeMonths" class="form-label small fw-bold">العمر الإنتاجي (بالأشهر)</label>
                            <input asp-for="UsefulLifeMonths" type="number" class="form-control form-control-sm" min="0" />
                            <div class="form-text small">60 شهر = 5 سنوات، 120 شهر = 10 سنوات</div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="DepreciationStartDate" class="form-label small fw-bold">تاريخ بداية الإهلاك</label>
                            <input asp-for="DepreciationStartDate" type="date" class="form-control form-control-sm" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="FirstMonthPolicy" class="form-label small fw-bold">سياسة احتساب أول شهر</label>
                            <select asp-for="FirstMonthPolicy" class="form-select form-select-sm">
                                <option value="1">شهر كامل (Full Month)</option>
                                <option value="2">حسب الأيام الفعلية (Pro Rata)</option>
                                <option value="3">بداية من الشهر التالي (Next Month)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="DepreciationRate" class="form-label small">نسبة الإهلاك السنوية % (للقسط المتناقص)</label>
                            <input asp-for="DepreciationRate" type="number" step="0.01" class="form-control form-control-sm" value="0.0" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="TotalExpectedUnits" class="form-label small">إجمالي الوحدات المتوقعة (لوحدات الإنتاج)</label>
                            <input asp-for="TotalExpectedUnits" type="number" step="1" class="form-control form-control-sm" value="0" />
                        </div>
                    </div>
                </div>

                <!-- Custom Account Overrides -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-light py-2 fw-bold text-dark">
                        <i class="fas fa-book me-1 text-primary"></i>تخصيص الحسابات (اختياري)
                    </div>
                    <div class="card-body p-3">
                        <p class="text-muted small mb-3">إذا تركت هذه الحسابات فارغة، سيتم استخدام الحسابات الافتراضية المعرفة في مجموعة الأصل تلقائياً.</p>
                        <div class="mb-2">
                            <label asp-for="AssetCostAccountId" class="form-label small">حساب تكلفة الأصل</label>
                            <select asp-for="AssetCostAccountId" class="form-select form-select-sm" asp-items="ViewBag.Accounts">
                                <option value="">-- الافتراضي من المجموعة --</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label asp-for="AccumulatedDepreciationAccountId" class="form-label small">حساب مجمع الإهلاك</label>
                            <select asp-for="AccumulatedDepreciationAccountId" class="form-select form-select-sm" asp-items="ViewBag.Accounts">
                                <option value="">-- الافتراضي من المجموعة --</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label asp-for="DepreciationExpenseAccountId" class="form-label small">حساب مصروف الإهلاك</label>
                            <select asp-for="DepreciationExpenseAccountId" class="form-select form-select-sm" asp-items="ViewBag.Accounts">
                                <option value="">-- الافتراضي من المجموعة --</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Notes -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body p-3">
                        <label asp-for="Notes" class="form-label small fw-bold">ملاحظات إضافية</label>
                        <textarea asp-for="Notes" class="form-control form-control-sm" rows="3"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    function toggleOpeningFields() {
        const isChecked = document.getElementById('chkIsOpening').checked;
        document.getElementById('openingFields').style.display = isChecked ? 'flex' : 'none';
        calcCarrying();
    }

    function calcCarrying() {
        const cost = parseFloat(document.getElementById('InitialCostLocal').value) || 0;
        const addExp = parseFloat(document.getElementById('AdditionalExpensesLocal').value) || 0;
        const accDep = parseFloat(document.getElementById('OpeningAccumulatedDepreciation').value) || 0;
        const net = Math.max(0, (cost + addExp) - accDep);
        document.getElementById('calculatedCarrying').value = net.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    document.getElementById('InitialCostLocal')?.addEventListener('input', calcCarrying);
    document.getElementById('AdditionalExpensesLocal')?.addEventListener('input', calcCarrying);
    document.getElementById('OpeningAccumulatedDepreciation')?.addEventListener('input', calcCarrying);
</script>
