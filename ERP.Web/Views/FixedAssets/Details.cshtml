@model ERP.Application.DTOs.FixedAssets.FixedAssetDetailsDto
@{
    ViewData["Title"] = "كارت الأصل: " + Model.AssetCode;
}

<div class="container-fluid py-3">
    <!-- Top Action Bar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h3 class="mb-0 text-primary"><i class="fas fa-cube me-2"></i>@Model.LocalizedName</h3>
                <span class="badge bg-secondary fs-6">@Model.AssetCode</span>
                @{
                    var statusBadge = Model.Status switch {
                        ERP.Domain.Enums.AssetStatus.InService => "bg-success",
                        ERP.Domain.Enums.AssetStatus.UnderConstruction => "bg-warning text-dark",
                        ERP.Domain.Enums.AssetStatus.Disposed => "bg-danger",
                        ERP.Domain.Enums.AssetStatus.Suspended => "bg-secondary",
                        _ => "bg-info text-dark"
                    };
                }
                <span class="badge @statusBadge fs-6">@Model.StatusName</span>
                @if (Model.IsFullyDepreciated)
                {
                    <span class="badge bg-dark">مستهلك بالكامل</span>
                }
            </div>
            <p class="text-muted small mb-0 mt-1">المجموعة: <span class="fw-bold">@Model.CategoryName</span> | الفرع: <span class="fw-bold">@Model.BranchName</span></p>
        </div>
        <div class="d-flex gap-2">
            @if (Model.Status != ERP.Domain.Enums.AssetStatus.Disposed)
            {
                <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#transferModal">
                    <i class="fas fa-exchange-alt me-1"></i>نقل / تغيير عهدة
                </button>
                <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#additionalCostModal">
                    <i class="fas fa-plus-circle me-1"></i>إضافة تكلفة
                </button>
                @if (Model.Status == ERP.Domain.Enums.AssetStatus.UnderConstruction)
                {
                    <button type="button" class="btn btn-outline-warning text-dark" data-bs-toggle="modal" data-bs-target="#capitalizeModal">
                        <i class="fas fa-check-double me-1"></i>تشغيل وتحويل الأصل
                    </button>
                }
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#disposalModal">
                    <i class="fas fa-times-circle me-1"></i>استبعاد / بيع
                </button>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                    <i class="fas fa-edit me-1"></i>تعديل
                </a>
            }
            <button onclick="window.print()" class="btn btn-outline-secondary">
                <i class="fas fa-print me-1"></i>طباعة
            </button>
            <a asp-action="Index" class="btn btn-secondary">العودة</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-1"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-1"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Quick Financial Metrics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body py-3">
                    <div class="text-muted small">التكلفة التاريخية الرأسمالية</div>
                    <h4 class="mb-0 fw-bold text-dark">@Model.CurrentCostLocal.ToString("N2") <small class="text-muted fs-6">@Model.CurrencyCode</small></h4>
                    @if (Model.AdditionalExpensesLocal > 0)
                    {
                        <div class="small text-muted mt-1">شامل مصاريف رأسمالية: @Model.AdditionalExpensesLocal.ToString("N2")</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body py-3">
                    <div class="text-muted small">مجمع الإهلاك المتراكم</div>
                    <h4 class="mb-0 fw-bold text-warning">@Model.CurrentAccumulatedDepreciation.ToString("N2") <small class="text-muted fs-6">@Model.CurrencyCode</small></h4>
                    <div class="small text-muted mt-1">تاريخ آخر إهلاك: @(Model.LastDepreciationDate?.ToString("yyyy-MM-dd") ?? "لم يستهلك بعد")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body py-3">
                    <div class="text-muted small">صافي القيمة الدفترية الحالية</div>
                    <h4 class="mb-0 fw-bold text-primary">@Model.CurrentBookValue.ToString("N2") <small class="text-muted fs-6">@Model.CurrencyCode</small></h4>
                    <div class="small text-muted mt-1">القيمة التخريدية (الخردة): @Model.ResidualValue.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body py-3">
                    <div class="text-muted small">معايير الإهلاك</div>
                    <h5 class="mb-0 fw-bold text-secondary">@Model.DepreciationMethodName</h5>
                    <div class="small text-muted mt-1">العمر: @Model.UsefulLifeMonths شهر (@(Model.UsefulLifeMonths / 12) سنة) | السياسة: @Model.FirstMonthPolicyName</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Nav Tabs -->
    <ul class="nav nav-tabs mb-3" id="assetTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab">
                <i class="fas fa-info-circle me-1"></i>تفاصيل الأصل والتوجيه المحاسبي
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="dep-tab" data-bs-toggle="tab" data-bs-target="#dep" type="button" role="tab">
                <i class="fas fa-calculator me-1"></i>سجل الإهلاكات الدورية (@Model.DepreciationHistories.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="movements-tab" data-bs-toggle="tab" data-bs-target="#movements" type="button" role="tab">
                <i class="fas fa-history me-1"></i>سجل الحركات والتنقلات (@Model.Transactions.Count)
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="assetTabContent">
        <!-- Tab 1: General Info -->
        <div class="tab-pane fade show active" id="info" role="tabpanel">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-light fw-bold">البيانات الفنية وموقع الأصل</div>
                        <div class="card-body">
                            <table class="table table-sm table-borderless mb-0">
                                <tr><th class="w-35 text-muted">اسم الأصل بالعربي:</th><td class="fw-bold">@Model.NameAr</td></tr>
                                <tr><th class="text-muted">اسم الأصل بالإنجليزي:</th><td>@(Model.NameEn ?? "—")</td></tr>
                                <tr><th class="text-muted">الرقم التسلسلي:</th><td>@(Model.SerialNumber ?? "—")</td></tr>
                                <tr><th class="text-muted">الباركود:</th><td>@(Model.Barcode ?? "—")</td></tr>
                                <tr><th class="text-muted">الفرع الحالي:</th><td><span class="badge bg-secondary">@Model.BranchName</span></td></tr>
                                <tr><th class="text-muted">الموقع / المخزن:</th><td>@(Model.WarehouseName ?? "—")</td></tr>
                                <tr><th class="text-muted">مركز التكلفة:</th><td>@(Model.CostCenterName ?? "—")</td></tr>
                                <tr><th class="text-muted">القسم / الإدارة:</th><td>@(Model.Department ?? "—")</td></tr>
                                <tr><th class="text-muted">الموظف المسؤول (العهدة):</th><td class="fw-bold text-primary">@(Model.CustodianEmployeeName ?? "—")</td></tr>
                                <tr><th class="text-muted">الوصف / الملاحظات:</th><td>@(Model.Description ?? "—")</td></tr>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-light fw-bold">بيانات الشراء والتوريد</div>
                        <div class="card-body">
                            <table class="table table-sm table-borderless mb-0">
                                <tr><th class="w-35 text-muted">تاريخ الشراء:</th><td>@Model.PurchaseDate.ToString("yyyy-MM-dd")</td></tr>
                                <tr><th class="text-muted">تاريخ بدء الاستخدام:</th><td>@(Model.PlacedInServiceDate?.ToString("yyyy-MM-dd") ?? "—")</td></tr>
                                <tr><th class="text-muted">تاريخ بداية الإهلاك:</th><td>@(Model.DepreciationStartDate?.ToString("yyyy-MM-dd") ?? "—")</td></tr>
                                <tr><th class="text-muted">المورد:</th><td>@(Model.VendorName ?? "—")</td></tr>
                                <tr><th class="text-muted">رقم فاتورة الشراء:</th><td>@(Model.PurchaseDocumentNumber ?? Model.PurchaseInvoiceReference ?? "—")</td></tr>
                                <tr><th class="text-muted">عملة الشراء:</th><td>@Model.CurrencyCode (سعر الصرف: @Model.ExchangeRate.ToString("N4"))</td></tr>
                                <tr><th class="text-muted">السعر بالعملة الأجنبية:</th><td>@Model.PurchasePriceForeign.ToString("N2")</td></tr>
                                <tr><th class="text-muted">التكلفة التاريخية المحلية:</th><td class="fw-bold">@Model.InitialCostLocal.ToString("N2")</td></tr>
                                <tr><th class="text-muted">مصاريف إضافية مرسملة:</th><td>@Model.AdditionalExpensesLocal.ToString("N2")</td></tr>
                                <tr><th class="text-muted">القيمة التخريدية:</th><td>@Model.ResidualValue.ToString("N2")</td></tr>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Accounts Mapping -->
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light fw-bold">التوجيه والحسابات المحاسبية المرتبطة</div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="small text-muted d-block">حساب تكلفة الأصل (أصول ثابتة)</label>
                                    <span class="fw-bold text-dark">@Model.AssetCostAccountName</span>
                                </div>
                                <div class="col-md-4">
                                    <label class="small text-muted d-block">حساب مجمع الإهلاك (خصوم/أصول دائنة)</label>
                                    <span class="fw-bold text-dark">@Model.AccumulatedDepreciationAccountName</span>
                                </div>
                                <div class="col-md-4">
                                    <label class="small text-muted d-block">حساب مصروف الإهلاك (مصروفات)</label>
                                    <span class="fw-bold text-dark">@Model.DepreciationExpenseAccountName</span>
                                </div>
                                <div class="col-md-6">
                                    <label class="small text-muted d-block">حساب أرباح استبعاد الأصول (إيرادات)</label>
                                    <span class="fw-bold text-dark">@Model.DisposalGainAccountName</span>
                                </div>
                                <div class="col-md-6">
                                    <label class="small text-muted d-block">حساب خسائر استبعاد الأصول (مصروفات)</label>
                                    <span class="fw-bold text-dark">@Model.DisposalLossAccountName</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.Status == ERP.Domain.Enums.AssetStatus.Disposed)
                {
                    <div class="col-12">
                        <div class="card border-danger border-2 shadow-sm bg-danger bg-opacity-10">
                            <div class="card-body">
                                <h6 class="text-danger fw-bold"><i class="fas fa-ban me-1"></i>بيانات استبعاد وبيع الأصل</h6>
                                <div class="row g-2 mt-2">
                                    <div class="col-md-3"><strong>تاريخ الاستبعاد:</strong> @Model.DisposalDate?.ToString("yyyy-MM-dd")</div>
                                    <div class="col-md-3"><strong>متحصلات البيع:</strong> @(Model.DisposalProceeds?.ToString("N2") ?? "0.00")</div>
                                    <div class="col-md-3"><strong>سبب الاستبعاد:</strong> @Model.DisposalReason</div>
                                    <div class="col-md-3"><strong>قيد الاستبعاد:</strong> @(Model.DisposalJournalEntryNumber ?? "مسجل")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Tab 2: Depreciation Histories -->
        <div class="tab-pane fade" id="dep" role="tabpanel">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 text-center">
                            <thead class="table-light">
                                <tr>
                                    <th>تاريخ الإهلاك</th>
                                    <th>رقم تشغيل الإهلاك</th>
                                    <th>التكلفة وقت التشغيل</th>
                                    <th>مجمع الإهلاك السابق</th>
                                    <th>قسط الإهلاك الحالي</th>
                                    <th>مجمع الإهلاك اللاحق</th>
                                    <th>القيمة الدفترية بعد الإهلاك</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.DepreciationHistories == null || !Model.DepreciationHistories.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-muted py-4">لم يتم تسجيل أي عمليات إهلاك دورية لهذا الأصل حتى الآن.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var h in Model.DepreciationHistories)
                                    {
                                        <tr>
                                            <td>@h.DepreciationDate.ToString("yyyy-MM-dd")</td>
                                            <td><span class="badge bg-secondary">@h.RunNumber</span></td>
                                            <td>@h.AssetCostAtRun.ToString("N2")</td>
                                            <td class="text-muted">@h.PriorAccumulatedDepreciation.ToString("N2")</td>
                                            <td class="fw-bold text-success">@h.DepreciationAmount.ToString("N2")</td>
                                            <td class="text-warning">@h.PostAccumulatedDepreciation.ToString("N2")</td>
                                            <td class="fw-bold text-primary">@h.BookValueAfter.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 3: Transactions & Movements -->
        <div class="tab-pane fade" id="movements" role="tabpanel">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 text-center">
                            <thead class="table-light">
                                <tr>
                                    <th>التاريخ</th>
                                    <th>نوع الحركة</th>
                                    <th>من فرع</th>
                                    <th>إلى فرع</th>
                                    <th>العهدة / المسؤول</th>
                                    <th>المبلغ</th>
                                    <th>رقم القيد</th>
                                    <th>السبب / البيان</th>
                                    <th>المستخدم</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Transactions == null || !Model.Transactions.Any())
                                {
                                    <tr>
                                        <td colspan="9" class="text-muted py-4">لا توجد حركات مسجلة على هذا الأصل.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var t in Model.Transactions)
                                    {
                                        <tr>
                                            <td>@t.TransactionDate.ToString("yyyy-MM-dd")</td>
                                            <td><span class="badge bg-info text-dark">@t.TransactionTypeName</span></td>
                                            <td>@(t.FromBranchName ?? "—")</td>
                                            <td>@(t.ToBranchName ?? "—")</td>
                                            <td>@(t.ToCustodian ?? t.FromCustodian ?? "—")</td>
                                            <td>@(t.Amount > 0 ? t.Amount.ToString("N2") : "—")</td>
                                            <td>@(t.JournalEntryNumber != null ? t.JournalEntryNumber : "—")</td>
                                            <td class="text-start">@t.Reason</td>
                                            <td class="small text-muted">@t.CreatedByUserName</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal 1: Transfer Asset -->
<div class="modal fade" id="transferModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Transfer" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="AssetId" value="@Model.Id" />
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title"><i class="fas fa-exchange-alt me-2"></i>نقل الأصل / تغيير العهدة والموقع</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">الفرع المحول إليه <span class="text-danger">*</span></label>
                        <select name="ToBranchId" class="form-select form-select-sm" asp-items="ViewBag.Branches" required></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">الموقع / المخزن الجديد</label>
                        <select name="ToWarehouseId" class="form-select form-select-sm" asp-items="ViewBag.Warehouses">
                            <option value="">-- اختياري --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">مركز التكلفة الجديد</label>
                        <select name="ToCostCenterId" class="form-select form-select-sm" asp-items="ViewBag.CostCenters">
                            <option value="">-- اختياري --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">القسم الجديد</label>
                        <input type="text" name="ToDepartment" class="form-control form-control-sm" placeholder="مثال: إدارة الإنتاج" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">الموظف المسؤول الجديد (العهدة)</label>
                        <input type="text" name="ToCustodian" class="form-control form-control-sm" placeholder="اسم المستلم" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">تاريخ النقل</label>
                        <input type="date" name="TransferDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">سبب النقل</label>
                        <textarea name="Reason" class="form-control form-control-sm" rows="2" placeholder="ملاحظات أو مبررات النقل"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-info text-white">تأكيد عملية النقل</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: Additional Cost -->
<div class="modal fade" id="additionalCostModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AdditionalCost" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="AssetId" value="@Model.Id" />
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="fas fa-plus-circle me-2"></i>إضافة تكلفة لاحقة على الأصل</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">مبلغ التكلفة <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" name="Amount" class="form-control form-control-sm fw-bold" required min="0.01" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">نوع المعاملة المحاسبية</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="IsCapitalized" id="capTrue" value="true" checked>
                            <label class="form-check-label small" for="capTrue">
                                <strong>رسملة على الأصل (Capitalization):</strong> تزيد التكلفة التاريخية والقيمة الدفترية للأصل.
                            </label>
                        </div>
                        <div class="form-check mt-1">
                            <input class="form-check-input" type="radio" name="IsCapitalized" id="capFalse" value="false">
                            <label class="form-check-label small" for="capFalse">
                                <strong>مصروف مباشر (Expense):</strong> مصروف صيانة أو تحسينات دورية لا تزيد تكلفة الأصل.
                            </label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">حساب الدفع / السداد (صندوق / بنك)</label>
                        <select name="CashBankAccountId" class="form-select form-select-sm" asp-items="ViewBag.CashAccounts"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">تاريخ المعاملة</label>
                        <input type="date" name="TransactionDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">البيان / الفاتورة</label>
                        <textarea name="Reason" class="form-control form-control-sm" rows="2" placeholder="بيان التكلفة أو أعمال الصيانة"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-success">تسجيل التكلفة وترحيل القيد</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 3: Disposal Asset -->
<div class="modal fade" id="disposalModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="DisposeAsset" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="AssetId" value="@Model.Id" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="fas fa-times-circle me-2"></i>استبعاد أو بيع الأصل الثابت</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning small">
                        <strong>تنبيه:</strong> سيتم إيقاف إهلاك هذا الأصل نهائياً، وإقفال تكلفته التاريخية ومجمع إهلاكه، وتسجيل قيد أرباح أو خسائر الاستبعاد تلقائياً في الأستاذ العام.
                    </div>
                    <div class="row g-2 mb-3 bg-light p-2 rounded">
                        <div class="col-6 small">التكلفة التاريخية: <span class="fw-bold">@Model.CurrentCostLocal.ToString("N2")</span></div>
                        <div class="col-6 small">مجمع الإهلاك: <span class="fw-bold">@Model.CurrentAccumulatedDepreciation.ToString("N2")</span></div>
                        <div class="col-12 small text-primary">صافي القيمة الدفترية: <span class="fw-bold">@Model.CurrentBookValue.ToString("N2")</span></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">سعر البيع / المتحصلات (إن وجد)</label>
                        <input type="number" step="0.01" name="ProceedsAmount" class="form-control form-control-sm" value="0.00" min="0" />
                        <div class="form-text small">إذا كان استبعاد خردة بدون عائد، اتركه 0.00.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">حساب تحصيل قيمة البيع (صندوق / بنك)</label>
                        <select name="ProceedsCashBankAccountId" class="form-select form-select-sm" asp-items="ViewBag.CashAccounts"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">تاريخ الاستبعاد</label>
                        <input type="date" name="DisposalDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">سبب الاستبعاد</label>
                        <textarea name="Reason" class="form-control form-control-sm" rows="2" placeholder="مثال: بيع كخردة لانتهاء الصلاحية"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-danger">تأكيد الاستبعاد وترحيل القيد</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 4: Capitalize CIP Asset -->
@if (Model.Status == ERP.Domain.Enums.AssetStatus.UnderConstruction)
{
    <div class="modal fade" id="capitalizeModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="CapitalizeCip" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="AssetId" value="@Model.Id" />
                    <div class="modal-header bg-warning text-dark">
                        <h5 class="modal-title"><i class="fas fa-check-double me-2"></i>تشغيل وتحويل أصل تحت الإنشاء (CIP)</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-info small">
                            سيتم تحويل حالة الأصل من "تحت الإنشاء" إلى "في الخدمة"، وبدء احتساب الإهلاك الدوري اعتباراً من تاريخ التشغيل، ونقل التكلفة من حساب مشروعات تحت التنفيذ إلى حساب الأصول الثابتة.
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">تاريخ التحويل والجاهزية للاستخدام</label>
                            <input type="date" name="CapitalizationDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">تاريخ بداية الإهلاك</label>
                            <input type="date" name="DepreciationStartDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">العمر الإنتاجي المعتمد (بالأشهر)</label>
                            <input type="number" name="UsefulLifeMonths" class="form-control form-control-sm" value="@(Model.UsefulLifeMonths > 0 ? Model.UsefulLifeMonths : 60)" min="1" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">القيمة التخريدية المتوقعة</label>
                            <input type="number" step="0.01" name="ResidualValue" class="form-control form-control-sm" value="@Model.ResidualValue" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small">ملاحظات</label>
                            <textarea name="Notes" class="form-control form-control-sm" rows="2" placeholder="محضر الاستلام والتشغيل"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-warning text-dark">تأكيد التشغيل وترحيل قيد التحويل</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
