@section Scripts {
<script>
    function onVendorBranchChanged() {
        var branchId = $('#createVendorBranch').val();
        if (!branchId) return;

        $.getJSON('/api/sequence/preview', { entity: 'Vendor', branchId: branchId }, function (data) {
            if (data && data.code) {
                var codeInput = $('#createVendorCode');
                if (codeInput.prop('readonly')) {
                    codeInput.val(data.code);
                }
            }
        });

        $.getJSON('/VendorCategory/GetByBranch', { branchId: branchId }, function (cats) {
            if (Array.isArray(cats) && cats.length > 0) {
                var defCat = cats.find(function (c) { return c.isDefault; }) || cats[0];
                if (defCat) {
                    var $catSelect = $('#createVendorCategory');
                    var label = defCat.code + ' - ' + defCat.name + (defCat.isDefault ? ' (افتراضي)' : '');
                    var newOpt = new Option(label, defCat.id, true, true);
                    $catSelect.empty().append('<option value="">-- @Localizer["SelectOption"] --</option>').append(newOpt).trigger('change');

                    var pickerEl = document.getElementById('createVendorFinancialAccountPicker');
                    if (pickerEl && window.ErpLookup && typeof window.ErpLookup.setPickerValue === 'function') {
                        window.ErpLookup.setPickerValue(pickerEl, defCat.controlAccountId || '', defCat.controlAccountDisplay || '');
                    }
                }
            }
        });
    }

    function toggleManualVendorCode() {
        $('#createVendorIsManualCode').val('true');
        $('#createVendorCode').removeAttr('readonly').focus();
        $('#btnToggleManualVendorCode').hide();
        $('#autoVendorCodeBadge').hide();
    }

    $('#createVendorModal').on('show.bs.modal', function () {
        $('#createVendorIsManualCode').val('false');
        $('#createVendorCode').prop('readonly', true);
        $('#btnToggleManualVendorCode').show();
        $('#autoVendorCodeBadge').show();
        onVendorBranchChanged();
    });

    // When Vendor Category is selected in Create or Edit modal, auto-fill the category's default ControlAccount
    $(document).on('select2:select', 'select[name="VendorCategoryId"]', function (e) {
        var data = e.params && e.params.data ? e.params.data : null;
        var $form = $(this).closest('form');
        var pickerEl = $form.find('.erp-lookup-picker[data-input-name="FinancialAccountId"]')[0];
        if (!pickerEl || !window.ErpLookup || typeof window.ErpLookup.setPickerValue !== 'function') return;

        if (data && data.controlAccountId) {
            window.ErpLookup.setPickerValue(pickerEl, data.controlAccountId, data.controlAccountDisplay || '');
        }
    });

    // Enforce FinancialAccountId before submitting Create/Edit Vendor form
    $(document).on('submit', '.cust-vendor-account-required-form', function (e) {
        var $form = $(this);
        var accVal = $form.find('input[name="FinancialAccountId"]').val();
        if (!accVal || parseInt(accVal, 10) <= 0) {
            e.preventDefault();
            e.stopImmediatePropagation();
            alert('يرجى تحديد الحساب المالي للمورد في دليل الحسابات (لا يمكن حفظ المورد بدون تسجيل الحساب).');
            return false;
        }
    });

    // Vendor Excel Import JS
    $('#vendorExcelFileInput').on('change', function () {
        $('#btnPreviewVendorExcel').prop('disabled', !(this.files && this.files.length > 0));
        $('#btnExecuteVendorImport').prop('disabled', true);
        $('#vendorImportPreviewContainer').addClass('d-none');
        $('#vendorImportResultAlert').addClass('d-none');
    });

    $('#btnPreviewVendorExcel').on('click', function () {
        var fileInput = document.getElementById('vendorExcelFileInput');
        if (!fileInput.files || !fileInput.files.length) return;

        var fd = new FormData();
        fd.append('excelFile', fileInput.files[0]);
        fd.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').first().val());

        $('#vendorImportSpinner').removeClass('d-none');
        $('#vendorImportPreviewContainer').addClass('d-none');
        $('#vendorImportResultAlert').addClass('d-none');
        $('#btnPreviewVendorExcel').prop('disabled', true);
        $('#btnExecuteVendorImport').prop('disabled', true);

        $.ajax({
            url: '@Url.Action("PreviewExcelImport", "Vendor")',
            type: 'POST',
            data: fd,
            processData: false,
            contentType: false,
            success: function (res) {
                $('#vendorImportSpinner').addClass('d-none');
                $('#btnPreviewVendorExcel').prop('disabled', false);
                if (res.success && res.data) {
                    var p = res.data;
                    $('#vendorMetricTotal').text(p.totalRows);
                    $('#vendorMetricValid').text(p.validCount);
                    $('#vendorMetricErrors').text(p.errorCount);
                    $('#vendorMetricUpdates').text(p.updateCount);

                    var tbody = $('#vendorPreviewTableBody');
                    tbody.empty();
                    p.rows.forEach(function (r) {
                        var trClass = !r.isValid ? 'table-danger' : (r.existsInDb ? 'table-warning' : '');
                        var badge = !r.isValid
                            ? '<span class="badge bg-danger">خطأ</span>'
                            : (r.existsInDb ? '<span class="badge bg-warning text-dark">تحديث</span>' : '<span class="badge bg-success">جديد</span>');
                        var notes = [];
                        (r.errors || []).forEach(function (e) { notes.push('<div class="text-danger fw-bold">' + e + '</div>'); });
                        (r.warnings || []).forEach(function (w) { notes.push('<div class="text-muted">' + w + '</div>'); });

                        tbody.append(
                            '<tr class="' + trClass + '">' +
                            '<td>' + r.rowNumber + '</td>' +
                            '<td>' + (r.branchName || '-') + '</td>' +
                            '<td class="font-monospace fw-bold">' + (r.code || '<span class="text-muted">تلقائي</span>') + '</td>' +
                            '<td><div class="fw-bold">' + (r.nameAr || '') + '</div><small class="text-muted">' + (r.nameEn || '') + '</small></td>' +
                            '<td>' + (r.categoryName || '-') + '</td>' +
                            '<td class="font-monospace">' + (r.financialAccountCode || '-') + '</td>' +
                            '<td>' + (r.currencyCode || 'EGP') + '</td>' +
                            '<td>' + (r.mobile || r.phone || '-') + '</td>' +
                            '<td>' + badge + '</td>' +
                            '<td>' + (notes.join('') || '<span class="text-success">صالح</span>') + '</td>' +
                            '</tr>'
                        );
                    });
                    $('#vendorImportPreviewContainer').removeClass('d-none');
                    if (p.validCount > 0 && p.errorCount === 0) {
                        $('#btnExecuteVendorImport').prop('disabled', false);
                    }
                } else {
                    alert(res.message || 'حدث خطأ أثناء معاينة الملف.');
                }
            },
            error: function () {
                $('#vendorImportSpinner').addClass('d-none');
                $('#btnPreviewVendorExcel').prop('disabled', false);
                alert('حدث خطأ في الاتصال بالخادم.');
            }
        });
    });

    $('#btnExecuteVendorImport').on('click', function () {
        var fileInput = document.getElementById('vendorExcelFileInput');
        if (!fileInput.files || !fileInput.files.length) return;

        var fd = new FormData();
        fd.append('excelFile', fileInput.files[0]);
        fd.append('updateExisting', $('#chkVendorUpdateExisting').is(':checked'));
        fd.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').first().val());

        $('#vendorSpinnerText').text('جاري حفظ واستيراد بيانات الموردين...');
        $('#vendorImportSpinner').removeClass('d-none');
        $('#btnExecuteVendorImport').prop('disabled', true);

        $.ajax({
            url: '@Url.Action("ConfirmExcelImport", "Vendor")',
            type: 'POST',
            data: fd,
            processData: false,
            contentType: false,
            success: function (res) {
                $('#vendorImportSpinner').addClass('d-none');
                var alertBox = $('#vendorImportResultAlert');
                alertBox.removeClass('d-none alert-success alert-danger');
                if (res.success) {
                    alertBox.addClass('alert-success').html('<i class="fa-solid fa-circle-check me-1"></i> ' + res.message);
                    setTimeout(function () { window.location.reload(); }, 1200);
                } else {
                    alertBox.addClass('alert-danger').html('<i class="fa-solid fa-triangle-exclamation me-1"></i> ' + (res.message || 'فشل الاستيراد'));
                    $('#btnExecuteVendorImport').prop('disabled', false);
                }
            },
            error: function () {
                $('#vendorImportSpinner').addClass('d-none');
                $('#btnExecuteVendorImport').prop('disabled', false);
                alert('حدث خطأ أثناء تنفيذ الاستيراد.');
            }
        });
    });

    // ─── Related Records Modal & Linking Endpoints for Vendor ──────────────────────

    function openRelatedRecordsModal(partyType, partyId, partyName, branchId) {
        $('#relatedModalCurrentPartyType').val(partyType);
        $('#relatedModalCurrentPartyId').val(partyId);
        $('#relatedModalBranchId').val(branchId || 0);
        $('#relatedModalTitle').html('<i class="fa-solid fa-diagram-project me-2"></i> السجلات المرتبطة وتعدد العملات: ' + (partyName || ''));
        $('#searchLinkPartyResults').addClass('d-none');
        $('#searchLinkPartyTerm').val('');
        $('#evalUnifiedResultContainer').html('<span class="text-muted small">اختر عملة واضغط حساب لمعاينة صافي رصيد المجموعة بالعملة المختارة.</span>');
        $('#relatedModalAlert').addClass('d-none');

        var modal = new bootstrap.Modal(document.getElementById('relatedRecordsModal'));
        modal.show();

        loadRelatedRecordsData(partyType, partyId);
    }

    function loadRelatedRecordsData(partyType, partyId, unifiedCurrencyId) {
        var url = '@Url.Action("GetRelatedRecords", "Vendor")?partyType=' + encodeURIComponent(partyType) + '&partyId=' + partyId;
        if (unifiedCurrencyId) {
            url += '&unifiedCurrencyId=' + unifiedCurrencyId;
        }

        $('#relatedModalRecordsTableBody').html('<tr><td colspan="9" class="text-center py-3 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div>جاري تحميل البيانات...</td></tr>');
        $('#relatedModalCurrencyCards').html('<div class="col-12 text-center text-muted py-2 small"><div class="spinner-border spinner-border-sm text-primary me-2"></div>جاري تحميل الأرصدة...</div>');

        $.getJSON(url, function (res) {
            if (!res || !res.success || !res.data) {
                $('#relatedModalRecordsTableBody').html('<tr><td colspan="9" class="text-center py-3 text-danger">فشل تحميل السجلات المرتبطة.</td></tr>');
                return;
            }

            var d = res.data;
            $('#relatedModalGroupName').text(d.groupNameAr || 'حساب مستقل غير مرتبط');
            $('#relatedModalGroupCode').text(d.groupCode || '—');
            var firstRec = (d.records && d.records.length > 0) ? d.records[0] : null;
            $('#relatedModalBranchName').text(firstRec ? firstRec.branchName : '—');
            $('#relatedModalRecordsCount').text((d.records || []).length);

            // Render Balances Cards by Currency
            var cardsHtml = '';
            if (d.balancesByCurrency && d.balancesByCurrency.length > 0) {
                d.balancesByCurrency.forEach(function (b) {
                    var custNet = b.netCustomerBalance || 0;
                    var vendNet = b.netVendorBalance || 0;
                    var net = custNet + vendNet;
                    var netColor = net > 0 ? 'text-primary' : (net < 0 ? 'text-danger' : 'text-dark');

                    cardsHtml +=
                        '<div class="col-md-3 col-6">' +
                        '<div class="p-2 rounded bg-white border shadow-sm">' +
                        '<div class="d-flex justify-content-between align-items-center mb-1">' +
                        '<span class="badge bg-primary bg-opacity-10 text-primary fw-bold">' + b.currencyCode + '</span>' +
                        '<span class="small text-muted" style="font-size:11px;">' + b.currencyNameAr + '</span>' +
                        '</div>' +
                        '<div class="d-flex justify-content-between small text-muted" style="font-size:11px;">' +
                        '<span>عميل:</span> <span class="fw-bold font-monospace">' + custNet.toFixed(2) + '</span>' +
                        '</div>' +
                        '<div class="d-flex justify-content-between small text-muted" style="font-size:11px;">' +
                        '<span>مورد:</span> <span class="fw-bold font-monospace">' + vendNet.toFixed(2) + '</span>' +
                        '</div>' +
                        '<div class="d-flex justify-content-between small border-top pt-1 mt-1 ' + netColor + '">' +
                        '<span class="fw-bold">الصافي:</span> <span class="fw-bold font-monospace fs-6">' + net.toFixed(2) + '</span>' +
                        '</div>' +
                        '</div>' +
                        '</div>';
                });
            } else {
                cardsHtml = '<div class="col-12 text-center text-muted py-2 small">لا توجد حركات مالية مسجلة لهذه المجموعة حتى الآن.</div>';
            }
            $('#relatedModalCurrencyCards').html(cardsHtml);

            // Render Records Table
            var tbody = $('#relatedModalRecordsTableBody');
            tbody.empty();
            if (d.records && d.records.length > 0) {
                var currentPartyId = parseInt($('#relatedModalCurrentPartyId').val(), 10);
                var currentPartyType = $('#relatedModalCurrentPartyType').val();

                d.records.forEach(function (r) {
                    var isCurrent = (r.partyType === currentPartyType && r.partyId === currentPartyId);
                    var typeBadge = r.partyType === 'Vendor'
                        ? '<span class="badge bg-success bg-opacity-10 text-success border border-success-subtle">مورد</span>'
                        : '<span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle">عميل</span>';

                    var actionBtn = '';
                    if (r.partyGroupId) {
                        actionBtn = '<button type="button" class="btn btn-outline-danger btn-xs py-0 px-2" style="font-size:11px;" title="فك الارتباط عن المجموعة دون حذف السجل" onclick="unlinkPartyRecord(\'' + r.partyType + '\', ' + r.partyId + ')"><i class="fa-solid fa-link-slash"></i> فك الربط</button>';
                    } else {
                        actionBtn = '<span class="text-muted small">—</span>';
                    }

                    var balColor = r.balanceInCurrency > 0 ? 'text-primary' : (r.balanceInCurrency < 0 ? 'text-danger' : 'text-muted');

                    tbody.append(
                        '<tr class="' + (isCurrent ? 'table-warning bg-opacity-25' : '') + '">' +
                        '<td>' + typeBadge + '</td>' +
                        '<td class="font-monospace fw-bold">' + r.code + '</td>' +
                        '<td>' +
                        '<div class="fw-bold">' + r.nameAr + (isCurrent ? ' <span class="badge bg-warning text-dark ms-1" style="font-size:10px;">الحالي</span>' : '') + '</div>' +
                        '<small class="text-muted">' + (r.nameEn || '') + '</small>' +
                        '</td>' +
                        '<td><span class="badge bg-light text-dark border">' + r.currencyCode + '</span></td>' +
                        '<td class="text-end font-monospace">' + (r.debitInCurrency || 0).toFixed(2) + '</td>' +
                        '<td class="text-end font-monospace">' + (r.creditInCurrency || 0).toFixed(2) + '</td>' +
                        '<td class="text-end font-monospace fw-bold ' + balColor + '">' + (r.balanceInCurrency || 0).toFixed(2) + '</td>' +
                        '<td class="text-center"><span class="badge bg-secondary bg-opacity-10 text-secondary">' + (r.journalEntriesCount || 0) + '</span></td>' +
                        '<td class="text-center">' + actionBtn + '</td>' +
                        '</tr>'
                    );
                });
            } else {
                tbody.append('<tr><td colspan="9" class="text-center py-3 text-muted">لا توجد سجلات مرتبطة.</td></tr>');
            }

            // If Unified Evaluation returned
            if (d.unifiedEvaluation) {
                var u = d.unifiedEvaluation;
                $('#evalUnifiedResultContainer').html(
                    '<div class="p-2 rounded bg-success bg-opacity-10 border border-success-subtle small">' +
                    '<div>صافي التقييم بالـ <strong>' + u.targetCurrencyCode + '</strong>: <span class="fs-6 fw-bold text-success font-monospace">' + u.totalConvertedNetBalance.toFixed(2) + '</span></div>' +
                    '<div class="text-muted" style="font-size:10.5px;">عملاء: ' + u.totalConvertedCustomerBalance.toFixed(2) + ' | موردين: ' + u.totalConvertedVendorBalance.toFixed(2) + ' (بتاريخ: ' + new Date(u.conversionDate).toLocaleDateString() + ')</div>' +
                    '</div>'
                );
            }
        }).fail(function () {
            $('#relatedModalRecordsTableBody').html('<tr><td colspan="9" class="text-center py-3 text-danger">حدث خطأ في الاتصال بالسيرفر.</td></tr>');
        });
    }

    function executePartySearchForLink() {
        var searchType = $('#searchLinkPartyType').val();
        var term = ($('#searchLinkPartyTerm').val() || '').trim();
        var branchId = $('#relatedModalBranchId').val();
        var currentPartyType = $('#relatedModalCurrentPartyType').val();
        var currentPartyId = $('#relatedModalCurrentPartyId').val();

        if (!term) {
            alert('يرجى كتابة اسم أو كود للبحث.');
            return;
        }

        var url = '@Url.Action("SearchPartiesForLink", "Vendor")?term=' + encodeURIComponent(term) +
            '&searchPartyType=' + encodeURIComponent(searchType) +
            '&branchId=' + branchId +
            '&excludePartyType=' + encodeURIComponent(currentPartyType) +
            '&excludePartyId=' + currentPartyId;

        $('#searchLinkPartyList').html('<div class="text-muted small py-2"><div class="spinner-border spinner-border-sm text-primary me-1"></div>جاري البحث...</div>');
        $('#searchLinkPartyResults').removeClass('d-none');

        $.getJSON(url, function (res) {
            if (!res || !res.success || !res.data || res.data.length === 0) {
                $('#searchLinkPartyList').html('<div class="text-muted small py-1">لم يتم العثور على نتائج مطابقة في هذا الفرع.</div>');
                return;
            }

            var html = '';
            res.data.forEach(function (item) {
                var tBadge = item.partyType === 'Vendor' ? '<span class="badge bg-success me-1">مورد</span>' : '<span class="badge bg-primary me-1">عميل</span>';
                var grpBadge = item.partyGroupId ? '<span class="badge bg-warning text-dark ms-1">مرتبط بمجموعة ' + (item.partyGroupCode || item.partyGroupId) + '</span>' : '<span class="badge bg-light text-muted ms-1">غير مرتبط</span>';

                html +=
                    '<div class="d-flex justify-content-between align-items-center p-2 bg-white rounded border">' +
                    '<div>' +
                    tBadge +
                    '<strong class="font-monospace text-primary">' + item.code + '</strong> - ' + item.nameAr +
                    ' <span class="badge bg-light text-dark border">' + item.currencyCode + '</span>' +
                    grpBadge +
                    '</div>' +
                    '<button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" onclick="linkPartyRecord(\'' + item.partyType + '\', ' + item.partyId + ', false)">' +
                    '<i class="fa-solid fa-link me-1"></i> ربط بهذه المجموعة' +
                    '</button>' +
                    '</div>';
            });
            $('#searchLinkPartyList').html(html);
        });
    }

    function linkPartyRecord(targetPartyType, targetPartyId, confirmMove) {
        var srcType = $('#relatedModalCurrentPartyType').val();
        var srcId = parseInt($('#relatedModalCurrentPartyId').val(), 10);

        var token = $('input[name="__RequestVerificationToken"]').first().val();

        var payload = {
            sourcePartyType: srcType,
            sourcePartyId: srcId,
            targetPartyType: targetPartyType,
            targetPartyId: targetPartyId,
            confirmMove: confirmMove === true
        };

        $.ajax({
            url: '@Url.Action("LinkRelatedRecord", "Vendor")',
            type: 'POST',
            contentType: 'application/json',
            headers: { 'RequestVerificationToken': token },
            data: JSON.stringify(payload),
            success: function (res) {
                if (res.requiresMoveConfirmation) {
                    if (confirm(res.message)) {
                        linkPartyRecord(targetPartyType, targetPartyId, true);
                    }
                    return;
                }

                var alertBox = $('#relatedModalAlert');
                alertBox.removeClass('d-none alert-success alert-danger');
                if (res.success) {
                    alertBox.addClass('alert-success').html('<i class="fa-solid fa-circle-check me-1"></i> ' + res.message);
                    $('#searchLinkPartyResults').addClass('d-none');
                    $('#searchLinkPartyTerm').val('');
                    loadRelatedRecordsData(srcType, srcId);
                } else {
                    alertBox.addClass('alert-danger').html('<i class="fa-solid fa-triangle-exclamation me-1"></i> ' + (res.message || 'فشل الربط.'));
                }
            },
            error: function () {
                alert('حدث خطأ أثناء تنفيذ عملية الربط.');
            }
        });
    }

    function unlinkPartyRecord(partyType, partyId) {
        if (!confirm('هل أنت متأكد من فك ارتباط هذا السجل من المجموعة؟\n(لن يتم حذف السجل ولن تتأثر حركاته أو رصيده السابق)'))
            return;

        var token = $('input[name="__RequestVerificationToken"]').first().val();
        var srcType = $('#relatedModalCurrentPartyType').val();
        var srcId = parseInt($('#relatedModalCurrentPartyId').val(), 10);

        $.ajax({
            url: '@Url.Action("UnlinkRelatedRecord", "Vendor")?partyType=' + encodeURIComponent(partyType) + '&partyId=' + partyId,
            type: 'POST',
            headers: { 'RequestVerificationToken': token },
            success: function (res) {
                var alertBox = $('#relatedModalAlert');
                alertBox.removeClass('d-none alert-success alert-danger');
                if (res.success) {
                    alertBox.addClass('alert-success').html('<i class="fa-solid fa-circle-check me-1"></i> ' + res.message);
                    loadRelatedRecordsData(srcType, srcId);
                } else {
                    alertBox.addClass('alert-danger').html('<i class="fa-solid fa-triangle-exclamation me-1"></i> ' + (res.message || 'فشل فك الربط.'));
                }
            },
            error: function () {
                alert('حدث خطأ أثناء فك الربط.');
            }
        });
    }

    function evaluateUnifiedGroupBalance() {
        var targetCurrencyId = $('#evalTargetCurrency').val();
        var srcType = $('#relatedModalCurrentPartyType').val();
        var srcId = parseInt($('#relatedModalCurrentPartyId').val(), 10);
        loadRelatedRecordsData(srcType, srcId, targetCurrencyId);
    }
</script>
}
