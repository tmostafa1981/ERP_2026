@model ERP.Web.Models.RolePermissionsMatrixViewModel
@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ERP.Web.Resources.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["RolePermissions"] + " - " + Model.RoleName;
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
}

<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--erp-text-dark); font-size: 18px;">
            <i class="fa-solid fa-key text-warning me-2 ms-0"></i> @Localizer["RolePermissions"]: <span class="text-primary">@Model.RoleName</span>
        </h4>
        <span class="text-muted" style="font-size: 12.5px;">@Localizer["MatrixPermissionsSubtitle"]</span>
    </div>
    <a href="@Url.Action("Index", "Role")" class="btn btn-outline-secondary btn-sm px-3">
        <i class="fa-solid fa-arrow-left me-1 ms-0"></i> @Localizer["BackToRoles"]
    </a>
</div>

<!-- Success Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show p-2 mb-3" role="alert" style="font-size: 12.5px;">
        <i class="fa-solid fa-circle-check me-2 ms-0"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close p-2" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="SavePermissions" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="roleId" value="@Model.RoleId" />

    <!-- Action Toolbar -->
    <div class="erp-card mb-3 p-3 d-flex align-items-center justify-content-between bg-light border">
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-success" onclick="toggleAllCheckboxes(true)">
                <i class="fa-solid fa-check-double me-1 ms-0"></i> @Localizer["GrantAllPermissions"]
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="toggleAllCheckboxes(false)">
                <i class="fa-solid fa-xmark me-1 ms-0"></i> @Localizer["RevokeAllPermissions"]
            </button>
        </div>
        <button type="submit" class="btn btn-erp-primary px-4 fw-semibold">
            <i class="fa-solid fa-floppy-disk me-1 ms-0"></i> @Localizer["SavePermissions"]
        </button>
    </div>

    <!-- Category Tabs Navigation -->
    <div class="erp-card">
        <div class="erp-card-header bg-white p-0 border-bottom">
            <ul class="nav nav-tabs erp-matrix-tabs border-0" id="moduleTabs" role="tablist">
                @if (Model.Modules != null && Model.Modules.Any())
                {
                    int idx = 0;
                    foreach (var mod in Model.Modules)
                    {
                        var tabId = "tab_" + mod.ModuleName.Replace(" ", "_");
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(idx == 0 ? "active" : "") fw-bold px-3 py-2" id="@tabId-tab" data-bs-toggle="tab" data-bs-target="#@tabId" type="button" role="tab" style="font-size: 13px;">
                                <i class="fa-solid fa-cubes me-1 ms-0 text-primary"></i> @Localizer[mod.ModuleName]
                                <span class="badge bg-secondary rounded-pill ms-1">@mod.Screens.Sum(s => s.Actions.Count)</span>
                            </button>
                        </li>
                        idx++;
                    }
                }
            </ul>
        </div>

        <div class="erp-card-body p-3">
            <div class="tab-content" id="moduleTabsContent">
                @if (Model.Modules != null && Model.Modules.Any())
                {
                    int mIdx = 0;
                    foreach (var mod in Model.Modules)
                    {
                        var tabId = "tab_" + mod.ModuleName.Replace(" ", "_");
                        <div class="tab-pane fade @(mIdx == 0 ? "show active" : "")" id="@tabId" role="tabpanel">

                            <!-- Module Header & Quick Select -->
                            <div class="d-flex align-items-center justify-content-between p-2 mb-3 bg-light rounded border">
                                <span class="fw-bold text-dark" style="font-size: 13.5px;"><i class="fa-solid fa-folder-open text-primary me-2 ms-0"></i>@Localizer[mod.ModuleName] @Localizer["CategoryPermissions"]</span>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input module-toggle" type="checkbox" id="mod_toggle_@tabId" onchange="toggleModulePermissions('@tabId', this.checked)" />
                                    <label class="form-check-label fw-semibold" for="mod_toggle_@tabId" style="font-size: 12px;">@Localizer["SelectAllInModule"]</label>
                                </div>
                            </div>

                            <!-- Screen Matrices -->
                            @foreach (var scr in mod.Screens)
                            {
                                <div class="border rounded p-3 mb-3 bg-white hover-shadow">
                                    <div class="d-flex align-items-center justify-content-between pb-2 mb-2 border-bottom">
                                        <div class="fw-bold text-secondary" style="font-size: 13.5px;">
                                            <i class="fa-solid fa-desktop text-info me-2 ms-0"></i>@(!string.IsNullOrEmpty(scr.ScreenTitleAr) && isRtl ? scr.ScreenTitleAr : Localizer[scr.ScreenName])
                                        </div>
                                        <button type="button" class="btn btn-link text-decoration-none btn-sm p-0 fw-semibold text-primary" onclick="toggleScreenPermissions(this)" style="font-size: 11.5px;">
                                            <i class="fa-solid fa-check-square me-1"></i> @Localizer["ToggleScreen"]
                                        </button>
                                    </div>

                                    <!-- Action Checkboxes Grid -->
                                    <div class="row g-2">
                                        @foreach (var act in scr.Actions)
                                        {
                                            <div class="col-6 col-md-4 col-lg-3">
                                                <label class="erp-action-checkbox-card d-flex align-items-center gap-2 p-2 rounded border @(act.IsGranted ? "granted" : "")">
                                                    <input type="checkbox" name="selectedPermissionIds" value="@act.PermissionId" class="form-check-input perm-checkbox" @(act.IsGranted ? "checked" : "") onchange="onActionCheckboxChange(this)" />
                                                    <div class="lh-1">
                                                        <span class="d-block fw-semibold" style="font-size: 12.5px;">@(isRtl ? act.NameAr : act.NameEn)</span>
                                                        <span class="text-muted" style="font-size: 10.5px;">@act.Action</span>
                                                    </div>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        mIdx++;
                    }
                }
            </div>
        </div>
    </div>
</form>

@section Scripts {
<style>
    .erp-matrix-tabs .nav-link { border: none; border-bottom: 2px solid transparent; color: #64748b; }
    .erp-matrix-tabs .nav-link.active { border-bottom-color: #2563eb; color: #1e293b; background: transparent; }
    .erp-action-checkbox-card { cursor: pointer; transition: all .15s; background: #f8fafc; }
    .erp-action-checkbox-card:hover { border-color: #3b82f6 !important; background: #eff6ff; }
    .erp-action-checkbox-card.granted { border-color: #3b82f6 !important; background: #eff6ff; }
    .erp-action-checkbox-card input[type=checkbox] { flex-shrink: 0; }
</style>
<script>
    function onActionCheckboxChange(checkbox) {
        var card = $(checkbox).closest('.erp-action-checkbox-card');
        if (checkbox.checked) {
            card.addClass('granted');
        } else {
            card.removeClass('granted');
        }
    }

    function toggleModulePermissions(tabId, isChecked) {
        $('#' + tabId + ' .perm-checkbox').each(function () {
            this.checked = isChecked;
            onActionCheckboxChange(this);
        });
    }

    function toggleScreenPermissions(btn) {
        var container = $(btn).closest('.border');
        var checkboxes = container.find('.perm-checkbox');
        var allChecked = checkboxes.length === checkboxes.filter(':checked').length;
        checkboxes.each(function () {
            this.checked = !allChecked;
            onActionCheckboxChange(this);
        });
    }

    function toggleAllCheckboxes(isChecked) {
        $('.perm-checkbox').each(function () {
            this.checked = isChecked;
            onActionCheckboxChange(this);
        });
        $('.module-toggle').prop('checked', isChecked);
    }
</script>
}
