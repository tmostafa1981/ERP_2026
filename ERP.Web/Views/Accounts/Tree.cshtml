@Html.AntiForgeryToken()

@section Scripts {
    <script>
        // ====================================================================
        // Chart of Accounts Tree View Controller
        // ====================================================================
        let rawTreeData = [];
        let nodesMap = {};
        let currentSelectedNode = null;
        let searchMatches = [];
        let currentMatchCursor = -1;

        $(document).ready(function () {
            loadTreeData();

            // Branch Filter Handler
            $('#treeBranchFilter').change(function () {
                const bVal = $(this).val();
                const baseUrl = '@Url.Action("ExportTreeToExcel", "Accounts")';
                const exportUrl = bVal ? `${baseUrl}?branchId=${bVal}` : baseUrl;
                $('#btnExportTreeExcel, #btnQuickExportExcel, #btnQuickExportExcel2').attr('href', exportUrl);
                loadTreeData();
            });

            // IsGroup radio toggle in quick create modal
            $('input[name="qcIsGroup"]').change(function () {
                if ($(this).val() === 'true') {
                    $('#qcBranchContainer').addClass('d-none');
                    $('#qcBranchId').val('');
                } else {
                    $('#qcBranchContainer').removeClass('d-none');
                }
            });

            // Search Handlers
            let searchTimeout = null;
            $('#treeSearchInput').on('input', function () {
                clearTimeout(searchTimeout);
                const query = $(this).val().trim();
                searchTimeout = setTimeout(function () {
                    executeTreeSearch(query);
                }, 250);
            });

            $('#btnClearSearch').click(function () {
                $('#treeSearchInput').val('');
                executeTreeSearch('');
            });

            $('#btnPrevMatch').click(function () { navigateMatch(-1); });
            $('#btnNextMatch').click(function () { navigateMatch(1); });

            // Expand / Collapse All
            $('#btnExpandAll').click(function () {
                $('#treeContainer ul').show();
                $('.toggle-icon').removeClass('fa-chevron-left').addClass('fa-chevron-down');
            });

            $('#btnCollapseAll').click(function () {
                $('#treeContainer > ul > li > ul').hide();
                $('.toggle-icon').removeClass('fa-chevron-down').addClass('fa-chevron-left');
            });

            $('#btnRefreshTree').click(function () {
                loadTreeData();
            });

            // Control Account sub-ledger toggle in quick create modal
            $('#qcIsControlAccount').change(function () {
                if ($(this).is(':checked')) {
                    $('#qcSubLedgerContainer').removeClass('d-none');
                } else {
                    $('#qcSubLedgerContainer').addClass('d-none');
                    $('#qcSubLedgerType').val('0');
                }
            });

            // Action Button Handlers
            $('#btnActionAddChildGroup').click(function () {
                if (currentSelectedNode) openQuickCreateModal(currentSelectedNode, true);
            });

            $('#btnActionAddChildAccount').click(function () {
                if (currentSelectedNode) openQuickCreateModal(currentSelectedNode, false);
            });

            $('#btnActionEdit').click(function (e) {
                e.preventDefault();
                if (currentSelectedNode) {
                    window.location.href = '@Url.Action("Edit", "Accounts")/' + currentSelectedNode.id;
                }
            });

            $('#btnActionToggleStatus').click(function () {
                if (currentSelectedNode) toggleAccountStatus(currentSelectedNode.id);
            });

            $('#btnActionViewAudit').click(function () {
                if (currentSelectedNode) openAuditModal(currentSelectedNode);
            });

            $('#btnActionDelete').click(function () {
                if (currentSelectedNode) deleteAccount(currentSelectedNode.id);
            });

            $('#btnSubmitQuickCreate').click(function () {
                submitQuickCreate();
            });
        });

        // ====================================================================
        // Tree Data Loader & Hierarchy Builder
        // ====================================================================
        function loadTreeData() {
            $('#treeLoadingSpinner').removeClass('d-none');
            $('#treeContainer').addClass('d-none');
            $('#treeEmptyNotice').addClass('d-none');

            const branchFilter = $('#treeBranchFilter').val();
            const url = '@Url.Action("GetTreeHierarchy", "Accounts")' + (branchFilter ? '?branchId=' + branchFilter : '');

            $.get(url, function (nodes) {
                $('#treeLoadingSpinner').addClass('d-none');
                rawTreeData = nodes || [];

                if (rawTreeData.length === 0) {
                    $('#treeEmptyNotice').removeClass('d-none');
                    updateCounterLabels(0, 0, 0, 0);
                    return;
                }

                // Build Map & Counters
                nodesMap = {};
                let groupsCount = 0;
                let leafsCount = 0;
                let inactiveCount = 0;

                rawTreeData.forEach(n => {
                    nodesMap[n.id] = { ...n, children: [] };
                    if (n.isGroup) groupsCount++; else leafsCount++;
                    if (!n.isActive) inactiveCount++;
                });

                updateCounterLabels(rawTreeData.length, groupsCount, leafsCount, inactiveCount);

                // Build Root Hierarchy
                const roots = [];
                rawTreeData.forEach(n => {
                    if (n.parentId && nodesMap[n.parentId]) {
                        nodesMap[n.parentId].children.push(nodesMap[n.id]);
                    } else {
                        roots.push(nodesMap[n.id]);
                    }
                });

                // Render DOM Tree
                renderTreeRoots(roots);
                $('#treeContainer').removeClass('d-none');

                // Re-select previously selected or default
                const preselectId = @(selectedAccountId ?? 0);
                if (preselectId > 0 && nodesMap[preselectId]) {
                    selectNode(nodesMap[preselectId]);
                    expandPathToNode(preselectId);
                } else if (roots.length > 0) {
                    selectNode(roots[0]);
                }
            }).fail(function () {
                $('#treeLoadingSpinner').addClass('d-none');
                showNotice('حدث خطأ أثناء تحميل شجرة الحسابات من الخادم.', 'danger');
            });
        }

        function updateCounterLabels(total, groups, leafs, inactive) {
            $('#lblTotalAccounts').text(total);
            $('#lblTotalGroups').text(groups);
            $('#lblTotalLeafs').text(leafs);
            $('#lblTotalInactive').text(inactive);
        }

        // ====================================================================
        // Tree DOM Renderer
        // ====================================================================
        function renderTreeRoots(roots) {
            const container = $('#treeContainer');
            container.empty();

            let treeHtml = '<ul class="list-unstyled p-0 m-0">';
            roots.forEach(root => {
                treeHtml += renderNodeHtml(root);
            });
            treeHtml += '</ul>';
            container.html(treeHtml);

            // Bind click & double-click events
            container.find('.tree-node-item').click(function (e) {
                if ($(e.target).hasClass('toggle-icon')) return;
                const id = parseInt($(this).data('node-id'));
                if (nodesMap[id]) {
                    selectNode(nodesMap[id]);
                }
            });

            container.find('.tree-node-item').dblclick(function (e) {
                const id = parseInt($(this).data('node-id'));
                window.location.href = '@Url.Action("Edit", "Accounts")/' + id;
            });

            container.find('.toggle-icon').click(function () {
                const parentLi = $(this).closest('li');
                const childrenUl = parentLi.children('ul');
                if (childrenUl.length > 0) {
                    childrenUl.slideToggle(150);
                    $(this).toggleClass('fa-chevron-down fa-chevron-left');
                }
            });
        }

        function renderNodeHtml(node) {
            const hasChildren = node.children && node.children.length > 0;
            const isGroup = node.isGroup;
            const isActive = node.isActive;

            // Visual Icons: Group 📁, Leaf 📄, Inactive ⛔
            let iconHtml = '';
            if (!isActive) {
                iconHtml = '<i class="fa-solid fa-ban text-danger me-2" title="حساب معطل"></i>';
            } else if (isGroup) {
                iconHtml = '<i class="fa-solid fa-folder text-warning me-2"></i>';
            } else {
                iconHtml = '<i class="fa-solid fa-file-lines text-primary me-2"></i>';
            }

            const activeClass = !isActive ? 'node-inactive' : '';
            const natureBadge = node.accountNature === 1 
                ? '<span class="badge bg-light text-primary border ms-1" style="font-size:0.68rem;">مدين</span>' 
                : '<span class="badge bg-light text-danger border ms-1" style="font-size:0.68rem;">دائن</span>';

            const groupBadge = isGroup 
                ? '<span class="badge bg-secondary-subtle text-secondary border ms-1" style="font-size:0.65rem;">مجموعة</span>' 
                : '<span class="badge bg-success-subtle text-success border ms-1" style="font-size:0.65rem;">فرعي</span>';

            const branchBadge = node.branchId 
                ? `<span class="badge bg-info-subtle text-info-emphasis border ms-1" style="font-size:0.65rem;" title="حساب مخصص لفرع: ${node.branchName}"><i class="fa-solid fa-code-branch me-1"></i>${node.branchName}</span>` 
                : '';

            const controlBadge = node.isControlAccount 
                ? '<span class="badge bg-warning-subtle text-warning-emphasis border ms-1" style="font-size:0.65rem;" title="حساب مراقبة"><i class="fa-solid fa-shield-halved"></i> مراقبة</span>' 
                : '';

            let html = `<li class="my-1" data-li-id="${node.id}">`;
            html += `
                <div class="tree-node-item d-flex align-items-center p-2 rounded ${activeClass}" 
                     data-node-id="${node.id}" id="tree_node_${node.id}">
                    <span class="toggle-icon me-1">
                        ${hasChildren ? '<i class="fa-solid fa-chevron-down"></i>' : '<span style="display:inline-block; width:14px;"></span>'}
                    </span>
                    ${iconHtml}
                    <span class="font-monospace fw-bold text-primary me-2 node-code">${node.code}</span>
                    <span class="fw-semibold text-dark me-2 node-title">${node.nameAr || node.nameEn}</span>
                    ${groupBadge}
                    ${branchBadge}
                    ${controlBadge}
                    ${natureBadge}
                    <span class="badge bg-light text-muted border ms-auto" style="font-size:0.65rem;">L${node.level}</span>
                </div>
            `;

            if (hasChildren) {
                html += `<ul class="tree-children-list">`;
                node.children.forEach(child => {
                    html += renderNodeHtml(child);
                });
                html += `</ul>`;
            }
            html += `</li>`;
            return html;
        }

        // ====================================================================
        // Node Selection & Details Panel Update
        // ====================================================================
        function selectNode(node) {
            currentSelectedNode = node;

            // Highlight node in tree
            $('.tree-node-item').removeClass('selected-node');
            $(`#tree_node_${node.id}`).addClass('selected-node');

            // Fetch latest detailed properties
            $.get('@Url.Action("GetAccountDetails", "Accounts")?id=' + node.id, function (res) {
                if (res.success && res.data) {
                    displayDetailsPanel(res.data);
                } else {
                    displayDetailsPanel(node);
                }
            }).fail(function () {
                displayDetailsPanel(node);
            });
        }

        function displayDetailsPanel(d) {
            $('#noSelectionPlaceholder').addClass('d-none');
            $('#selectedAccountContent').removeClass('d-none');

            // Header Info
            $('#infoTypeIcon').text(!d.isActive ? '⛔' : (d.isGroup ? '📁' : '📄'));
            $('#infoCode').text(d.code);
            $('#infoName').text(d.nameAr || d.nameEn);

            if (d.isGroup) {
                $('#infoGroupBadge').text('مجموعة رئيسية').removeClass('bg-success').addClass('bg-secondary');
            } else {
                $('#infoGroupBadge').text('حساب حركة فرعي').removeClass('bg-secondary').addClass('bg-success');
            }

            if (d.isControlAccount) {
                $('#infoControlBadge').removeClass('d-none');
            } else {
                $('#infoControlBadge').addClass('d-none');
            }

            if (d.isActive) {
                $('#infoActiveBadge').text('نشط').removeClass('bg-danger').addClass('bg-success');
                $('#panelStatusBadge').html('<span class="badge bg-success">نشط</span>');
                $('#lblToggleActionText').text('تجميد');
            } else {
                $('#infoActiveBadge').text('معطل ومجمد').removeClass('bg-success').addClass('bg-danger');
                $('#panelStatusBadge').html('<span class="badge bg-danger">معطل ومجمد</span>');
                $('#lblToggleActionText').text('تنشيط');
            }

            // Key-Value Properties
            $('#propCode').text(d.code);
            $('#propNameAr').text(d.nameAr || '-');
            $('#propNameEn').text(d.nameEn || '-');
            $('#propParent').text(d.parentCode && d.parentCode !== '-' ? `${d.parentCode} - ${d.parentName}` : 'حساب رئيسي جذري');
            $('#propLevel').html(`<span class="badge bg-light text-dark border">المستوى ${d.level}</span>`);
            $('#propNature').html(d.accountNature === 1 
                ? '<span class="badge bg-primary-subtle text-primary border">مدين (Debit)</span>' 
                : '<span class="badge bg-danger-subtle text-danger border">دائن (Credit)</span>');
            $('#propCategory').text(d.accountCategoryText || '-');
            $('#propIsGroup').text(d.isGroup ? 'مجموعة رئيسية (تجميعي لا يقبل قيود مباشرة)' : 'حساب حركة فرعي');
            $('#propIsTransactional').html(!d.isGroup 
                ? '<span class="text-success fw-bold"><i class="fa-solid fa-check me-1"></i>نعم (يقبل قيود اليومية)</span>' 
                : '<span class="text-muted"><i class="fa-solid fa-xmark me-1"></i>لا (حساب تجميعي)</span>');
            $('#propBranch').html(d.branchId 
                ? `<span class="badge bg-info text-dark"><i class="fa-solid fa-code-branch me-1"></i>${d.branchName}</span>` 
                : '<span class="badge bg-light text-muted border">عام (مشترك لكافة الفروع)</span>');
            $('#propCurrency').text(d.currencyCode || 'متعدد العملات');
            $('#propRequiresCostCenter').html(d.requiresCostCenter 
                ? '<span class="text-danger fw-bold"><i class="fa-solid fa-check me-1"></i>إلزامي</span>' 
                : '<span class="text-muted">غير إلزامي</span>');
            $('#propIsReconciliation').text(d.isReconciliationAccount ? 'نعم' : 'لا');
            $('#propUsage').text(d.accountUsageText || 'جميع الشاشات');
            $('#propCreatedAt').text(d.createdAt ? new Date(d.createdAt).toLocaleString('ar-EG') : '-');
            $('#propUpdatedAt').text(d.updatedAt ? new Date(d.updatedAt).toLocaleString('ar-EG') : 'لم يعدل');

            // Button actions logic
            if (d.isGroup) {
                $('#btnActionAddChildGroup').prop('disabled', false).show();
                $('#btnActionAddChildAccount').prop('disabled', false).show();
            } else {
                // Leaf accounts cannot have child accounts or groups
                $('#btnActionAddChildGroup').prop('disabled', true).hide();
                $('#btnActionAddChildAccount').prop('disabled', true).hide();
            }

            $('#btnActionEdit').attr('href', '@Url.Action("Edit", "Accounts")/' + d.id);
        }

        // ====================================================================
        // Search & Auto-Expand Engine
        // ====================================================================
        function executeTreeSearch(query) {
            $('.tree-node-item').removeClass('search-match');
            searchMatches = [];
            currentMatchCursor = -1;

            if (!query || query.trim() === '') {
                $('#searchMatchesTracker').addClass('d-none');
                return;
            }

            const cleanQ = query.trim().toLowerCase();

            rawTreeData.forEach(n => {
                const matchCode = (n.code || '').toLowerCase().includes(cleanQ);
                const matchAr = (n.nameAr || '').toLowerCase().includes(cleanQ);
                const matchEn = (n.nameEn || '').toLowerCase().includes(cleanQ);

                if (matchCode || matchAr || matchEn) {
                    searchMatches.push(n.id);
                    $(`#tree_node_${n.id}`).addClass('search-match');
                }
            });

            if (searchMatches.length > 0) {
                $('#searchMatchesTracker').removeClass('d-none');
                $('#matchCount').text(searchMatches.length);
                navigateMatch(1);
            } else {
                $('#searchMatchesTracker').addClass('d-none');
                showNotice(`لا توجد حسابات مطابقة للبحث: "${query}"`, 'warning');
            }
        }

        function navigateMatch(direction) {
            if (searchMatches.length === 0) return;

            currentMatchCursor += direction;
            if (currentMatchCursor >= searchMatches.length) currentMatchCursor = 0;
            if (currentMatchCursor < 0) currentMatchCursor = searchMatches.length - 1;

            $('#matchIndex').text(currentMatchCursor + 1);

            const targetId = searchMatches[currentMatchCursor];
            expandPathToNode(targetId);

            const el = $(`#tree_node_${targetId}`);
            if (el.length > 0) {
                // Scroll into view
                const container = $('#treeContainer');
                container.animate({
                    scrollTop: el.offset().top - container.offset().top + container.scrollTop() - 40
                }, 200);

                if (nodesMap[targetId]) {
                    selectNode(nodesMap[targetId]);
                }
            }
        }

        function expandPathToNode(nodeId) {
            let curr = nodesMap[nodeId];
            while (curr && curr.parentId) {
                const parentLi = $(`li[data-li-id="${curr.parentId}"]`);
                parentLi.children('ul').show();
                parentLi.find(`> .tree-node-item .toggle-icon i`).removeClass('fa-chevron-left').addClass('fa-chevron-down');
                curr = nodesMap[curr.parentId];
            }
        }

        // ====================================================================
        // Quick Create Child Modal
        // ====================================================================
        function openQuickCreateModal(parentNode, isGroup) {
            $('#quickCreateForm')[0].reset();
            $('#qcParentId').val(parentNode ? parentNode.id : '');
            
            if (parentNode) {
                $('#qcParentDisplay').text(`${parentNode.code} - ${parentNode.nameAr || parentNode.nameEn}`);
                $('#qcLevelBadge').text(`مستوى ${parentNode.level + 1}`);
                $('#qcCategory').val(parentNode.accountCategory);
                $('#qcNature').val(parentNode.accountNature);
            } else {
                $('#qcParentDisplay').text('حساب رئيسي جذري (بدون أب)');
                $('#qcLevelBadge').text('مستوى 1');
            }

            if (isGroup) {
                $('#qcTypeGroup').prop('checked', true);
                $('#qcBranchContainer').addClass('d-none');
                $('#qcBranchId').val('');
            } else {
                $('#qcTypeLeaf').prop('checked', true);
                $('#qcBranchContainer').removeClass('d-none');
                const defaultBranch = '@(currentBranchId ?? 0)';
                if (defaultBranch !== '0' && !@((hasAllBranches).ToString().ToLower())) {
                    $('#qcBranchId').val(defaultBranch);
                }
            }

            $('#quickCreateModal').modal('show');
            setTimeout(() => { $('#qcCode').focus(); }, 400);
        }

        function submitQuickCreate() {
            const code = $('#qcCode').val().trim();
            const nameAr = $('#qcNameAr').val().trim();
            const nameEn = $('#qcNameEn').val().trim();
            const parentId = parseInt($('#qcParentId').val()) || null;
            const isGroup = $('input[name="qcIsGroup"]:checked').val() === 'true';
            const branchIdVal = parseInt($('#qcBranchId').val()) || null;

            if (!code) {
                alert('يرجى إدخال كود الحساب.');
                return;
            }
            if (!nameAr) {
                alert('يرجى إدخال اسم الحساب بالعربية.');
                return;
            }

            $('#qcBtnSpinner').removeClass('d-none');
            $('#btnSubmitQuickCreate').prop('disabled', true);

            const payload = {
                ParentId: parentId,
                Code: code,
                NameAr: nameAr,
                NameEn: nameEn || nameAr,
                IsGroup: isGroup,
                BranchId: isGroup ? null : branchIdVal,
                AccountCategory: parseInt($('#qcCategory').val()),
                AccountNature: parseInt($('#qcNature').val()),
                CurrencyId: parseInt($('#qcCurrencyId').val()) || null,
                RequiresCostCenter: $('#qcRequiresCostCenter').is(':checked'),
                IsControlAccount: $('#qcIsControlAccount').is(':checked'),
                SubLedgerType: parseInt($('#qcSubLedgerType').val()) || 0,
                IsReconciliationAccount: $('#qcIsReconciliation').is(':checked')
            };

            const token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("QuickCreate", "Accounts")',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': token },
                data: JSON.stringify(payload),
                success: function (res) {
                    $('#qcBtnSpinner').addClass('d-none');
                    $('#btnSubmitQuickCreate').prop('disabled', false);

                    if (res.success) {
                        $('#quickCreateModal').modal('hide');
                        showNotice(res.message, 'success');
                        loadTreeData();
                    } else {
                        alert(res.message);
                    }
                },
                error: function (err) {
                    $('#qcBtnSpinner').addClass('d-none');
                    $('#btnSubmitQuickCreate').prop('disabled', false);
                    alert('حدث خطأ غير متوقع أثناء حفظ الحساب.');
                }
            });
        }

        // ====================================================================
        // Toggle Account Active / Inactive Status
        // ====================================================================
        function toggleAccountStatus(id) {
            const acc = nodesMap[id];
            if (!acc) return;

            const actionName = acc.isActive ? 'تجميد وتعطيل' : 'تنشيط';
            if (!confirm(`هل أنت متأكد من رغبتك في ${actionName} الحساب (${acc.code} - ${acc.nameAr})؟`)) return;

            const token = $('input[name="__RequestVerificationToken"]').val();

            $.post('@Url.Action("ToggleStatus", "Accounts")', { id: id, __RequestVerificationToken: token }, function (res) {
                if (res.success) {
                    showNotice(res.message, 'success');
                    acc.isActive = res.isActive;
                    selectNode(acc);
                    loadTreeData();
                } else {
                    alert(res.message);
                }
            }).fail(function () {
                alert('حدث خطأ أثناء تغيير حالة الحساب.');
            });
        }

        // ====================================================================
        // Delete Account
        // ====================================================================
        function deleteAccount(id) {
            const acc = nodesMap[id];
            if (!acc) return;

            if (!confirm(`هل أنت متأكد من رغبتك في حذف الحساب (${acc.code} - ${acc.nameAr}) نهائياً؟`)) return;

            const token = $('input[name="__RequestVerificationToken"]').val();

            $.post('@Url.Action("Delete", "Accounts")', { id: id, __RequestVerificationToken: token }, function (res) {
                if (res.success) {
                    showNotice(res.message, 'success');
                    currentSelectedNode = null;
                    $('#selectedAccountContent').addClass('d-none');
                    $('#noSelectionPlaceholder').removeClass('d-none');
                    loadTreeData();
                } else {
                    alert(res.message);
                }
            }).fail(function () {
                alert('حدث خطأ أثناء محاولة حذف الحساب.');
            });
        }

        // ====================================================================
        // Audit History Trail Modal
        // ====================================================================
        function openAuditModal(node) {
            $('#auditModalAccountCode').text(`${node.code} - ${node.nameAr}`);
            $('#auditLoadingSpinner').removeClass('d-none');
            $('#auditEmptyNotice').addClass('d-none');
            $('#auditListContainer').addClass('d-none');
            $('#auditTimeline').empty();
            $('#auditHistoryModal').modal('show');

            $.get('@Url.Action("GetAccountAudit", "Accounts")?id=' + node.id, function (res) {
                $('#auditLoadingSpinner').addClass('d-none');

                if (res.success && res.data && res.data.length > 0) {
                    $('#auditListContainer').removeClass('d-none');
                    let listHtml = '';
                    res.data.forEach(item => {
                        const dateStr = new Date(item.timestamp).toLocaleString('ar-EG');
                        const actionBadge = item.action === 'Create'
                            ? '<span class="badge bg-success">إنشاء</span>'
                            : (item.action === 'Update' ? '<span class="badge bg-warning text-dark">تعديل</span>' : '<span class="badge bg-danger">حذف</span>');

                        listHtml += `
                            <div class="list-group-item p-2 mb-2 border rounded">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div>
                                        ${actionBadge}
                                        <strong class="ms-1 text-dark">${item.userName || 'النظام'}</strong>
                                    </div>
                                    <small class="text-muted font-monospace">${dateStr}</small>
                                </div>
                                <div class="small text-secondary mb-1">${item.description || 'عملية على الحساب'}</div>
                                ${item.changedValues ? `<div class="bg-light p-1 rounded font-monospace small text-muted text-truncate" title="${item.changedValues}">التغييرات: ${item.changedValues}</div>` : ''}
                            </div>
                        `;
                    });
                    $('#auditTimeline').html(listHtml);
                } else {
                    $('#auditEmptyNotice').removeClass('d-none');
                }
            }).fail(function () {
                $('#auditLoadingSpinner').addClass('d-none');
                alert('تعذر تحميل سجل المراجعة للحساب.');
            });
        }

        // ====================================================================
        // Notifications Banner
        // ====================================================================
        function showNotice(msg, type = 'info') {
            const html = `
                <div class="alert alert-${type} alert-dismissible fade show shadow-sm py-2" role="alert">
                    <i class="fa-solid fa-circle-info me-1"></i> ${msg}
                    <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            $('#alertMessageContainer').html(html);
            setTimeout(() => { $('#alertMessageContainer .alert').alert('close'); }, 6000);
        }
    </script>
}
