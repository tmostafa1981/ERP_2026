@{
    ViewData["Title"] = "شجرة ودليل الحسابات (Chart of Accounts)";
    var parentAccounts = ViewBag.ParentAccounts as List<ERP.Domain.Entities.GLAccount> ?? new List<ERP.Domain.Entities.GLAccount>();
    var currencies = ViewBag.Currencies as List<ERP.Domain.Entities.Currency> ?? new List<ERP.Domain.Entities.Currency>();
    var branches = ViewBag.Branches as List<ERP.Domain.Entities.Branch> ?? new List<ERP.Domain.Entities.Branch>();
    bool hasAllBranches = ViewBag.HasAllBranches is bool b && b;
    int? currentBranchId = ViewBag.CurrentBranchId as int?;
    int? selectedParentId = ViewBag.SelectedParentId as int?;
}

<!-- DataTables CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0 text-primary">
                <i class="fa-solid fa-sitemap me-2"></i> دليل الحسابات الموحد (Chart of Accounts)
            </h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item">النواة المحاسبية</li>
                    <li class="breadcrumb-item active" aria-current="page">دليل الحسابات</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Tree" class="btn btn-primary">
                <i class="fa-solid fa-sitemap me-1"></i> الشجرة التفاعلية (Tree View)
            </a>
            <a asp-action="DownloadTemplate" class="btn btn-outline-success">
                <i class="fa-solid fa-file-excel me-1"></i> تحميل نموذج Excel
            </a>
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#importExcelModal">
                <i class="fa-solid fa-file-import me-1"></i> استيراد من Excel
            </button>
            <a asp-action="Create" asp-route-isGroup="true" class="btn btn-outline-primary">
                <i class="fa-solid fa-folder-plus me-1"></i> إضافة مجموعة رئيسية
            </a>
            <a asp-action="Create" asp-route-isGroup="false" class="btn btn-outline-secondary">
                <i class="fa-solid fa-plus me-1"></i> إضافة حساب حركة
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-1"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabs: Table View vs Tree View -->
    <ul class="nav nav-pills mb-3" id="coaTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold" id="table-tab" data-bs-toggle="tab" data-bs-target="#tabTableView" type="button" role="tab">
                <i class="fa-solid fa-table-list me-1"></i> عرض الجدول والبحث التفصيلي
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="tree-tab" data-bs-toggle="tab" data-bs-target="#tabTreeView" type="button" role="tab">
                <i class="fa-solid fa-network-wired me-1"></i> العرض الشجري الهرمي (Tree View)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="coaTabsContent">
        <!-- Tab 1: Table View -->
        <div class="tab-pane fade show active" id="tabTableView" role="tabpanel">
            <!-- Filter Card -->
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body py-2">
                    <div class="row g-2 align-items-center">
                        <!-- Parent Account Filter -->
                        <div class="col-md-3">
                            <label class="form-label small fw-bold mb-1">تصفية بالحساب الأب:</label>
                            <select id="filterParentId" class="form-select form-select-sm select2">
                                <option value="">-- جميع الحسابات الأبوية --</option>
                                @foreach (var p in parentAccounts)
                                {
                                    if (selectedParentId.HasValue && selectedParentId.Value == p.Id)
                                    {
                                        <option value="@p.Id" selected>@p.Code - @p.LocalizedName</option>
                                    }
                                    else
                                    {
                                        <option value="@p.Id">@p.Code - @p.LocalizedName</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Category Filter -->
                        <div class="col-md-2">
                            <label class="form-label small fw-bold mb-1">التصنيف المحاسبي:</label>
                            <select id="filterCategoryId" class="form-select form-select-sm">
                                <option value="">-- الكل --</option>
                                <option value="1">1 - الأصول</option>
                                <option value="2">2 - الخصوم</option>
                                <option value="3">3 - حقوق الملكية</option>
                                <option value="4">4 - الإيرادات</option>
                                <option value="5">5 - المصروفات</option>
                            </select>
                        </div>

                        <!-- Is Group Filter -->
                        <div class="col-md-2">
                            <label class="form-label small fw-bold mb-1">نوع الحساب:</label>
                            <select id="filterIsGroup" class="form-select form-select-sm">
                                <option value="">-- الكل --</option>
                                <option value="false">حساب حركة (يقبل التوجيه)</option>
                                <option value="true">مجموعة رئيسية (تجميعي)</option>
                            </select>
                        </div>

                        <!-- Currency Filter -->
                        <div class="col-md-2">
                            <label class="form-label small fw-bold mb-1">العملة:</label>
                            <select id="filterCurrencyId" class="form-select form-select-sm">
                                <option value="">-- جميع العملات --</option>
                                @foreach (var c in currencies)
                                {
                                    <option value="@c.Id">@c.Code - @c.LocalizedName</option>
                                }
                            </select>
                        </div>

                        @if (branches.Any() && hasAllBranches)
                        {
                            <!-- Branch Filter -->
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1">الفرع:</label>
                                <select id="filterBranchId" class="form-select form-select-sm select2">
                                    <option value="">-- كافة الفروع --</option>
                                    @foreach (var br in branches)
                                    {
                                        <option value="@br.Id">@br.Code - @br.LocalizedName</option>
                                    }
                                </select>
                            </div>
                        }

                        <!-- Reset Filter Button -->
                        <div class="@(branches.Any() && hasAllBranches ? "col-md-1" : "col-md-3") d-flex align-items-end">
                            <button type="button" id="btnResetFilters" class="btn btn-sm btn-outline-secondary w-100 mt-4">
                                <i class="fa-solid fa-filter-circle-xmark me-1"></i> إعادة ضبط
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Accounts Table Card -->
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <table id="accountsTable" class="table table-striped table-hover align-middle w-100">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 100px;">كود الحساب</th>
                                <th>اسم الحساب</th>
                                <th>الحساب الأب</th>
                                <th style="width: 70px;">المستوى</th>
                                <th style="width: 90px;">التصنيف</th>
                                <th style="width: 70px;">الطبيعة</th>
                                <th style="width: 100px;">النوع</th>
                                <th>الخصائص والرقابة</th>
                                <th style="width: 90px;">العملة</th>
                                <th style="width: 70px;">الحالة</th>
                                <th style="width: 100px;" class="text-center">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tab 2: Tree View -->
        <div class="tab-pane fade" id="tabTreeView" role="tabpanel">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                    <span class="fw-bold"><i class="fa-solid fa-network-wired me-1"></i> الهيكل التفاعلي لشجرة الحسابات</span>
                    <div class="d-flex gap-2">
                        <a asp-action="Tree" class="btn btn-sm btn-primary">
                            <i class="fa-solid fa-up-right-from-square me-1"></i> فتح الشاشة الكاملة المنقسمة (Split-Screen Tree)
                        </a>
                        <button type="button" id="btnExpandAll" class="btn btn-sm btn-outline-primary">
                            <i class="fa-solid fa-expand me-1"></i> توسيع الكل
                        </button>
                        <button type="button" id="btnCollapseAll" class="btn btn-sm btn-outline-secondary">
                            <i class="fa-solid fa-compress me-1"></i> طي الكل
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div id="treeLoadingSpinner" class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <div class="mt-2 text-muted">جاري تحميل شجرة الحسابات...</div>
                    </div>
                    <div id="treeContainer" class="p-2 d-none"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Excel Import Modal -->
<div class="modal fade" id="importExcelModal" tabindex="-1" aria-labelledby="importExcelModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="importExcelModalLabel">
                    <i class="fa-solid fa-file-excel me-2"></i> استيراد دليل الحسابات من ملف Excel
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Guidance Alert -->
                <div class="alert alert-info d-flex align-items-center mb-3">
                    <i class="fa-solid fa-circle-info fs-4 me-3"></i>
                    <div>
                        <strong>تنبيه هام:</strong> يرجى التأكد من تطابق أعمدة الملف مع النموذج المعتمد للنظام. إذا لم تكن قمت بتحميل النموذج مسبقاً، يمكنك تحميله بالضغط على:
                        <a asp-action="DownloadTemplate" class="alert-link text-decoration-underline ms-1 fw-bold">تحميل النموذج القياسي المعتمد (.xlsx)</a>.
                    </div>
                </div>

                <!-- Step 1: Upload Form -->
                <div class="card border-0 shadow-sm mb-3 bg-light">
                    <div class="card-body">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-7">
                                <label for="excelFileInput" class="form-label fw-bold small">اختر ملف Excel أو CSV (.xlsx / .csv):</label>
                                <input type="file" id="excelFileInput" class="form-control" accept=".xlsx,.csv" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold small d-block">خيارات المعالجة:</label>
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" id="chkUpdateExisting" checked>
                                    <label class="form-check-label small" for="chkUpdateExisting">تحديث الحسابات الموجودة مسبقاً</label>
                                </div>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="button" id="btnPreviewExcel" class="btn btn-primary w-100 mt-3" disabled>
                                    <i class="fa-solid fa-magnifying-glass me-1"></i> فحص ومعاينة
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Loading Spinner -->
                <div id="importSpinner" class="text-center py-5 d-none">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">جاري المعالجة...</span>
                    </div>
                    <div class="mt-3 fw-bold text-muted" id="spinnerText">جاري فحص وتدقيق بنية شجرة الحسابات...</div>
                </div>

                <!-- Step 2: Preview & Validation Results -->
                <div id="importPreviewContainer" class="d-none">
                    <!-- Metrics Summary -->
                    <div class="row g-2 mb-3">
                        <div class="col-md-2 col-6">
                            <div class="card border-0 bg-primary bg-opacity-10 text-primary text-center py-2">
                                <div class="fs-4 fw-bold" id="metricTotalRows">0</div>
                                <div class="small">إجمالي السطور</div>
                            </div>
                        </div>
                        <div class="col-md-2 col-6">
                            <div class="card border-0 bg-success bg-opacity-10 text-success text-center py-2">
                                <div class="fs-4 fw-bold" id="metricValidRows">0</div>
                                <div class="small">سطور صالحة</div>
                            </div>
                        </div>
                        <div class="col-md-2 col-6">
                            <div class="card border-0 bg-danger bg-opacity-10 text-danger text-center py-2">
                                <div class="fs-4 fw-bold" id="metricErrorRows">0</div>
                                <div class="small">سطور بها أخطاء</div>
                            </div>
                        </div>
                        <div class="col-md-2 col-6">
                            <div class="card border-0 bg-info bg-opacity-10 text-info text-center py-2">
                                <div class="fs-4 fw-bold" id="metricNewGroups">0</div>
                                <div class="small">مجموعات رئيسية</div>
                            </div>
                        </div>
                        <div class="col-md-2 col-6">
                            <div class="card border-0 bg-info bg-opacity-10 text-info text-center py-2">
                                <div class="fs-4 fw-bold" id="metricNewAccounts">0</div>
                                <div class="small">حسابات حركة</div>
                            </div>
                        </div>
                        <div class="col-md-2 col-6">
                            <div class="card border-0 bg-warning bg-opacity-10 text-warning text-center py-2">
                                <div class="fs-4 fw-bold" id="metricUpdates">0</div>
                                <div class="small">سيتم تحديثها</div>
                            </div>
                        </div>
                    </div>

                    <!-- Errors alert if any -->
                    <div id="importErrorAlert" class="alert alert-danger d-none mb-3">
                        <div class="fw-bold mb-1"><i class="fa-solid fa-triangle-exclamation me-1"></i> تنبيه: توجد سطور بها أخطاء في ملف الإكسيل لن يتم استيرادها:</div>
                        <ul id="importErrorList" class="mb-0 small ps-3"></ul>
                    </div>

                    <!-- Preview Table -->
                    <div class="table-responsive border rounded" style="max-height: 380px;">
                        <table class="table table-sm table-striped table-hover mb-0 align-middle">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th style="width: 50px;">السطر</th>
                                    <th style="width: 100px;">كود الحساب</th>
                                    <th>اسم الحساب</th>
                                    <th style="width: 90px;">كود الأب</th>
                                    <th style="width: 100px;">النوع</th>
                                    <th style="width: 80px;">التصنيف</th>
                                    <th style="width: 60px;">طبيعة</th>
                                    <th style="width: 90px;">الرقابة</th>
                                    <th style="width: 70px;">العملة</th>
                                    <th style="width: 100px;">الحالة</th>
                                    <th>ملاحظات الفحص والتحقق</th>
                                </tr>
                            </thead>
                            <tbody id="previewTableBody"></tbody>
                        </table>
                    </div>
                </div>

                <!-- Execution Result Alert -->
                <div id="importResultAlert" class="alert d-none mt-3" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
                <button type="button" id="btnExecuteImport" class="btn btn-success" disabled>
                    <i class="fa-solid fa-cloud-arrow-up me-1"></i> تنفيذ الاستيراد وحفظ البيانات
                </button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

    <script>
        let accountsTable = null;
        let treeLoaded = false;

        $(document).ready(function () {
            $('.select2').select2({ theme: 'bootstrap-5', width: '100%', dir: 'rtl' });

            accountsTable = $('#accountsTable').DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: '@Url.Action("LoadTableData", "Accounts")',
                    type: 'POST',
                    data: function (d) {
                        d.parentId = $('#filterParentId').val();
                        d.categoryId = $('#filterCategoryId').val();
                        d.currencyId = $('#filterCurrencyId').val();
                        d.isGroup = $('#filterIsGroup').val();
                        d.branchId = $('#filterBranchId').val();
                        d.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();
                    }
                },
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json'
                },
                columns: [
                    {
                        data: 'code',
                        render: function (data) {
                            return `<span class="fw-bold font-monospace text-primary">${data}</span>`;
                        }
                    },
                    {
                        data: 'name',
                        render: function (data, type, row) {
                            return `<div class="fw-bold">${data}</div><small class="text-muted">${row.nameEn || ''}</small>`;
                        }
                    },
                    { data: 'parentName' },
                    {
                        data: 'level',
                        className: 'text-center',
                        render: function (data) {
                            return `<span class="badge bg-light text-dark border">مستوى ${data}</span>`;
                        }
                    },
                    {
                        data: 'accountCategoryText',
                        render: function (data) {
                            return `<span class="badge bg-secondary">${data}</span>`;
                        }
                    },
                    {
                        data: 'accountNatureText',
                        render: function (data, type, row) {
                            if (row.accountNatureCode === 1) {
                                return `<span class="badge bg-primary">مدين</span>`;
                            } else {
                                return `<span class="badge bg-danger">دائن</span>`;
                            }
                        }
                    },
                    {
                        data: 'isGroup',
                        render: function (data) {
                            return data
                                ? `<span class="badge bg-secondary"><i class="fa-solid fa-folder me-1"></i>مجموعة</span>`
                                : `<span class="badge bg-success"><i class="fa-solid fa-file-lines me-1"></i>حركة</span>`;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function (data, type, row) {
                            let badges = '';
                            if (row.branchId) {
                                badges += `<span class="badge bg-info text-dark me-1" title="مخصص للفرع"><i class="fa-solid fa-code-branch me-1"></i>${row.branchName}</span>`;
                            }
                            if (row.isControlAccount) {
                                badges += `<span class="badge bg-warning text-dark me-1" title="حساب مراقبة"><i class="fa-solid fa-shield-halved me-1"></i>مراقبة (${row.subLedgerTypeText || ''})</span>`;
                            }
                            if (row.isReconciliationAccount) {
                                badges += `<span class="badge bg-info text-dark me-1" title="حساب تسوية"><i class="fa-solid fa-scale-balanced me-1"></i>تسوية</span>`;
                            }
                            if (row.requiresCostCenter) {
                                badges += `<span class="badge bg-danger bg-opacity-75 text-white me-1" title="يلزم مركز تكلفة"><i class="fa-solid fa-bullseye me-1"></i>مركز تكلفة</span>`;
                            }
                            if (row.accountUsageText) {
                                badges += `<span class="badge bg-light text-muted border">${row.accountUsageText}</span>`;
                            }
                            return badges || '-';
                        }
                    },
                    {
                        data: 'currencyCode',
                        render: function (data) {
                            return `<span class="badge bg-light text-dark border">${data}</span>`;
                        }
                    },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data
                                ? `<span class="badge bg-success">نشط</span>`
                                : `<span class="badge bg-secondary">غير نشط</span>`;
                        }
                    },
                    {
                        data: 'id',
                        orderable: false,
                        className: 'text-center',
                        render: function (data) {
                            return `
                                <div class="btn-group btn-group-sm">
                                    <a href="@Url.Action("Edit", "Accounts")/${data}" class="btn btn-outline-primary" title="تعديل">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" onclick="deleteAccount(${data})" title="حذف">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </div>
                            `;
                        }
                    }
                ],
                order: [[0, 'asc']]
            });

            // Filter changes
            $('#filterParentId, #filterCategoryId, #filterCurrencyId, #filterIsGroup, #filterBranchId').change(function () {
                accountsTable.ajax.reload();
            });

            $('#btnResetFilters').click(function () {
                $('#filterParentId').val('').trigger('change');
                $('#filterCategoryId').val('');
                $('#filterCurrencyId').val('');
                $('#filterIsGroup').val('');
                if ($('#filterBranchId').length) {
                    $('#filterBranchId').val('').trigger('change');
                }
                accountsTable.ajax.reload();
            });

            // Tree Tab Activation
            $('#tree-tab').on('shown.bs.tab', function () {
                if (!treeLoaded) {
                    loadTreeView();
                }
            });

            // Excel Input handling
            $('#excelFileInput').change(function () {
                if (this.files && this.files.length > 0) {
                    $('#btnPreviewExcel').prop('disabled', false);
                } else {
                    $('#btnPreviewExcel').prop('disabled', true);
                }
                $('#btnExecuteImport').prop('disabled', true);
                $('#importPreviewContainer').addClass('d-none');
                $('#importResultAlert').addClass('d-none');
            });

            // Preview Excel Click
            $('#btnPreviewExcel').click(function () {
                const fileInput = document.getElementById('excelFileInput');
                if (!fileInput.files || fileInput.files.length === 0) return;

                const formData = new FormData();
                formData.append('excelFile', fileInput.files[0]);
                formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());

                $('#importSpinner').removeClass('d-none');
                $('#importPreviewContainer').addClass('d-none');
                $('#importResultAlert').addClass('d-none');
                $('#btnPreviewExcel').prop('disabled', true);
                $('#btnExecuteImport').prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("PreviewExcelImport", "Accounts")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        $('#importSpinner').addClass('d-none');
                        $('#btnPreviewExcel').prop('disabled', false);

                        if (res.success && res.data) {
                            const p = res.data;
                            $('#metricTotalRows').text(p.totalRows);
                            $('#metricValidRows').text(p.validCount);
                            $('#metricErrorRows').text(p.errorCount);
                            $('#metricNewGroups').text(p.groupCount);
                            $('#metricNewAccounts').text(p.accountCount);
                            $('#metricUpdates').text(p.warningCount);

                            // Error list
                            if (p.errorCount > 0) {
                                const errorList = $('#importErrorList');
                                errorList.empty();
                                p.rows.filter(r => !r.isValid).forEach(r => {
                                    r.errors.forEach(e => {
                                        errorList.append(`<li>سطر ${r.rowNumber} (${r.code}): ${e}</li>`);
                                    });
                                });
                                $('#importErrorAlert').removeClass('d-none');
                            } else {
                                $('#importErrorAlert').addClass('d-none');
                            }

                            // Render table rows
                            const tbody = $('#previewTableBody');
                            tbody.empty();
                            p.rows.forEach(r => {
                                const trClass = !r.isValid ? 'table-danger' : (r.existsInDb ? 'table-warning' : '');
                                const statusBadge = !r.isValid
                                    ? `<span class="badge bg-danger">خطأ</span>`
                                    : (r.existsInDb ? `<span class="badge bg-warning text-dark">موجود مسبقاً</span>` : `<span class="badge bg-success">جديد</span>`);

                                const notes = [];
                                r.errors.forEach(e => notes.push(`<div class="text-danger small fw-bold"><i class="fa-solid fa-circle-xmark me-1"></i>${e}</div>`));
                                r.warnings.forEach(w => notes.push(`<div class="text-muted small"><i class="fa-solid fa-circle-info me-1"></i>${w}</div>`));

                                tbody.append(`
                                    <tr class="${trClass}">
                                        <td class="text-center font-monospace">${r.rowNumber}</td>
                                        <td class="font-monospace fw-bold">${r.code}</td>
                                        <td><div>${r.nameAr}</div><small class="text-muted">${r.nameEn || ''}</small></td>
                                        <td class="font-monospace text-muted">${r.parentCode || '-'}</td>
                                        <td><span class="badge ${r.isGroup ? 'bg-secondary' : 'bg-primary'}">${r.typeStr}</span></td>
                                        <td><span class="badge bg-light text-dark border">${r.categoryStr}</span></td>
                                        <td><span class="badge ${r.natureStr === 'مدين' ? 'bg-primary' : 'bg-danger'}">${r.natureStr}</span></td>
                                        <td>${r.isControlAccount ? '<span class="badge bg-warning text-dark">مراقبة: ' + r.subLedgerTypeStr + '</span>' : '-'}</td>
                                        <td><span class="badge bg-light text-dark border">${r.currencyCode || 'متعدد'}</span></td>
                                        <td>${statusBadge}</td>
                                        <td>${notes.join('') || '<span class="text-success small"><i class="fa-solid fa-check me-1"></i>صالح</span>'}</td>
                                    </tr>
                                `);
                            });

                            $('#importPreviewContainer').removeClass('d-none');

                            if (p.validCount > 0 && p.errorCount === 0) {
                                $('#btnExecuteImport').prop('disabled', false);
                            } else {
                                $('#btnExecuteImport').prop('disabled', true);
                            }
                        } else {
                            alert(res.message || 'حدث خطأ أثناء فحص الملف.');
                        }
                    },
                    error: function () {
                        $('#importSpinner').addClass('d-none');
                        $('#btnPreviewExcel').prop('disabled', false);
                        alert('حدث خطأ في الاتصال بالخادم.');
                    }
                });
            });

            // Execute Import Click
            $('#btnExecuteImport').click(function () {
                const fileInput = document.getElementById('excelFileInput');
                if (!fileInput.files || fileInput.files.length === 0) return;

                if (!confirm('هل أنت متأكد من رغبتك في استيراد شجرة الحسابات وتحديث قاعدة البيانات؟')) return;

                const formData = new FormData();
                formData.append('excelFile', fileInput.files[0]);
                formData.append('updateExisting', $('#chkUpdateExisting').is(':checked'));
                formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());

                $('#spinnerText').text('جاري استيراد الحسابات وحفظ البيانات في قاعدة البيانات...');
                $('#importSpinner').removeClass('d-none');
                $('#btnExecuteImport').prop('disabled', true);
                $('#btnPreviewExcel').prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("ConfirmExcelImport", "Accounts")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        $('#importSpinner').addClass('d-none');
                        $('#btnPreviewExcel').prop('disabled', false);
                        const alertBox = $('#importResultAlert');
                        alertBox.removeClass('d-none alert-success alert-danger');

                        if (res.success && res.data) {
                            alertBox.addClass('alert-success');
                            alertBox.html(`
                                <div class="d-flex align-items-center">
                                    <i class="fa-solid fa-circle-check fs-3 me-3 text-success"></i>
                                    <div>
                                        <h6 class="fw-bold mb-1">${res.data.message}</h6>
                                        <div class="small">تم إنشاء ${res.data.groupsCreated} مجموعة و ${res.data.accountsCreated} حساب جديد، وتحديث ${res.data.groupsUpdated} مجموعة و ${res.data.accountsUpdated} حساب قائم.</div>
                                    </div>
                                </div>
                            `);
                            accountsTable.ajax.reload(null, false);
                            treeLoaded = false; // reload tree next time
                        } else {
                            const errMsg = res.message || (res.data && res.data.message) || 'فشل الاستيراد، يرجى مراجعة الأخطاء في الجدول.';
                            alertBox.addClass('alert-danger');
                            alertBox.html(`<i class="fa-solid fa-triangle-exclamation me-1"></i> ${errMsg}`);
                            $('#btnExecuteImport').prop('disabled', false);
                        }
                    },
                    error: function () {
                        $('#importSpinner').addClass('d-none');
                        $('#btnExecuteImport').prop('disabled', false);
                        alert('حدث خطأ في الاتصال بالخادم أثناء الاستيراد.');
                    }
                });
            });
        });

        function loadTreeView() {
            $('#treeLoadingSpinner').removeClass('d-none');
            $('#treeContainer').addClass('d-none');

            $.get('@Url.Action("GetTreeData", "Accounts")', function (nodes) {
                $('#treeLoadingSpinner').addClass('d-none');
                $('#treeContainer').removeClass('d-none');
                treeLoaded = true;

                // Render tree hierarchy
                const container = $('#treeContainer');
                container.empty();

                const nodeMap = {};
                nodes.forEach(n => {
                    nodeMap[n.id] = { ...n, children: [] };
                });

                const roots = [];
                nodes.forEach(n => {
                    if (n.parent && n.parent !== '#' && nodeMap[n.parent]) {
                        nodeMap[n.parent].children.push(nodeMap[n.id]);
                    } else {
                        roots.push(nodeMap[n.id]);
                    }
                });

                function renderNode(node) {
                    const hasChildren = node.children && node.children.length > 0;
                    const iconClass = node.isGroup ? 'fa-folder text-warning' : 'fa-file-lines text-primary';
                    const badgeType = node.isGroup
                        ? '<span class="badge bg-secondary ms-2">مجموعة</span>'
                        : '<span class="badge bg-success ms-2">حساب حركة</span>';
                    const controlBadge = node.isControl ? '<span class="badge bg-warning text-dark ms-1">مراقبة</span>' : '';

                    let html = `<li class="my-1 list-unstyled">`;
                    html += `
                        <div class="d-flex align-items-center p-2 rounded border bg-white shadow-sm">
                            ${hasChildren ? '<i class="fa-solid fa-chevron-down me-2 text-muted tree-toggle" style="cursor: pointer; width: 14px;"></i>' : '<span style="width: 14px;" class="me-2"></span>'}
                            <i class="fa-solid ${iconClass} me-2"></i>
                            <span class="fw-bold font-monospace text-primary me-2">${node.code}</span>
                            <span class="fw-bold text-dark">${node.text.split(' - ')[1] || node.text}</span>
                            ${badgeType}
                            ${controlBadge}
                            <span class="badge bg-light text-dark border ms-2">مستوى ${node.level}</span>
                            <span class="badge bg-light text-muted border ms-1">${node.nature}</span>
                            <div class="ms-auto">
                                <a href="@Url.Action("Edit", "Accounts")/${node.id}" class="btn btn-sm btn-outline-primary py-0 px-2" title="تعديل"><i class="fa-solid fa-pen-to-square"></i></a>
                            </div>
                        </div>
                    `;

                    if (hasChildren) {
                        html += `<ul class="ps-4 mt-1 border-start border-2 border-primary border-opacity-25">`;
                        node.children.forEach(child => {
                            html += renderNode(child);
                        });
                        html += `</ul>`;
                    }
                    html += `</li>`;
                    return html;
                }

                let treeHtml = '<ul class="list-unstyled p-0">';
                roots.forEach(r => {
                    treeHtml += renderNode(r);
                });
                treeHtml += '</ul>';
                container.html(treeHtml);

                $('.tree-toggle').click(function () {
                    $(this).closest('li').children('ul').toggle();
                    $(this).toggleClass('fa-chevron-down fa-chevron-left');
                });
            });

            $('#btnExpandAll').click(function () {
                $('#treeContainer ul').show();
                $('.tree-toggle').removeClass('fa-chevron-left').addClass('fa-chevron-down');
            });

            $('#btnCollapseAll').click(function () {
                $('#treeContainer > ul > li > ul').hide();
                $('.tree-toggle').removeClass('fa-chevron-down').addClass('fa-chevron-left');
            });
        }

        function deleteAccount(id) {
            if (!confirm('هل أنت متأكد من رغبتك في حذف هذا الحساب؟')) return;

            const token = $('input[name="__RequestVerificationToken"]').val();

            $.post('@Url.Action("Delete", "Accounts")', { id: id, __RequestVerificationToken: token }, function (res) {
                if (res.success) {
                    accountsTable.ajax.reload(null, false);
                    treeLoaded = false;
                } else {
                    alert(res.message);
                }
            }).fail(function () {
                alert('حدث خطأ أثناء محاولة الحذف.');
            });
        }
    </script>
}
