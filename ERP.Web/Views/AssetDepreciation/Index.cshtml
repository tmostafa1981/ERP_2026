@model List<ERP.Application.DTOs.FixedAssets.DepreciationRunListDto>
@{
    ViewData["Title"] = "عمليات إهلاك الأصول الثابتة";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-1 text-primary"><i class="fas fa-play-circle me-2"></i>عمليات إهلاك الأصول الثابتة</h3>
            <p class="text-muted small mb-0">سجل عمليات تشغيل الإهلاك الدوري، القيود المحاسبية المرحلة، ومتابعة حالات الاعتماد والعكس</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="FixedAssets" asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-cube me-1"></i>سجل الأصول
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>تشغيل إهلاك جديد
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-1"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-1"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">الفرع</label>
                    <select name="branchId" class="form-select form-select-sm" asp-items="ViewBag.Branches">
                        <option value="">-- كافة الفروع --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">السنة المالية</label>
                    <select name="fiscalYearId" class="form-select form-select-sm" asp-items="ViewBag.FiscalYears">
                        <option value="">-- كافة السنوات --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-sm btn-primary w-100">
                        <i class="fas fa-filter me-1"></i>تصفية
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="table-light">
                        <tr>
                            <th>رقم العملية</th>
                            <th>تاريخ الإهلاك</th>
                            <th>السنة المالية</th>
                            <th>الشهر / الفترة</th>
                            <th>الفرع</th>
                            <th>عدد الأصول</th>
                            <th>إجمالي الإهلاك</th>
                            <th>الحالة</th>
                            <th>القيد المحاسبي</th>
                            <th>المستخدم</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="11" class="text-muted py-5">لا توجد عمليات إهلاك مسجلة حتى الآن.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var r in Model)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@r.Id" class="fw-bold text-decoration-none">
                                            @r.RunNumber
                                        </a>
                                    </td>
                                    <td>@r.RunDate.ToString("yyyy-MM-dd")</td>
                                    <td>@r.FiscalYearName</td>
                                    <td>@r.FiscalPeriodName</td>
                                    <td>@r.BranchName</td>
                                    <td><span class="badge bg-primary rounded-pill">@r.AssetsCount</span></td>
                                    <td class="fw-bold text-success">@r.TotalDepreciationAmount.ToString("N2")</td>
                                    <td>
                                        @{
                                            var badgeClass = r.Status switch {
                                                ERP.Domain.Enums.DepreciationRunStatus.Approved => "bg-success",
                                                ERP.Domain.Enums.DepreciationRunStatus.Reversed => "bg-danger",
                                                _ => "bg-warning text-dark"
                                            };
                                        }
                                        <span class="badge @badgeClass">@r.StatusName</span>
                                    </td>
                                    <td>
                                        @if (r.JournalEntryId.HasValue)
                                        {
                                            <a asp-controller="JournalEntries" asp-action="Details" asp-route-id="@r.JournalEntryId" class="badge bg-light text-dark border text-decoration-none">
                                                <i class="fas fa-file-invoice me-1"></i>@(r.JournalEntryNumber ?? $"قيد #{r.JournalEntryId}")
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="small text-muted">@r.CreatedByUserName</td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-outline-info" title="عرض التفاصيل">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Print" asp-route-id="@r.Id" target="_blank" class="btn btn-outline-secondary" title="طباعة">
                                                <i class="fas fa-print"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
