@model IEnumerable<ERP.Domain.Entities.ItemUnit>
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ERP.Web.Resources.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["ItemUnits"];
    var items = ViewBag.Items as IEnumerable<ERP.Domain.Entities.Item> ?? Enumerable.Empty<ERP.Domain.Entities.Item>();
    var units = ViewBag.Units as IEnumerable<ERP.Domain.Entities.Unit> ?? Enumerable.Empty<ERP.Domain.Entities.Unit>();
    var currentItem = ViewBag.CurrentItem as ERP.Domain.Entities.Item;
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-3 border-bottom gap-2">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--erp-text-dark); font-size: 18px;">
            <i class="fa-solid fa-layer-group text-primary me-2 ms-0"></i> @Localizer["ItemUnits"]
            @if (currentItem != null)
            {
                <span class="text-secondary small fw-normal">(@currentItem.LocalizedName - @currentItem.Code)</span>
            }
        </h4>
        <span class="text-muted" style="font-size: 12.5px;">@Localizer["ManageItemUnits"] (@ViewBag.TotalCount)</span>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Item" asp-action="Index" class="btn btn-erp-outline">
            <i class="fa-solid fa-arrow-left me-1 ms-0"></i> @Localizer["Items"]
        </a>
        <button type="button" class="btn btn-erp-primary" data-bs-toggle="modal" data-bs-target="#createItemUnitModal">
            <i class="fa-solid fa-plus me-1 ms-0"></i> @Localizer["AddNewUnit"]
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show p-2 mb-3" role="alert" style="font-size: 12.5px;">
        <i class="fa-solid fa-circle-check me-2 ms-0"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close p-2" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show p-2 mb-3" role="alert" style="font-size: 12.5px;">
        <i class="fa-solid fa-circle-exclamation me-2 ms-0"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close p-2" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search & Filter Toolbar -->
<div class="erp-card mb-3">
    <div class="erp-card-body p-2">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5 col-lg-4">
                <select name="itemId" class="form-select form-select-sm erp-form-control">
                    <option value="">-- @Localizer["Items"] (@Localizer["All"]) --</option>
                    @foreach (var i in items)
                    {
                        <option value="@i.Id" selected="@(ViewBag.ItemId != null && (int)ViewBag.ItemId == i.Id)">@i.LocalizedName (@i.Code)</option>
                    }
                </select>
            </div>
            <div class="col-md-4 col-lg-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control erp-form-control" placeholder="@Localizer["Search"]..." />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-erp-primary btn-sm px-3">@Localizer["Search"]</button>
                @if (!string.IsNullOrEmpty(ViewBag.SearchString as string) || ViewBag.ItemId != null)
                {
                    <a asp-action="Index" class="btn btn-erp-outline btn-sm">@Localizer["Cancel"]</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Desktop Data Grid -->
<div class="erp-table-container">
    <table class="erp-table">
        <thead>
            <tr>
                <th>@Localizer["Items"]</th>
                <th style="width: 130px;">@Localizer["Unit"]</th>
                <th style="width: 140px;" class="text-center">@Localizer["ConversionFactor"]</th>
                <th style="width: 120px;" class="text-end">@Localizer["SalesPrice"]</th>
                <th style="width: 120px;" class="text-end">@Localizer["PurchasePrice"]</th>
                <th style="width: 110px;" class="text-center">@Localizer["DefaultSales"]</th>
                <th style="width: 110px;" class="text-center">@Localizer["DefaultPurchase"]</th>
                <th style="width: 90px;" class="text-center">@Localizer["Status"]</th>
                <th style="width: 130px;" class="text-center">@Localizer["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@(item.Item?.LocalizedName ?? "-")</div>
                            <span class="text-muted small">@(item.Item?.Code ?? "")</span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="fa-solid fa-ruler-combined me-1"></i>@(item.Unit?.LocalizedName ?? "-") (@(item.Unit?.Code ?? ""))
                            </span>
                        </td>
                        <td class="text-center fw-bold">@item.ConversionFactor.ToString("0.####")</td>
                        <td class="text-end">@item.SalesPrice.ToString("N2")</td>
                        <td class="text-end">@item.PurchasePrice.ToString("N2")</td>
                        <td class="text-center">
                            @if (item.IsDefaultSales)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-2 py-1">
                                    <i class="fa-solid fa-check me-1"></i>@Localizer["Yes"]
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (item.IsDefaultPurchase)
                            {
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-2 py-1">
                                    <i class="fa-solid fa-check me-1"></i>@Localizer["Yes"]
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-2 py-1">@Localizer["Active"]</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle px-2 py-1">@Localizer["Inactive"]</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-erp-outline p-1 px-2" title="@Localizer["Edit"]" data-bs-toggle="modal" data-bs-target="#editModal_@item.Id">
                                    <i class="fa-solid fa-pen-to-square text-primary"></i>
                                </button>
                                <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-erp-outline p-1 px-2" title="@(item.IsActive ? Localizer["Inactive"] : Localizer["Active"])">
                                        <i class="fa-solid @(item.IsActive ? "fa-ban text-warning" : "fa-check text-success")"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline m-0" onsubmit="return confirm('@Localizer["ConfirmDelete"]');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-erp-outline p-1 px-2" title="@Localizer["Delete"]">
                                        <i class="fa-solid fa-trash text-danger"></i>
                                    </button>
                                </form>
                            </div>

                            <!-- Edit Modal -->
                            <div class="modal fade text-start" id="editModal_@item.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow">
                                        <form asp-action="Edit" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id" value="@item.Id" />
                                            <div class="modal-header bg-light py-2">
                                                <h6 class="modal-title fw-bold"><i class="fa-solid fa-pen text-primary me-2"></i> @Localizer["Edit"] - @(item.Unit?.LocalizedName ?? "")</h6>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body p-3">
                                                <div class="mb-2">
                                                    <label class="form-label small fw-bold">@Localizer["Items"]</label>
                                                    <input type="text" class="form-control form-control-sm bg-light" value="@(item.Item?.LocalizedName ?? "") (@(item.Item?.Code ?? ""))" readonly />
                                                </div>
                                                <div class="mb-2">
                                                    <label class="form-label small fw-bold">@Localizer["Unit"] <span class="text-danger">*</span></label>
                                                    <select name="UnitId" class="form-select form-select-sm" required>
                                                        @foreach (var u in units)
                                                        {
                                                            <option value="@u.Id" selected="@(item.UnitId == u.Id)">@u.LocalizedName (@u.Code)</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="mb-2">
                                                    <label class="form-label small fw-bold">@Localizer["ConversionFactor"] <span class="text-danger">*</span></label>
                                                    <input type="number" step="0.0001" min="0.0001" name="ConversionFactor" value="@item.ConversionFactor" class="form-control form-control-sm" required />
                                                </div>
                                                <div class="row g-2 mb-2">
                                                    <div class="col-6">
                                                        <label class="form-label small fw-bold">@Localizer["SalesPrice"]</label>
                                                        <input type="number" step="0.0001" min="0" name="SalesPrice" value="@item.SalesPrice" class="form-control form-control-sm" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label small fw-bold">@Localizer["PurchasePrice"]</label>
                                                        <input type="number" step="0.0001" min="0" name="PurchasePrice" value="@item.PurchasePrice" class="form-control form-control-sm" />
                                                    </div>
                                                </div>
                                                <div class="row g-2 mt-2">
                                                    <div class="col-6">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" name="IsDefaultSales" value="true" @(item.IsDefaultSales ? "checked" : "") id="editDefSales_@item.Id" />
                                                            <label class="form-check-label small" for="editDefSales_@item.Id">@Localizer["DefaultSales"]</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" name="IsDefaultPurchase" value="true" @(item.IsDefaultPurchase ? "checked" : "") id="editDefPur_@item.Id" />
                                                            <label class="form-check-label small" for="editDefPur_@item.Id">@Localizer["DefaultPurchase"]</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-12 mt-2">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" name="IsActive" value="true" @(item.IsActive ? "checked" : "") id="editItemUnitActive_@item.Id" />
                                                            <label class="form-check-label small" for="editItemUnitActive_@item.Id">@Localizer["Active"]</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer py-2 bg-light">
                                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                                                <button type="submit" class="btn btn-sm btn-erp-primary">@Localizer["Save"]</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center py-4 text-muted">@Localizer["NoDataFound"]</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-itemId="@ViewBag.ItemId" asp-route-searchString="@ViewBag.SearchString">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<!-- Create Modal -->
<div class="modal fade" id="createItemUnitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light py-2">
                    <h6 class="modal-title fw-bold"><i class="fa-solid fa-plus text-primary me-2"></i> @Localizer["AddNewUnit"]</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="mb-2">
                        <label class="form-label small fw-bold">@Localizer["Items"] <span class="text-danger">*</span></label>
                        <select name="ItemId" class="form-select form-select-sm" required>
                            <option value="">-- @Localizer["Select"] --</option>
                            @foreach (var i in items)
                            {
                                <option value="@i.Id" selected="@(ViewBag.ItemId != null && (int)ViewBag.ItemId == i.Id)">@i.LocalizedName (@i.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">@Localizer["Unit"] <span class="text-danger">*</span></label>
                        <select name="UnitId" class="form-select form-select-sm" required>
                            <option value="">-- @Localizer["Select"] --</option>
                            @foreach (var u in units)
                            {
                                <option value="@u.Id">@u.LocalizedName (@u.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">@Localizer["ConversionFactor"] <span class="text-danger">*</span></label>
                        <input type="number" step="0.0001" min="0.0001" name="ConversionFactor" value="1.0" class="form-control form-control-sm" required />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-bold">@Localizer["SalesPrice"]</label>
                            <input type="number" step="0.0001" min="0" name="SalesPrice" value="0.00" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">@Localizer["PurchasePrice"]</label>
                            <input type="number" step="0.0001" min="0" name="PurchasePrice" value="0.00" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="row g-2 mt-2">
                        <div class="col-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsDefaultSales" value="true" id="createDefSales" />
                                <label class="form-check-label small" for="createDefSales">@Localizer["DefaultSales"]</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsDefaultPurchase" value="true" id="createDefPurchase" />
                                <label class="form-check-label small" for="createDefPurchase">@Localizer["DefaultPurchase"]</label>
                            </div>
                        </div>
                        <div class="col-12 mt-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="createItemUnitActive" />
                                <label class="form-check-label small" for="createItemUnitActive">@Localizer["Active"]</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-light">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-sm btn-erp-primary">@Localizer["Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
