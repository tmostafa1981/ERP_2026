@model ERP.Application.DTOs.Reports.PurchasePriceHistoryReportDto
@{
    ViewData["Title"] = "مقارنة أسعار شراء الصنف";
    Layout = "_Layout";
    bool isRequested = ViewBag.IsRequested == true;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom d-print-none">
        <div>
            <h4 class="fw-bold mb-1 text-primary">
                <i class="fa-solid fa-tags me-2"></i>مقارنة أسعار شراء الصنف بين الفترات والموردين
            </h4>
            <span class="text-muted small">تتبع أسعار الشراء المسجلة للصنف عبر الفترات الزمنية ومختلف الموردين</span>
        </div>
        <div class="d-flex gap-2">
            @if (isRequested)
            {
                if (CurrentUserContext.HasPermission("Reports.PurchaseReports.Print,Reports.GeneralReports.Print"))
                {
                    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm fw-bold">
                        <i class="fa-solid fa-print me-1"></i> طباعة
                    </button>
                }
                if (CurrentUserContext.HasPermission("Reports.PurchaseReports.Export,Reports.GeneralReports.Export"))
                {
                    <button onclick="exportTableToExcel('priceHistoryTable', 'PurchasePriceHistory')" class="btn btn-outline-success btn-sm fw-bold">
                        <i class="fa-solid fa-file-excel me-1"></i> تصدير Excel
                    </button>
                }
            }
            <a asp-action="Index" class="btn btn-outline-primary btn-sm fw-bold">
                <i class="fa-solid fa-arrow-right me-1"></i> فهرس تقارير المشتريات
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4 d-print-none">
        <div class="card-body p-3 bg-light rounded">
            <form method="get" asp-action="PriceHistory">
                <input type="hidden" name="submitted" value="true" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">الصنف</label>
                        <div class="erp-lookup-picker" 
                             data-type="item" 
                             data-input-name="ItemId" 
                             data-value="@Model.Filter.ItemId" 
                             data-text="@ViewBag.SelectedItemDisplay"
                             data-placeholder="-- كافة الأصناف (كود / اسم / باركود) --">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">المورد</label>
                        <div class="erp-lookup-picker" 
                             data-type="vendor" 
                             data-input-name="VendorId" 
                             data-value="@Model.Filter.VendorId" 
                             data-text="@ViewBag.SelectedVendorDisplay"
                             data-placeholder="-- كافة الموردين (بحث بالكود / الاسم) --">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">من تاريخ</label>
                        <input type="date" name="DateFrom" class="form-control form-control-sm" value="@(Model.Filter.DateFrom?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold mb-1">إلى تاريخ</label>
                        <input type="date" name="DateTo" class="form-control form-control-sm" value="@(Model.Filter.DateTo?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                            <i class="fa-solid fa-filter me-1"></i> تتبع الأسعار
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!isRequested)
    {
        <div class="card border-0 shadow-sm p-5 text-center my-4 bg-white rounded-3">
            <div class="text-primary mb-3">
                <i class="fa-solid fa-tags fa-3x"></i>
            </div>
            <h5 class="fw-bold text-dark">يرجى تحديد الصنف أو المورد والضغط على "تتبع الأسعار"</h5>
            <p class="text-muted small mb-0">اختر الصنف والمورد لعرض تاريخ تغيرات أسعار الشراء وأدنى وأعلى سعر مسجل.</p>
        </div>
    }
    else
    {
        @if (Model.Items.Any())
        {
            <!-- Summary KPI Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm bg-success bg-opacity-10 text-success p-3 text-center">
                        <span class="small fw-bold">أقل سعر شراء تم تسجيله</span>
                        <h4 class="fw-bold mb-0 mt-1 font-monospace">@Model.MinPrice.ToString("N2")</h4>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm bg-info bg-opacity-10 text-info p-3 text-center">
                        <span class="small fw-bold">متوسط سعر الشراء</span>
                        <h4 class="fw-bold mb-0 mt-1 font-monospace">@Model.AvgPrice.ToString("N2")</h4>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm bg-danger bg-opacity-10 text-danger p-3 text-center">
                        <span class="small fw-bold">أعلى سعر شراء تم تسجيله</span>
                        <h4 class="fw-bold mb-0 mt-1 font-monospace">@Model.MaxPrice.ToString("N2")</h4>
                    </div>
                </div>
            </div>
        }

        <!-- Data Table -->
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="priceHistoryTable" class="table table-bordered table-hover table-striped align-middle mb-0 text-center" style="font-size: 0.85rem;">
                        <thead class="table-dark">
                            <tr>
                                <th>تاريخ الفاتورة</th>
                                <th>رقم الفاتورة</th>
                                <th class="text-start">المورد</th>
                                <th>كود الصنف</th>
                                <th class="text-start">اسم الصنف</th>
                                <th>الوحدة</th>
                                <th>الكمية</th>
                                <th>سعر الوحدة</th>
                                <th>صافي السعر للوحدة</th>
                                <th>العملة</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Items.Any())
                            {
                                <tr>
                                    <td colspan="10" class="py-4 text-muted">لا توجد حركات شراء مطابقة للبحث.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in Model.Items)
                                {
                                    <tr>
                                        <td class="font-monospace">@row.DocumentDate.ToString("yyyy/MM/dd")</td>
                                        <td class="font-monospace fw-bold text-primary">@row.DocumentNumber</td>
                                        <td class="text-start fw-bold">@row.VendorName</td>
                                        <td class="font-monospace text-muted">@row.ItemCode</td>
                                        <td class="text-start fw-bold">@row.ItemName</td>
                                        <td>@row.UnitName</td>
                                        <td class="font-monospace">@row.Quantity.ToString("G29")</td>
                                        <td class="font-monospace text-end">@row.UnitPrice.ToString("N2")</td>
                                        <td class="font-monospace text-end fw-bold text-success">@row.NetPrice.ToString("N2")</td>
                                        <td><span class="badge bg-light text-dark border">@row.CurrencyCode</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<script>
    function exportTableToExcel(tableId, filename) {
        var table = document.getElementById(tableId);
        if (!table) return;
        var html = table.outerHTML;
        var blob = new Blob(['\ufeff' + html], { type: 'application/vnd.ms-excel;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename + '_' + new Date().toISOString().slice(0, 10) + '.xls';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }
</script>
