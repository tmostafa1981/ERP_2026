@model ERP.Application.DTOs.Reports.PurchaseReturnsAndNetReportDto
@{
    ViewData["Title"] = "مرتجعات المشتريات وصافي المشتريات";
    Layout = "_Layout";
    bool isRequested = ViewBag.IsRequested == true;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom d-print-none">
        <div>
            <h4 class="fw-bold mb-1 text-primary">
                <i class="fa-solid fa-rotate-left me-2"></i>مرتجعات المشتريات وصافي المشتريات
            </h4>
            <span class="text-muted small">تحليل معدل الارتجاع لمشتريات الموردين دون احتساب مزدوج</span>
        </div>
        <div class="d-flex gap-2">
            @if (isRequested)
            {
                if (CurrentUserContext.HasPermission("Reports.PurchaseReports.Print,Reports.GeneralReports.Print"))
                {
                    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm fw-bold">
                        <i class="fa-solid fa-print me-1"></i> طباعة
                    </button>
                }
                if (CurrentUserContext.HasPermission("Reports.PurchaseReports.Export,Reports.GeneralReports.Export"))
                {
                    <button onclick="exportTableToExcel('purchaseReturnsTable', 'PurchaseReturnsAndNet')" class="btn btn-outline-success btn-sm fw-bold">
                        <i class="fa-solid fa-file-excel me-1"></i> تصدير Excel
                    </button>
                }
            }
            <a asp-action="Index" class="btn btn-outline-primary btn-sm fw-bold">
                <i class="fa-solid fa-arrow-right me-1"></i> فهرس تقارير المشتريات
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4 d-print-none">
        <div class="card-body p-3 bg-light rounded">
            <form method="get" asp-action="ReturnsAndNet">
                <input type="hidden" name="submitted" value="true" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">الفرع</label>
                        <select name="BranchId" class="form-select form-select-sm" asp-items="ViewBag.Branches">
                            <option value="">-- كل الفروع --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">من تاريخ</label>
                        <input type="date" name="DateFrom" class="form-control form-control-sm" value="@(Model.Filter.DateFrom?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">إلى تاريخ</label>
                        <input type="date" name="DateTo" class="form-control form-control-sm" value="@(Model.Filter.DateTo?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                            <i class="fa-solid fa-filter me-1"></i> عرض التقرير
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!isRequested)
    {
        <div class="card border-0 shadow-sm p-5 text-center my-4 bg-white rounded-3">
            <div class="text-primary mb-3">
                <i class="fa-solid fa-rotate-left fa-3x"></i>
            </div>
            <h5 class="fw-bold text-dark">يرجى تحديد معايير البحث والضغط على "عرض التقرير"</h5>
            <p class="text-muted small mb-0">اختر الفرع والفترة الزمنية لعرض مرتجعات المشتريات وصافي تكلفة الشراء.</p>
        </div>
    }
    else
    {
        <!-- Summary KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-primary bg-opacity-10 text-primary p-3">
                    <span class="small fw-bold">إجمالي المشتريات</span>
                    <h4 class="fw-bold mb-0 mt-1 font-monospace">@Model.TotalPurchases.ToString("N2")</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-danger bg-opacity-10 text-danger p-3">
                    <span class="small fw-bold">إجمالي المرتجعات</span>
                    <h4 class="fw-bold mb-0 mt-1 font-monospace">@Model.TotalReturns.ToString("N2")</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-success bg-opacity-10 text-success p-3">
                    <span class="small fw-bold">صافي تكلفة المشتريات</span>
                    <h4 class="fw-bold mb-0 mt-1 font-monospace">@Model.NetPurchases.ToString("N2")</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-warning bg-opacity-10 text-warning p-3">
                    <span class="small fw-bold text-dark">نسبة الارتجاع</span>
                    <h4 class="fw-bold mb-0 mt-1 font-monospace text-dark">@Model.ReturnPercentage.ToString("F1")%</h4>
                </div>
            </div>
        </div>

        <!-- Data Table -->
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="purchaseReturnsTable" class="table table-bordered table-hover table-striped align-middle mb-0 text-center" style="font-size: 0.85rem;">
                        <thead class="table-dark">
                            <tr>
                                <th>التاريخ</th>
                                <th>رقم المستند</th>
                                <th>نوع المستند</th>
                                <th class="text-start">المورد</th>
                                <th>قيمة المشتريات</th>
                                <th>قيمة المرتجع</th>
                                <th class="text-start">ملاحظات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Items.Any())
                            {
                                <tr>
                                    <td colspan="7" class="py-4 text-muted">لا توجد حركات شراء أو ارتجاع مسجلة.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in Model.Items)
                                {
                                    <tr>
                                        <td class="font-monospace">@row.Date.ToString("yyyy/MM/dd")</td>
                                        <td class="font-monospace fw-bold text-primary">@row.DocumentNumber</td>
                                        <td><span class="badge @(row.ReturnAmount > 0 ? "bg-danger-subtle text-danger" : "bg-primary-subtle text-primary") border">@row.DocumentType</span></td>
                                        <td class="text-start fw-bold">@row.VendorName</td>
                                        <td class="font-monospace text-end">@(row.PurchaseAmount > 0 ? row.PurchaseAmount.ToString("N2") : "-")</td>
                                        <td class="font-monospace text-end text-danger fw-bold">@(row.ReturnAmount > 0 ? row.ReturnAmount.ToString("N2") : "-")</td>
                                        <td class="text-start small text-muted">@row.Notes</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<script>
    function exportTableToExcel(tableId, filename) {
        var table = document.getElementById(tableId);
        if (!table) return;
        var html = table.outerHTML;
        var blob = new Blob(['\ufeff' + html], { type: 'application/vnd.ms-excel;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename + '_' + new Date().toISOString().slice(0, 10) + '.xls';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }
</script>
